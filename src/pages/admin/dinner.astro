---
import Layout from "../../layouts/Layout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const loginUrl = `${base}/admin/login/index.html`;
const homeUrl = `${base}/`;
const hotelAdminUrl = `${base}/admin/index.html`;
---

<Layout title="Quản lý bàn Dinner - 96Q">
  <div id="auth-loading" class="fixed inset-0 z-[200] flex items-center justify-center bg-navy-900 text-white"><div class="text-center"><i data-lucide="loader-2" class="mx-auto h-9 w-9 animate-spin text-gold-400"></i><p class="mt-3 text-sm">Đang kiểm tra quyền quản trị...</p></div></div>
  <div id="admin-app" class="hidden min-h-screen bg-gray-100">
    <header class="sticky top-0 z-40 border-b border-white/10 bg-navy-900 text-white shadow-lg">
      <div class="mx-auto flex max-w-[1450px] items-center justify-between gap-3 px-4 py-3 sm:px-6">
        <div class="flex items-center gap-3"><img src={`${base}/logo30.png`} alt="96Q" class="h-11 w-auto" /><div><h1 class="font-serif font-bold">Quản lý bàn Dinner</h1><p class="text-[10px] uppercase tracking-wider text-gold-400">30 năm hội ngộ 96Q</p></div></div>
        <div class="flex items-center gap-2"><a href={hotelAdminUrl} class="flex items-center gap-2 rounded-lg bg-gold-500 px-3 py-2 text-xs font-bold text-navy-900"><i data-lucide="hotel" class="h-4 w-4"></i><span class="hidden sm:inline">Xếp phòng</span></a><span id="admin-email-label" class="hidden text-xs text-gray-300 lg:block"></span><button id="logout-button" class="flex items-center gap-2 rounded-lg bg-white/10 px-3 py-2 text-xs font-semibold hover:bg-red-500"><i data-lucide="log-out" class="h-4 w-4"></i><span class="hidden sm:inline">Đăng xuất</span></button></div>
      </div>
    </header>

    <main class="mx-auto max-w-[1450px] p-4 sm:p-6">
      <div class="mb-5 grid grid-cols-2 gap-3 md:grid-cols-4"><div class="rounded-xl bg-white p-4 shadow-sm"><span class="text-xs text-gray-500">Tổng thành viên</span><strong id="stat-total" class="mt-1 block text-2xl text-navy-900">0</strong></div><div class="rounded-xl bg-white p-4 shadow-sm"><span class="text-xs text-gray-500">Chưa có bàn</span><strong id="stat-unassigned" class="mt-1 block text-2xl text-orange-500">0</strong></div><div class="rounded-xl bg-white p-4 shadow-sm"><span class="text-xs text-gray-500">Đã có bàn</span><strong id="stat-assigned" class="mt-1 block text-2xl text-green-600">0</strong></div><div class="rounded-xl bg-white p-4 shadow-sm"><span class="text-xs text-gray-500">Chỗ còn lại</span><strong id="stat-available" class="mt-1 block text-2xl text-gold-600">60</strong></div></div>
      <div class="grid gap-5 lg:grid-cols-[380px_1fr] lg:items-start">
        <section class="rounded-2xl bg-white p-5 shadow-sm lg:sticky lg:top-24">
          <h2 class="font-serif text-xl font-bold text-navy-900">Vòng quay bàn ăn</h2><p class="mt-1 text-xs text-gray-500">Chọn thành viên chưa có bàn rồi nhấn quay</p>
          <label for="dinner-person-select" class="mb-1.5 mt-5 block text-sm font-semibold text-gray-700">Thành viên</label><select id="dinner-person-select" class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm"><option value="">-- Chọn thành viên --</option></select>
          <div class="relative mx-auto mt-6 aspect-square w-full max-w-[310px]"><div class="absolute left-1/2 top-0 z-10 h-10 w-10 -translate-x-1/2 bg-navy-900 [clip-path:polygon(0_0,100%_0,50%_100%)]"></div><div id="dinner-wheel" class="absolute inset-3 rounded-full border-[8px] border-white bg-[conic-gradient(from_-30deg,#d4af37_0deg_60deg,#ef8354_60deg_120deg,#6aa7a1_120deg_180deg,#5b7cba_180deg_240deg,#9b72cf_240deg_300deg,#d96f91_300deg_360deg)] shadow-xl"></div><button id="spin-button" type="button" disabled class="absolute left-1/2 top-1/2 z-20 flex h-24 w-24 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-[6px] border-white/80 bg-white text-sm font-extrabold tracking-wider text-navy-900 shadow-lg disabled:cursor-not-allowed disabled:text-gray-300">QUAY</button></div>
          <div id="dinner-result" class="mt-4 hidden rounded-xl border-2 border-gold-400 bg-gold-50 p-4 text-center"></div>
        </section>
        <section><div class="mb-4 flex items-end justify-between"><div><h2 class="font-serif text-2xl font-bold text-navy-900">Danh sách bàn Dinner</h2><p class="text-xs text-gray-500">6 bàn · tối đa 10 người mỗi bàn</p></div><span id="unassigned-label" class="rounded-full bg-orange-100 px-3 py-1 text-xs font-bold text-orange-600"></span></div><div id="tables-container" class="grid gap-4 md:grid-cols-2 xl:grid-cols-3"></div></section>
      </div>
    </main>
  </div>
  <div id="toast" class="fixed bottom-5 right-5 z-[150] hidden max-w-sm rounded-xl px-4 py-3 text-sm font-medium text-white shadow-xl"></div>
</Layout>

<script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script><script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script><script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>
<script define:vars={{ loginUrl, homeUrl }}>
  const firebaseConfig={apiKey:"AIzaSyAfKEUC4xTaT-6Wo7fMdUUbmf2xAP2CaNM",authDomain:"register-to-participate.firebaseapp.com",projectId:"register-to-participate",storageBucket:"register-to-participate.firebasestorage.app",messagingSenderId:"578991866095",appId:"1:578991866095:web:9ce9b6b5e5d13314359b1a"};if(!firebase.apps.length)firebase.initializeApp(firebaseConfig);const auth=firebase.auth(),db=firebase.firestore();
  const configs=[{id:"table-1",name:"Bàn Nặn tượng",label:"Nặn tượng",capacity:10},{id:"table-2",name:"Bàn Vật lý kiến trúc",label:"Vật lý KT",capacity:10},{id:"table-3",name:"Bàn Hình học họa hình",label:"Hình họa",capacity:10},{id:"table-4",name:"Bàn Mực nho - Đi màu",label:"Mực nho",capacity:10},{id:"table-5",name:"Bàn ĐA Quán Hoa",label:"ĐA Quán Hoa",capacity:10},{id:"table-6",name:"Bàn Sức bền Vật Liệu",label:"Sức bền VL",capacity:10}];let persons=[],tables={},admin=null,rotation=0,spinning=false,inactivityTimer;const esc=(v="")=>String(v).replace(/[&<>'"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;",'"':"&quot;"}[c]));
  function renderWheelLabels(){const wheel=document.getElementById("dinner-wheel");wheel.innerHTML=configs.map((table,index)=>{const angle=index*60,radians=angle*Math.PI/180,x=50+Math.sin(radians)*35,y=50-Math.cos(radians)*35;return `<span style="position:absolute;z-index:2;left:${x}%;top:${y}%;width:31%;transform:translate(-50%,-50%) rotate(${angle}deg);color:white;font-size:11px;font-weight:800;line-height:1.1;text-align:center;text-shadow:0 1px 3px rgba(0,0,0,.55);pointer-events:none">${esc(table.label)}</span>`}).join("")}
  function toast(text,error=false){const e=document.getElementById("toast");e.textContent=text;e.className=`fixed bottom-5 right-5 z-[150] max-w-sm rounded-xl px-4 py-3 text-sm font-medium text-white shadow-xl ${error?"bg-red-600":"bg-green-600"}`;clearTimeout(e.timer);e.timer=setTimeout(()=>e.classList.add("hidden"),3500)}function resetInactivity(){clearTimeout(inactivityTimer);inactivityTimer=setTimeout(async()=>{await auth.signOut();location.replace(loginUrl)},30*60*1000)}["click","keydown","touchstart"].forEach(n=>document.addEventListener(n,resetInactivity,{passive:true}));
  auth.onAuthStateChanged(async user=>{if(!user){location.replace(loginUrl);return}try{const d=await db.collection("admins").doc(user.uid).get();if(!d.exists||d.data().active!==true)throw Error()}catch{await auth.signOut();location.replace(homeUrl);return}admin=user;document.getElementById("admin-email-label").textContent=user.email;document.getElementById("auth-loading").classList.add("hidden");document.getElementById("admin-app").classList.remove("hidden");resetInactivity();render();subscribe();try{await initializeTables()}catch(error){toast("Chưa thể tạo danh sách bàn. Hãy cập nhật firestore.rules trên Firebase Console.",true);console.error("Dinner tables initialization error:",error)}});
  async function initializeTables(){const batch=db.batch();let writes=0;for(const c of configs){const ref=db.collection("dinner_tables").doc(c.id),snap=await ref.get();if(!snap.exists){batch.set(ref,{name:c.name,capacity:c.capacity,occupied:0,females:0,locked:false,createdAt:firebase.firestore.FieldValue.serverTimestamp()});writes++}}if(writes)await batch.commit()}
  function subscribe(){db.collection("persons").orderBy("fullName").onSnapshot(s=>{persons=s.docs.map(d=>({id:d.id,...d.data()}));render()},e=>toast(e.message,true));db.collection("dinner_tables").onSnapshot(s=>{tables={};s.forEach(d=>tables[d.id]={id:d.id,...d.data()});render()},e=>toast(e.message,true))}
  function render(){const select=document.getElementById("dinner-person-select"),old=select.value,unassigned=persons.filter(p=>!p.dinnerTableId),assigned=persons.length-unassigned.length;select.innerHTML='<option value="">-- Chọn thành viên chưa có bàn --</option>'+unassigned.map(p=>`<option value="${p.id}">${esc(p.fullName)} (${esc(p.className)})${p.isFemale?" · Nữ":""}</option>`).join("");if(unassigned.some(p=>p.id===old))select.value=old;document.getElementById("spin-button").disabled=!select.value||spinning;document.getElementById("stat-total").textContent=persons.length;document.getElementById("stat-unassigned").textContent=unassigned.length;document.getElementById("stat-assigned").textContent=assigned;document.getElementById("stat-available").textContent=Math.max(0,60-assigned);document.getElementById("unassigned-label").textContent=`${unassigned.length} người chưa có bàn`;document.getElementById("tables-container").innerHTML=configs.map(c=>{const occupants=persons.filter(p=>p.dinnerTableId===c.id),full=occupants.length>=c.capacity;return `<article class="rounded-2xl border border-gray-100 bg-white p-4 shadow-sm"><div class="flex justify-between gap-2"><div><h3 class="font-serif text-lg font-bold text-navy-900">${esc(c.name)}</h3><p class="text-[11px] text-gray-400">${occupants.length}/${c.capacity} người · ${occupants.filter(p=>p.isFemale).length} nữ</p></div><span class="h-fit rounded-full px-2 py-1 text-[10px] font-bold ${full?"bg-red-100 text-red-600":"bg-green-100 text-green-700"}">${full?"Đã đủ":`Còn ${c.capacity-occupants.length} chỗ`}</span></div><div class="my-3 h-2 rounded-full bg-gray-100"><div class="h-full rounded-full ${full?"bg-red-400":"bg-gold-500"}" style="width:${occupants.length/c.capacity*100}%"></div></div><div class="min-h-20 space-y-1">${occupants.length?occupants.map(p=>`<div class="flex items-center justify-between rounded-md bg-gray-50 px-2 py-1.5 text-xs"><span class="truncate"><b>${esc(p.fullName)}</b> · ${esc(p.className)}${p.isFemale?" · Nữ":""}</span><button data-remove="${p.id}" class="ml-2 text-gray-400 hover:text-red-500"><i data-lucide="x" class="h-3.5 w-3.5"></i></button></div>`).join(""):'<p class="py-6 text-center text-xs italic text-gray-300">Chưa có thành viên</p>'}</div></article>`}).join("");document.querySelectorAll("[data-remove]").forEach(b=>b.onclick=()=>removeFromTable(b.dataset.remove));if(window.lucide)window.lucide.createIcons()}
  async function spin(){if(spinning)return;const id=document.getElementById("dinner-person-select").value,p=persons.find(x=>x.id===id);if(!p)return;const available=configs.filter(c=>{const t=tables[c.id]||{};return !t.locked&&Number(t.occupied||0)<c.capacity&&(!p.isFemale||Number(t.females||0)<2)});if(!available.length){toast("Không còn bàn phù hợp.",true);return}const chosen=available[Math.floor(Math.random()*available.length)],index=configs.findIndex(c=>c.id===chosen.id);spinning=true;render();try{await db.runTransaction(async tx=>{const pr=db.collection("persons").doc(id),tr=db.collection("dinner_tables").doc(chosen.id),ps=await tx.get(pr),ts=await tx.get(tr);if(!ps.exists||!ts.exists)throw Error("Dữ liệu không tồn tại.");const person=ps.data(),table=ts.data();if(person.dinnerTableId)throw Error("Thành viên đã có bàn.");if(table.locked||table.occupied>=table.capacity)throw Error("Bàn vừa hết chỗ.");if(person.isFemale&&table.females>=2)throw Error("Bàn đã đủ thành viên nữ.");tx.update(tr,{occupied:Number(table.occupied||0)+1,females:Number(table.females||0)+(person.isFemale?1:0),updatedAt:firebase.firestore.FieldValue.serverTimestamp()});tx.update(pr,{dinnerTableId:chosen.id,dinnerTableName:chosen.name,dinnerAssignedAt:firebase.firestore.FieldValue.serverTimestamp(),updatedBy:admin.uid})});const wheel=document.getElementById("dinner-wheel"),normal=((rotation%360)+360)%360,target=(360-index*60)%360;rotation+=1800+(target-normal+360)%360;wheel.style.transition="transform 4.6s cubic-bezier(.12,.72,.08,1)";wheel.style.transform=`rotate(${rotation}deg)`;setTimeout(()=>{const r=document.getElementById("dinner-result");r.innerHTML=`<p class="text-xs font-bold uppercase tracking-wider text-gold-600">Kết quả</p><p class="mt-1 font-semibold text-navy-900">${esc(p.fullName)}</p><p class="font-serif text-xl font-bold text-gold-600">${esc(chosen.name)}</p>`;r.classList.remove("hidden");spinning=false;render()},4700)}catch(e){spinning=false;render();toast(e.message,true)}}
  async function removeFromTable(id){const p=persons.find(x=>x.id===id);if(!p?.dinnerTableId||!confirm(`Gỡ ${p.fullName} khỏi ${p.dinnerTableName}?`))return;try{await db.runTransaction(async tx=>{const pr=db.collection("persons").doc(id),tr=db.collection("dinner_tables").doc(p.dinnerTableId),ts=await tx.get(tr);if(ts.exists){const t=ts.data();tx.update(tr,{occupied:Math.max(0,Number(t.occupied||0)-1),females:Math.max(0,Number(t.females||0)-(p.isFemale?1:0)),updatedAt:firebase.firestore.FieldValue.serverTimestamp()})}tx.update(pr,{dinnerTableId:null,dinnerTableName:null,dinnerAssignedAt:null,updatedBy:admin.uid})});toast("Đã gỡ thành viên khỏi bàn.")}catch(e){toast(e.message,true)}}
  renderWheelLabels();document.getElementById("dinner-person-select").onchange=()=>{document.getElementById("spin-button").disabled=!document.getElementById("dinner-person-select").value||spinning;document.getElementById("dinner-result").classList.add("hidden")};document.getElementById("spin-button").onclick=spin;document.getElementById("logout-button").onclick=async()=>{await auth.signOut();location.replace(loginUrl)};
</script>
