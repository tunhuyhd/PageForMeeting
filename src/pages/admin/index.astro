      await batch.commit();
    }
  }
  async function syncPublicResults() {
    const [personSnapshot, roomSnapshot] = await Promise.all([
        db.collection("persons").get(),
        db.collection("rooms").get(),
      ]),
      currentPersons = personSnapshot.docs.map((doc) => ({
        id: doc.id,
        ...doc.data(),
      })),
      currentRooms = {};
