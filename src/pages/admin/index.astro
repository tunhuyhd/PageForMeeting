---
import Layout from "../../layouts/Layout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const loginUrl = `${base}/admin/login/index.html`;
const homeUrl = `${base}/`;
const dinnerUrl = `${base}/admin/dinner/index.html`;
---

<Layout title="Quản trị thành viên & khách sạn - 96Q">
  <div id="auth-loading" class="fixed inset-0 z-[200] flex items-center justify-center bg-navy-900 text-white"><div class="text-center"><i data-lucide="loader-2" class="mx-auto h-9 w-9 animate-spin text-gold-400"></i><p class="mt-3 text-sm">Đang kiểm tra quyền quản trị...</p></div></div>
  <div id="admin-app" class="hidden min-h-screen bg-gray-100">
    <header class="sticky top-0 z-40 border-b border-white/10 bg-navy-900 text-white shadow-lg">
      <div class="mx-auto flex max-w-[1500px] items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <div class="flex items-center gap-3"><img src={`${base}/logo30.png`} alt="96Q" class="h-11 w-auto" /><div><h1 class="font-serif font-bold">Quản trị lưu trú</h1><p class="text-[10px] uppercase tracking-wider text-gold-400">30 năm hội ngộ 96Q</p></div></div>
        <div class="flex items-center gap-2"><span id="admin-email-label" class="hidden text-xs text-gray-300 lg:block"></span><button id="change-password-button" class="rounded-lg border border-white/15 p-2 text-gray-300 hover:text-gold-400" title="Đổi mật khẩu"><i data-lucide="key-round" class="h-4 w-4"></i></button><button id="logout-button" class="flex items-center gap-2 rounded-lg bg-white/10 px-3 py-2 text-xs font-semibold hover:bg-red-500"><i data-lucide="log-out" class="h-4 w-4"></i><span class="hidden sm:inline">Đăng xuất</span></button></div>
      </div>
    </header>

    <main class="mx-auto max-w-[1500px] p-4 sm:p-6">
      <nav aria-label="Chuyển trang quản trị" class="mb-5 grid grid-cols-2 rounded-xl bg-white p-1 shadow-sm sm:ml-auto sm:w-fit">
        <span aria-current="page" class="flex items-center justify-center gap-2 rounded-lg bg-navy-900 px-4 py-2.5 text-xs font-bold text-white"><i data-lucide="hotel" class="h-4 w-4"></i>Xếp phòng</span>
        <a href={dinnerUrl} class="flex items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-xs font-bold text-gray-600 transition hover:bg-gold-100 hover:text-navy-900"><i data-lucide="circle-dot" class="h-4 w-4"></i>Bàn Dinner</a>
      </nav>
      <div class="mb-5 grid grid-cols-2 gap-3 md:grid-cols-4">
        <div class="rounded-xl bg-white p-4 shadow-sm"><span class="text-xs text-gray-500">Tổng thành viên</span><strong id="stat-total" class="mt-1 block text-2xl text-navy-900">0</strong></div>
        <div class="rounded-xl bg-white p-4 shadow-sm"><span class="text-xs text-gray-500">Chưa xếp phòng</span><strong id="stat-unassigned" class="mt-1 block text-2xl text-orange-500">0</strong></div>
        <div class="rounded-xl bg-white p-4 shadow-sm"><span class="text-xs text-gray-500">Đã xếp phòng</span><strong id="stat-assigned" class="mt-1 block text-2xl text-green-600">0</strong></div>
        <div class="rounded-xl bg-white p-4 shadow-sm"><span class="text-xs text-gray-500">Chỗ còn lại</span><strong id="stat-available" class="mt-1 block text-2xl text-gold-600">0</strong></div>
      </div>

      <div class="grid gap-5 xl:grid-cols-[420px_1fr] xl:items-start">
        <section class="rounded-2xl bg-white shadow-sm xl:sticky xl:top-24">
          <div class="border-b border-gray-100 p-4">
            <div class="flex items-start justify-between gap-2"><div><h2 class="font-bold text-navy-900">Danh sách các thành viên</h2><p class="text-xs text-gray-500">Chọn một người để xếp phòng</p></div><div class="flex shrink-0 gap-2"><button id="import-persons-button" type="button" class="flex items-center gap-1 rounded-lg border border-navy-900 px-2.5 py-2 text-xs font-bold text-navy-900 hover:bg-gray-50" title="Import danh sách person từ JSON"><i data-lucide="file-up" class="h-4 w-4"></i><span class="hidden sm:inline">Import JSON</span></button><button id="add-person-button" type="button" class="flex items-center gap-1 rounded-lg bg-navy-900 px-3 py-2 text-xs font-bold text-white hover:bg-gold-500"><i data-lucide="user-plus" class="h-4 w-4"></i> Thêm</button></div></div>
            <input id="import-persons-input" type="file" accept="application/json,.json" multiple class="hidden" />
            <div class="mt-3 flex gap-2"><div class="relative flex-1"><i data-lucide="search" class="absolute left-3 top-2.5 h-4 w-4 text-gray-400"></i><input id="person-search" type="search" placeholder="Tìm theo tên, lớp..." class="w-full rounded-lg border border-gray-200 py-2 pl-9 pr-3 text-sm outline-none focus:border-gold-500" /></div><select id="person-filter" class="rounded-lg border border-gray-200 bg-white px-2 text-xs"><option value="all">Tất cả</option><option value="unassigned">Chưa xếp</option><option value="assigned">Đã xếp</option><option value="96Q1">96Q1</option><option value="96Q2">96Q2</option></select></div>
          </div>
          <div id="selected-person-banner" class="hidden border-b border-gold-200 bg-gold-50 p-3 text-sm"></div>
          <div id="persons-list" class="max-h-[calc(100vh-300px)] min-h-52 overflow-y-auto p-3"></div>
        </section>

        <section>
          <div class="mb-4 flex flex-wrap items-end justify-between gap-3"><div><h2 class="font-serif text-2xl font-bold text-navy-900">Sơ đồ phòng khách sạn</h2><p class="text-xs text-gray-500">Phòng có người chỉ nhận thêm thành viên cùng lớp</p></div><div class="flex rounded-lg bg-white p-1 shadow-sm"><button data-hotel-tab="all" class="hotel-tab rounded-md bg-navy-900 px-3 py-2 text-xs font-bold text-white">Tất cả</button><button data-hotel-tab="milla" class="hotel-tab rounded-md px-3 py-2 text-xs font-semibold text-gray-600">Milla</button><button data-hotel-tab="dragon-nest" class="hotel-tab rounded-md px-3 py-2 text-xs font-semibold text-gray-600">Dragon Nest</button></div></div>
          <div id="rooms-container" class="space-y-6"></div>
        </section>
      </div>
    </main>
  </div>

  <div id="person-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-navy-900/70 p-4 backdrop-blur-sm">
    <form id="person-form" class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl">
      <div class="mb-5 flex items-center justify-between"><h2 id="person-modal-title" class="font-serif text-xl font-bold text-navy-900">Thêm thành viên</h2><button type="button" data-close-modal class="text-gray-400 hover:text-navy-900"><i data-lucide="x" class="h-5 w-5"></i></button></div>
      <input id="person-id" type="hidden" /><div class="space-y-4"><div><label class="mb-1 block text-sm font-medium">Họ và tên *</label><input id="person-name" required class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm outline-none focus:border-gold-500" /></div><div><label class="mb-1 block text-sm font-medium">Lớp *</label><select id="person-class" required class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm"><option value="96Q1">96Q1</option><option value="96Q2">96Q2</option></select></div><label class="flex cursor-pointer items-center gap-3 rounded-lg bg-gray-50 p-3 text-sm"><input id="person-is-female" type="checkbox" class="h-4 w-4" /> Thành viên nữ</label><div><label class="mb-1 block text-sm font-medium">Số điện thoại</label><input id="person-phone" type="tel" class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm" /></div><div><label class="mb-1 block text-sm font-medium">Ghi chú</label><textarea id="person-note" rows="2" class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm"></textarea></div></div>
      <div class="mt-6 grid grid-cols-2 gap-3"><button type="button" data-close-modal class="rounded-lg border border-gray-300 py-2.5 text-sm font-semibold text-gray-600">Hủy</button><button id="save-person-button" type="submit" class="rounded-lg bg-navy-900 py-2.5 text-sm font-bold text-white hover:bg-gold-500">Lưu thành viên</button></div>
    </form>
  </div>

  <div id="password-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-navy-900/70 p-4"><form id="password-form" class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-2xl"><h2 class="font-serif text-xl font-bold text-navy-900">Đổi mật khẩu</h2><p class="mt-1 text-xs text-gray-500">Bạn sẽ cần đăng nhập lại sau khi đổi.</p><div id="password-message" class="mt-3 hidden rounded-lg p-3 text-xs"></div><div class="mt-4 space-y-3"><input id="current-password" type="password" required placeholder="Mật khẩu hiện tại" class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm" /><input id="new-password" type="password" required minlength="10" placeholder="Mật khẩu mới (ít nhất 10 ký tự)" class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm" /><input id="confirm-password" type="password" required minlength="10" placeholder="Nhập lại mật khẩu mới" class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm" /></div><div class="mt-5 grid grid-cols-2 gap-3"><button id="close-password" type="button" class="rounded-lg border border-gray-300 py-2.5 text-sm">Hủy</button><button type="submit" class="rounded-lg bg-navy-900 py-2.5 text-sm font-bold text-white">Đổi mật khẩu</button></div></form></div>

  <div id="toast" class="fixed bottom-5 right-5 z-[150] hidden max-w-sm rounded-xl px-4 py-3 text-sm font-medium text-white shadow-xl"></div>
</Layout>

<script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>
<script define:vars={{ loginUrl, homeUrl }}>
  const firebaseConfig = { apiKey: "AIzaSyAfKEUC4xTaT-6Wo7fMdUUbmf2xAP2CaNM", authDomain: "register-to-participate.firebaseapp.com", projectId: "register-to-participate", storageBucket: "register-to-participate.firebasestorage.app", messagingSenderId: "578991866095", appId: "1:578991866095:web:9ce9b6b5e5d13314359b1a" };
  if (!firebase.apps.length) firebase.initializeApp(firebaseConfig); const auth = firebase.auth(); const db = firebase.firestore();
  const hotelConfigs = [
    { id: "milla", name: "Milla", rooms: [{number:"206",bed:"1.6m + 1.2m",extra:"—",capacity:3},{number:"208",bed:"1.6m + 1.2m",extra:"—",capacity:3},{number:"306",bed:"1.6m + 1.2m",extra:"—",capacity:3},{number:"308",bed:"1.6m + 1.2m",extra:"—",capacity:3},{number:"406",bed:"1 × 1.8m",extra:"—",capacity:2},{number:"408",bed:"1 × 1.8m",extra:"—",capacity:2},{number:"506",bed:"1 × 1.8m",extra:"—",capacity:2},{number:"508",bed:"1.8m + 1.2m",extra:"—",capacity:3}] },
    { id: "dragon-nest", name: "Dragon Nest", rooms: [{number:"201",bed:"2 × 1.6m",extra:"—",capacity:4},{number:"202",bed:"2 × 1.6m",extra:"—",capacity:4},{number:"303",bed:"2 × 1.6m",extra:"—",capacity:4},{number:"304",bed:"2 × 1.6m",extra:"+1",capacity:5},{number:"405",bed:"1 × 2.6m",extra:"+1",capacity:4},{number:"406",bed:"1 × 2.6m",extra:"+1",capacity:4},{number:"507",bed:"1 × 1.8m",extra:"+1",capacity:3},{number:"508",bed:"1 × 1.8m",extra:"+1",capacity:3}] }
  ];
  let persons = [], rooms = {}, selectedPersonId = "", hotelFilter = "all", currentAdmin = null, inactivityTimer;
  const roomKey = (hotelId, number) => `${hotelId}-${number}`; const esc = (value="") => String(value).replace(/[&<>'"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;",'"':"&quot;"}[c]));
  function toast(text, error=false) { const el=document.getElementById("toast"); el.textContent=text; el.className=`fixed bottom-5 right-5 z-[150] max-w-sm rounded-xl px-4 py-3 text-sm font-medium text-white shadow-xl ${error?"bg-red-600":"bg-green-600"}`; clearTimeout(el.timer); el.timer=setTimeout(()=>el.classList.add("hidden"),3500); }
  function resetInactivity() { clearTimeout(inactivityTimer); inactivityTimer=setTimeout(async()=>{ await auth.signOut(); sessionStorage.setItem("adminSessionMessage","Phiên đăng nhập đã hết hạn do không hoạt động."); location.replace(loginUrl); },30*60*1000); }
  ["click","keydown","touchstart"].forEach(name=>document.addEventListener(name,resetInactivity,{passive:true}));
  auth.onAuthStateChanged(async user => { if(!user){ location.replace(loginUrl); return; } try { const adminDocument=await db.collection("admins").doc(user.uid).get(); if(!adminDocument.exists||adminDocument.data().active!==true)throw new Error("not-admin"); } catch { await auth.signOut(); location.replace(homeUrl); return; } currentAdmin=user; document.getElementById("admin-email-label").textContent=user.email; document.getElementById("auth-loading").classList.add("hidden"); document.getElementById("admin-app").classList.remove("hidden"); resetInactivity(); await initializeRooms(); await syncRoomMetadata(); await syncDinnerCandidates(); subscribeData(); });
  async function initializeRooms(){ const batch=db.batch(); let writes=0; for(const hotel of hotelConfigs) for(const room of hotel.rooms){ const key=roomKey(hotel.id,room.number), ref=db.collection("rooms").doc(key), snap=await ref.get(); if(!snap.exists){ batch.set(ref,{hotelId:hotel.id,hotelName:hotel.name,roomNumber:room.number,bed:room.bed,extraBed:room.extra,capacity:room.capacity,occupied:0,femaleCount:0,classCounts:{"96Q1":0,"96Q2":0},assignedClass:null,locked:false,createdAt:firebase.firestore.FieldValue.serverTimestamp()}); writes++; }} if(writes) await batch.commit(); }
  function roomClassCounts(room){const counts=room.classCounts||{};return{"96Q1":Number(counts["96Q1"]||0),"96Q2":Number(counts["96Q2"]||0)};}
  function roomMode(counts,occupied,femaleCount){if(!occupied)return null;if(femaleCount===occupied)return"FEMALE";if(femaleCount===0&&counts["96Q1"]===occupied)return"96Q1";if(femaleCount===0&&counts["96Q2"]===occupied)return"96Q2";return"MIXED";}
  async function syncRoomMetadata(){const [personSnapshot,roomSnapshot]=await Promise.all([db.collection("persons").get(),db.collection("rooms").get()]),byRoom={};personSnapshot.docs.forEach(doc=>{const p=doc.data();if(!p.roomKey)return;const summary=byRoom[p.roomKey]||(byRoom[p.roomKey]={occupied:0,femaleCount:0,classCounts:{"96Q1":0,"96Q2":0}});summary.occupied++;if(p.isFemale)summary.femaleCount++;if(p.className in summary.classCounts)summary.classCounts[p.className]++;});const batch=db.batch();roomSnapshot.docs.forEach(doc=>{const summary=byRoom[doc.id]||{occupied:0,femaleCount:0,classCounts:{"96Q1":0,"96Q2":0}};batch.update(doc.ref,{...summary,assignedClass:roomMode(summary.classCounts,summary.occupied,summary.femaleCount),updatedAt:firebase.firestore.FieldValue.serverTimestamp()});});await batch.commit();}
  async function syncDinnerCandidates(){const snapshot=await db.collection("persons").get();for(let start=0;start<snapshot.docs.length;start+=400){const batch=db.batch();snapshot.docs.slice(start,start+400).forEach(doc=>{const person=doc.data();batch.set(db.collection("dinner_candidates").doc(doc.id),{fullName:person.fullName,className:person.className,isFemale:Boolean(person.isFemale),dinnerTableId:person.dinnerTableId||null,dinnerTableName:person.dinnerTableName||null},{merge:true});});await batch.commit();}}
  function subscribeData(){ db.collection("persons").orderBy("fullName").onSnapshot(s=>{persons=s.docs.map(d=>({id:d.id,...d.data()}));renderAll();},e=>toast(`Không tải được danh sách: ${e.message}`,true)); db.collection("rooms").onSnapshot(s=>{rooms={};s.forEach(d=>rooms[d.id]={id:d.id,...d.data()});renderAll();},e=>toast(`Không tải được phòng: ${e.message}`,true)); }
  function renderAll(){ const assigned=persons.filter(p=>p.roomKey).length, capacity=Object.values(rooms).reduce((n,r)=>n+Number(r.capacity||0),0); document.getElementById("stat-total").textContent=persons.length;document.getElementById("stat-unassigned").textContent=persons.length-assigned;document.getElementById("stat-assigned").textContent=assigned;document.getElementById("stat-available").textContent=Math.max(0,capacity-assigned);renderPersons();renderRooms(); }
  function renderPersons(){ const query=document.getElementById("person-search").value.toLowerCase().trim(), filter=document.getElementById("person-filter").value; const list=persons.filter(p=>(!query||`${p.fullName} ${p.className} ${p.phone||""}`.toLowerCase().includes(query))&&(filter==="all"||(filter==="assigned"&&p.roomKey)||(filter==="unassigned"&&!p.roomKey)||p.className===filter)); const banner=document.getElementById("selected-person-banner"), selected=persons.find(p=>p.id===selectedPersonId); banner.classList.toggle("hidden",!selected); if(selected) banner.innerHTML=`<div class="flex justify-between gap-2"><span>Đang xếp: <b>${esc(selected.fullName)}</b> · ${esc(selected.className)}</span><button data-clear-selection class="text-xs font-bold text-red-500">Bỏ chọn</button></div>`; document.getElementById("persons-list").innerHTML=list.length?list.map(p=>`<div class="mb-2 rounded-xl border p-3 ${selectedPersonId===p.id?"border-gold-500 bg-gold-50":"border-gray-200"}"><div class="flex items-start gap-2"><button data-select-person="${p.id}" class="min-w-0 flex-1 text-left"><div class="flex items-center gap-2"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-navy-900 text-xs font-bold text-gold-400">${esc(p.fullName?.charAt(0)||"?")}</span><span class="min-w-0"><b class="block truncate text-sm text-navy-900">${esc(p.fullName)}</b><small class="text-gray-500">${esc(p.className)}${p.roomKey?` · ${esc(p.hotelName)} P.${esc(p.roomNumber)}`:" · Chưa xếp"}</small></span></div></button><div class="flex gap-1"><button data-edit-person="${p.id}" class="p-1.5 text-gray-400 hover:text-navy-900"><i data-lucide="pencil" class="h-4 w-4"></i></button><button data-delete-person="${p.id}" class="p-1.5 text-gray-400 hover:text-red-500"><i data-lucide="trash-2" class="h-4 w-4"></i></button></div></div></div>`).join(""):`<p class="py-10 text-center text-sm text-gray-400">Không có thành viên phù hợp</p>`; bindPersonEvents();if(window.lucide)window.lucide.createIcons(); }
  function bindPersonEvents(){ document.querySelectorAll("[data-select-person]").forEach(b=>b.onclick=()=>{selectedPersonId=b.dataset.selectPerson;renderAll();});document.querySelector("[data-clear-selection]")?.addEventListener("click",()=>{selectedPersonId="";renderAll();});document.querySelectorAll("[data-edit-person]").forEach(b=>b.onclick=()=>openPersonModal(persons.find(p=>p.id===b.dataset.editPerson)));document.querySelectorAll("[data-delete-person]").forEach(b=>b.onclick=()=>deletePerson(b.dataset.deletePerson)); }
  function renderRooms(){const selected=persons.find(p=>p.id===selectedPersonId);document.getElementById("rooms-container").innerHTML=hotelConfigs.filter(h=>hotelFilter==="all"||h.id===hotelFilter).map(h=>`<div><div class="mb-3 flex items-center gap-2"><h3 class="font-serif text-xl font-bold text-navy-900">🏨 ${h.name}</h3><span class="text-xs text-gray-400">${h.rooms.length} phòng</span></div><div class="grid gap-3 md:grid-cols-2 2xl:grid-cols-3">${h.rooms.map(c=>{const key=roomKey(h.id,c.number),r=rooms[key]||{...c,occupied:0,assignedClass:null},occupants=persons.filter(p=>p.roomKey===key),full=occupants.length>=c.capacity,allFemale=occupants.length>0&&occupants.every(p=>p.isFemale),allMale=occupants.length>0&&occupants.every(p=>!p.isFemale),sameClass=!selected||occupants.every(p=>p.className===selected.className),mixedGender=occupants.length>0&&!allFemale&&!allMale,genderMismatch=Boolean(selected&&occupants.length&&selected.isFemale!==allFemale),classMismatch=Boolean(selected&&!selected.isFemale&&occupants.length&&!sameClass),incompatible=Boolean(selected&&(mixedGender||genderMismatch||classMismatch)),canAssign=selected&&!full&&!r.locked&&!incompatible&&selected.roomKey!==key,classSet=new Set(occupants.map(p=>p.className)),mode=occupants.length?(allFemale?"FEMALE":allMale&&classSet.size===1?[...classSet][0]:"MIXED"):null,label=mode==="FEMALE"?"Phòng nữ":mode==="MIXED"?"Cần sắp xếp lại":mode||"Chưa gán lớp",blockedText=mixedGender?"Phòng đang lẫn nam và nữ":genderMismatch?(allFemale?"Phòng chỉ dành cho nữ":"Phòng chỉ dành cho nam"):classMismatch?"Phòng nam khác lớp":"Không thể xếp";return `<article class="rounded-xl border-2 bg-white p-4 shadow-sm ${incompatible?"border-red-200 opacity-65":selected&&canAssign?"border-gold-400":"border-gray-100"}"><div class="flex justify-between"><div><b class="text-lg text-navy-900">Phòng ${c.number}</b><p class="text-[11px] text-gray-500">${c.bed}${c.extra!=="—"?` · Extra ${c.extra}`:""}</p></div><span class="h-fit rounded-full px-2 py-1 text-[10px] font-bold ${full?"bg-red-100 text-red-600":mode==="96Q1"?"bg-blue-100 text-blue-700":mode==="96Q2"?"bg-purple-100 text-purple-700":mode==="FEMALE"?"bg-pink-100 text-pink-700":mode==="MIXED"?"bg-red-100 text-red-700":"bg-gray-100 text-gray-500"}">${full?"Đã đủ":label}</span></div><div class="my-3 h-2 overflow-hidden rounded-full bg-gray-100"><div class="h-full rounded-full ${full?"bg-red-400":"bg-gold-500"}" style="width:${Math.min(100,occupants.length/c.capacity*100)}%"></div></div><div class="mb-3 flex justify-between text-[10px] text-gray-400"><span>${occupants.length} người</span><span>Tối đa ${c.capacity}</span></div><div class="min-h-14 space-y-1">${occupants.length?occupants.map(p=>`<div class="flex items-center justify-between rounded-md bg-gray-50 px-2 py-1.5 text-xs"><span class="truncate"><b>${esc(p.fullName)}</b> · ${esc(p.className)}${p.isFemale?" · Nữ":" · Nam"}</span><button data-unassign="${p.id}" title="Gỡ khỏi phòng" class="ml-2 text-gray-400 hover:text-red-500"><i data-lucide="x" class="h-3.5 w-3.5"></i></button></div>`).join(""):`<p class="py-3 text-center text-xs italic text-gray-300">Phòng trống</p>`}</div>${selected?`<button data-assign-room="${key}" ${canAssign?"":"disabled"} class="mt-3 w-full rounded-lg py-2 text-xs font-bold ${canAssign?"bg-navy-900 text-white hover:bg-gold-500":"cursor-not-allowed bg-gray-100 text-gray-400"}">${selected.roomKey===key?"Đang ở phòng này":incompatible?blockedText:full?"Phòng đã đủ":r.locked?"Phòng đã khóa":"Xếp vào phòng"}</button>`:""}</article>`}).join("")}</div></div>`).join("");document.querySelectorAll("[data-assign-room]").forEach(b=>b.onclick=()=>assignRoom(selectedPersonId,b.dataset.assignRoom));document.querySelectorAll("[data-unassign]").forEach(b=>b.onclick=()=>unassignPerson(b.dataset.unassign));if(window.lucide)window.lucide.createIcons();}
  function roomMetadataAfter(room,person,delta){const classCounts=roomClassCounts(room);classCounts[person.className]=Math.max(0,classCounts[person.className]+delta);const occupied=Math.max(0,Number(room.occupied||0)+delta),femaleCount=Math.max(0,Number(room.femaleCount||0)+(person.isFemale?delta:0));return{occupied,femaleCount,classCounts,assignedClass:roomMode(classCounts,occupied,femaleCount),updatedAt:firebase.firestore.FieldValue.serverTimestamp()};}
  async function assignRoom(personId,targetKey){try{await db.runTransaction(async tx=>{const personRef=db.collection("persons").doc(personId),targetRef=db.collection("rooms").doc(targetKey),personSnap=await tx.get(personRef),targetSnap=await tx.get(targetRef);if(!personSnap.exists||!targetSnap.exists)throw Error("Dữ liệu không tồn tại.");const p=personSnap.data(),target=targetSnap.data(),targetOccupied=Number(target.occupied||0),targetCounts=roomClassCounts(target),targetFemaleCount=Number(target.femaleCount||0),targetAllFemale=targetOccupied>0&&targetFemaleCount===targetOccupied,targetAllMale=targetOccupied>0&&targetFemaleCount===0,targetSameClass=targetCounts[p.className]===targetOccupied;if(target.locked)throw Error("Phòng đã khóa.");if(targetOccupied>=target.capacity)throw Error("Phòng đã đủ chỗ.");if(targetOccupied&&(!targetAllFemale&&!targetAllMale))throw Error("Phòng đang có cả nam và nữ, cần sắp xếp lại trước.");if(targetOccupied&&p.isFemale!==targetAllFemale)throw Error(targetAllFemale?"Phòng này chỉ dành cho nữ.":"Phòng này chỉ dành cho nam.");if(targetOccupied&&!p.isFemale&&!targetSameClass)throw Error("Phòng nam chỉ nhận thành viên cùng lớp.");if(p.roomKey){const oldRef=db.collection("rooms").doc(p.roomKey),oldSnap=await tx.get(oldRef);if(oldSnap.exists)tx.update(oldRef,roomMetadataAfter(oldSnap.data(),p,-1));}tx.update(targetRef,roomMetadataAfter(target,p,1));tx.update(personRef,{roomKey:targetKey,hotelId:target.hotelId,hotelName:target.hotelName,roomNumber:target.roomNumber,updatedAt:firebase.firestore.FieldValue.serverTimestamp(),updatedBy:currentAdmin.uid});});toast("Đã xếp phòng thành công.");}catch(e){toast(e.message,true);}}
  async function unassignPerson(personId){const p=persons.find(x=>x.id===personId);if(!p?.roomKey||!confirm(`Gỡ ${p.fullName} khỏi phòng ${p.roomNumber}?`))return;try{await db.runTransaction(async tx=>{const pRef=db.collection("persons").doc(personId),rRef=db.collection("rooms").doc(p.roomKey),rSnap=await tx.get(rRef);if(rSnap.exists)tx.update(rRef,roomMetadataAfter(rSnap.data(),p,-1));tx.update(pRef,{roomKey:null,hotelId:null,hotelName:null,roomNumber:null,updatedAt:firebase.firestore.FieldValue.serverTimestamp(),updatedBy:currentAdmin.uid});});toast("Đã gỡ người khỏi phòng.");}catch(e){toast(e.message,true);}}
  function openPersonModal(p=null){document.getElementById("person-modal-title").textContent=p?"Sửa thành viên":"Thêm thành viên";document.getElementById("person-id").value=p?.id||"";document.getElementById("person-name").value=p?.fullName||"";document.getElementById("person-class").value=p?.className||"96Q1";document.getElementById("person-is-female").checked=Boolean(p?.isFemale);document.getElementById("person-phone").value=p?.phone||"";document.getElementById("person-note").value=p?.note||"";const m=document.getElementById("person-modal");m.classList.remove("hidden");m.classList.add("flex");document.getElementById("person-name").focus();}
  function closePersonModal(){const m=document.getElementById("person-modal");m.classList.add("hidden");m.classList.remove("flex");}
  document.getElementById("person-form").onsubmit=async e=>{e.preventDefault();const id=document.getElementById("person-id").value,data={fullName:document.getElementById("person-name").value.trim(),className:document.getElementById("person-class").value,isFemale:document.getElementById("person-is-female").checked,phone:document.getElementById("person-phone").value.trim(),note:document.getElementById("person-note").value.trim(),updatedAt:firebase.firestore.FieldValue.serverTimestamp(),updatedBy:currentAdmin.uid};const old=persons.find(p=>p.id===id);if(old?.roomKey&&old.className!==data.className){toast("Hãy gỡ người khỏi phòng trước khi đổi lớp.",true);return;}if(old?.dinnerTableId&&Boolean(old.isFemale)!==data.isFemale){toast("Hãy gỡ người khỏi bàn Dinner trước khi đổi giới tính.",true);return;}try{if(id)await db.collection("persons").doc(id).update(data);else await db.collection("persons").add({...data,roomKey:null,hotelId:null,hotelName:null,roomNumber:null,dinnerTableId:null,dinnerTableName:null,createdAt:firebase.firestore.FieldValue.serverTimestamp()});await syncDinnerCandidates();closePersonModal();toast(id?"Đã cập nhật thành viên.":"Đã thêm thành viên.");}catch(err){toast(err.message,true);}};
  const personKey=p=>`${String(p.fullName||"").trim().replace(/\s+/g," ").toLocaleLowerCase("vi")}::${p.className}`;
  function normalizeImportedPerson(value){if(!value||typeof value!=="object"||Array.isArray(value))return null;const fullName=String(value.fullName||"").trim().replace(/\s+/g," "),className=String(value.className||"").trim().toUpperCase();if(!fullName||!["96Q1","96Q2"].includes(className)||typeof value.isFemale!=="boolean")return null;return{fullName,className,isFemale:value.isFemale,phone:String(value.phone||"").trim(),note:String(value.note||"").trim(),roomKey:null,hotelId:null,hotelName:null,roomNumber:null,dinnerTableId:null,dinnerTableName:null};}
  async function importPersons(files){const button=document.getElementById("import-persons-button");button.disabled=true;button.classList.add("cursor-wait","opacity-60");try{let raw=[],invalid=0;for(const file of files){let parsed;try{parsed=JSON.parse(await file.text());}catch{throw new Error(`File ${file.name} không phải JSON hợp lệ.`);}if(!Array.isArray(parsed))throw new Error(`File ${file.name} phải chứa một mảng person.`);raw.push(...parsed);}const existingKeys=new Set(persons.map(personKey)),seen=new Set(),valid=[];let duplicates=0;for(const value of raw){const person=normalizeImportedPerson(value);if(!person){invalid++;continue;}const key=personKey(person);if(existingKeys.has(key)||seen.has(key)){duplicates++;continue;}seen.add(key);valid.push(person);}if(!valid.length){toast(`Không có person mới để import (${duplicates} trùng, ${invalid} không hợp lệ).`,true);return;}const approved=confirm(`Đã đọc ${raw.length} dòng.\n\nSẽ thêm: ${valid.length}\nBỏ qua do trùng: ${duplicates}\nKhông hợp lệ: ${invalid}\n\nTiếp tục import?`);if(!approved)return;for(let start=0;start<valid.length;start+=200){const batch=db.batch();valid.slice(start,start+200).forEach(person=>{const ref=db.collection("persons").doc(),timestamp=firebase.firestore.FieldValue.serverTimestamp();batch.set(ref,{...person,createdAt:timestamp,updatedAt:timestamp,updatedBy:currentAdmin.uid});batch.set(db.collection("dinner_candidates").doc(ref.id),{fullName:person.fullName,className:person.className,isFemale:person.isFemale,dinnerTableId:null,dinnerTableName:null});});await batch.commit();}toast(`Đã import ${valid.length} thành viên; bỏ qua ${duplicates} trùng và ${invalid} không hợp lệ.`);}catch(error){toast(error.message||"Không thể import danh sách.",true);}finally{button.disabled=false;button.classList.remove("cursor-wait","opacity-60");document.getElementById("import-persons-input").value="";}}
  async function deletePerson(id){const p=persons.find(x=>x.id===id);if(!p||!confirm(`Xóa ${p.fullName} khỏi danh sách?`))return;try{await db.runTransaction(async tx=>{const personRef=db.collection("persons").doc(id),personSnap=await tx.get(personRef);if(!personSnap.exists)return;const data=personSnap.data();if(data.roomKey){const roomRef=db.collection("rooms").doc(data.roomKey),roomSnap=await tx.get(roomRef);if(roomSnap.exists)tx.update(roomRef,roomMetadataAfter(roomSnap.data(),data,-1));}tx.delete(personRef);tx.delete(db.collection("dinner_candidates").doc(id));});if(selectedPersonId===id)selectedPersonId="";toast("Đã xóa thành viên.");}catch(e){toast(e.message,true);}}
  document.getElementById("add-person-button").onclick=()=>openPersonModal();document.getElementById("import-persons-button").onclick=()=>document.getElementById("import-persons-input").click();document.getElementById("import-persons-input").onchange=e=>{const files=[...e.target.files];if(files.length)importPersons(files);};document.querySelectorAll("[data-close-modal]").forEach(b=>b.onclick=closePersonModal);document.getElementById("person-search").oninput=renderPersons;document.getElementById("person-filter").onchange=renderPersons;document.querySelectorAll("[data-hotel-tab]").forEach(b=>b.onclick=()=>{hotelFilter=b.dataset.hotelTab;document.querySelectorAll(".hotel-tab").forEach(x=>x.className="hotel-tab rounded-md px-3 py-2 text-xs font-semibold text-gray-600");b.className="hotel-tab rounded-md bg-navy-900 px-3 py-2 text-xs font-bold text-white";renderRooms();});
  document.getElementById("logout-button").onclick=async()=>{await auth.signOut();location.replace(loginUrl);};document.getElementById("change-password-button").onclick=()=>{const m=document.getElementById("password-modal");m.classList.remove("hidden");m.classList.add("flex");};document.getElementById("close-password").onclick=()=>{const m=document.getElementById("password-modal");m.classList.add("hidden");m.classList.remove("flex");};document.getElementById("password-form").onsubmit=async e=>{e.preventDefault();const current=document.getElementById("current-password").value,next=document.getElementById("new-password").value,confirmValue=document.getElementById("confirm-password").value,msg=document.getElementById("password-message");if(next!==confirmValue){msg.textContent="Mật khẩu xác nhận không khớp.";msg.className="mt-3 rounded-lg bg-red-50 p-3 text-xs text-red-700";return;}try{await currentAdmin.reauthenticateWithCredential(firebase.auth.EmailAuthProvider.credential(currentAdmin.email,current));await currentAdmin.updatePassword(next);await auth.signOut();location.replace(loginUrl);}catch{msg.textContent="Mật khẩu hiện tại không đúng hoặc mật khẩu mới chưa hợp lệ.";msg.className="mt-3 rounded-lg bg-red-50 p-3 text-xs text-red-700";}};
</script>
