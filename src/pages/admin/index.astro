      for (const room of hotel.rooms) {
        const key = roomKey(hotel.id, room.number),
          ref = db.collection("rooms").doc(key),
          snap = await ref.get();
        if (!snap.exists) {
          batch.set(ref, {
            hotelId: hotel.id,
            hotelName: hotel.name,
            roomNumber: room.number,
            bed: room.bed,
            extraBed: room.extra,
            capacity: room.capacity,
            occupied: 0,
            femaleCount: 0,
            classCounts: { "96Q1": 0, "96Q2": 0 },
            assignedClass: null,
