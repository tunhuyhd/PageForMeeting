  async function syncRoomMetadata() {
    const [personSnapshot, roomSnapshot] = await Promise.all([
        db.collection("persons").get(),
        db.collection("rooms").get(),
      ]),
      byRoom = {};
    personSnapshot.docs.forEach((doc) => {
      const p = doc.data();
      if (!p.roomKey) return;
      const summary =
        byRoom[p.roomKey] ||
        (byRoom[p.roomKey] = {
          occupied: 0,
          femaleCount: 0,
          classCounts: { "96Q1": 0, "96Q2": 0 },
        });
      summary.occupied++;
      if (p.isFemale) summary.femaleCount++;
      if (p.className in summary.classCounts)
        summary.classCounts[p.className]++;
    });
    const batch = db.batch();
    roomSnapshot.docs.forEach((doc) => {
      const summary = byRoom[doc.id] || {
        occupied: 0,
        femaleCount: 0,
        classCounts: { "96Q1": 0, "96Q2": 0 },
      };
      batch.update(doc.ref, {
        ...summary,
        assignedClass: roomMode(
          summary.classCounts,
          summary.occupied,
          summary.femaleCount,
        ),
        updatedAt: firebase.firestore.FieldValue.serverTimestamp(),
      });
    });
    await batch.commit();
