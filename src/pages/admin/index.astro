      occupied,
      femaleCount,
      classCounts,
      assignedClass: roomMode(classCounts, occupied, femaleCount),
      updatedAt: firebase.firestore.FieldValue.serverTimestamp(),
    };
  }
  async function assignRoom(personId, targetKey) {
    try {
      await db.runTransaction(async (tx) => {
        const personRef = db.collection("persons").doc(personId),
          targetRef = db.collection("rooms").doc(targetKey),
          publicRef = db.collection("public_results").doc(personId),
          personSnap = await tx.get(personRef),
          targetSnap = await tx.get(targetRef);
        if (!personSnap.exists || !targetSnap.exists)
          throw Error("Dữ liệu không tồn tại.");
        const p = personSnap.data(),
          target = targetSnap.data(),
          targetOccupied = Number(target.occupied || 0),
          targetCounts = roomClassCounts(target),
          targetFemaleCount = Number(target.femaleCount || 0),
          targetAllFemale =
            targetOccupied > 0 && targetFemaleCount === targetOccupied,
          targetAllMale = targetOccupied > 0 && targetFemaleCount === 0,
          targetSameClass = targetCounts[p.className] === targetOccupied;
        if (target.locked) throw Error("Phòng đã khóa.");
        if (targetOccupied >= target.capacity) throw Error("Phòng đã đủ chỗ.");
        if (targetOccupied && !targetAllFemale && !targetAllMale)
          throw Error("Phòng đang có cả nam và nữ, cần sắp xếp lại trước.");
        if (targetOccupied && p.isFemale !== targetAllFemale)
          throw Error(
            targetAllFemale
              ? "Phòng này chỉ dành cho nữ."
              : "Phòng này chỉ dành cho nam.",
          );
        if (targetOccupied && !p.isFemale && !targetSameClass)
          throw Error("Phòng nam chỉ nhận thành viên cùng lớp.");
        if (p.roomKey) {
          const oldRef = db.collection("rooms").doc(p.roomKey),
            oldSnap = await tx.get(oldRef);
          if (oldSnap.exists)
            tx.update(oldRef, roomMetadataAfter(oldSnap.data(), p, -1));
        }
        tx.update(targetRef, roomMetadataAfter(target, p, 1));
        tx.update(personRef, {
          roomKey: targetKey,
          hotelId: target.hotelId,
          hotelName: target.hotelName,
          roomNumber: target.roomNumber,
          updatedAt: firebase.firestore.FieldValue.serverTimestamp(),
          updatedBy: currentAdmin.uid,
        });
        tx.set(
          publicRef,
          {
            name: p.fullName,
            className: p.className,
            isFemale: Boolean(p.isFemale),
            isAttending: p.isAttending !== false,
            roomKey: targetKey,
            hotelName: target.hotelName,
            roomNumber: target.roomNumber,
          },
          { merge: true },
        );
      });
      toast("Đã xếp phòng thành công.");
    } catch (e) {
      toast(e.message, true);
    }
  }
  async function unassignPerson(personId) {
    const p = persons.find((x) => x.id === personId);
    if (!p?.roomKey || !confirm(`Gỡ ${p.fullName} khỏi phòng ${p.roomNumber}?`))
      return;
    try {
      await db.runTransaction(async (tx) => {
        const pRef = db.collection("persons").doc(personId),
          publicRef = db.collection("public_results").doc(personId),
          rRef = db.collection("rooms").doc(p.roomKey),
          rSnap = await tx.get(rRef);
        if (rSnap.exists)
          tx.update(rRef, roomMetadataAfter(rSnap.data(), p, -1));
        tx.update(pRef, {
          roomKey: null,
          hotelId: null,
          hotelName: null,
          roomNumber: null,
          updatedAt: firebase.firestore.FieldValue.serverTimestamp(),
          updatedBy: currentAdmin.uid,
        });
        tx.set(
          publicRef,
          {
            name: p.fullName,
            className: p.className,
            isFemale: Boolean(p.isFemale),
            isAttending: p.isAttending !== false,
            roomKey: null,
            hotelName: null,
            roomNumber: null,
          },
          { merge: true },
        );
      });
      toast("Đã gỡ người khỏi phòng.");
    } catch (e) {
      toast(e.message, true);
    }
  }
  function openPersonModal(p = null) {
    document.getElementById("person-modal-title").textContent = p
      ? "Sửa thành viên"
      : "Thêm thành viên";
    document.getElementById("person-id").value = p?.id || "";
    document.getElementById("person-name").value = p?.fullName || "";
    document.getElementById("person-class").value = p?.className || "96Q1";
    document.getElementById("person-is-female").checked = Boolean(p?.isFemale);
    document.getElementById("person-phone").value = p?.phone || "";
    document.getElementById("person-note").value = p?.note || "";
    const m = document.getElementById("person-modal");
    m.classList.remove("hidden");
    m.classList.add("flex");
    document.getElementById("person-name").focus();
  }
  function closePersonModal() {
    const m = document.getElementById("person-modal");
    m.classList.add("hidden");
    m.classList.remove("flex");
  }
  document.getElementById("person-form").onsubmit = async (e) => {
    e.preventDefault();
    const id = document.getElementById("person-id").value,
      data = {
        fullName: document.getElementById("person-name").value.trim(),
        className: document.getElementById("person-class").value,
        isFemale: document.getElementById("person-is-female").checked,
        phone: document.getElementById("person-phone").value.trim(),
        note: document.getElementById("person-note").value.trim(),
        updatedAt: firebase.firestore.FieldValue.serverTimestamp(),
        updatedBy: currentAdmin.uid,
      };
    const old = persons.find((p) => p.id === id);
    if (old?.roomKey && old.className !== data.className) {
      toast("Hãy gỡ người khỏi phòng trước khi đổi lớp.", true);
      return;
    }
    if (old?.dinnerTableId && Boolean(old.isFemale) !== data.isFemale) {
      toast("Hãy gỡ người khỏi bàn Dinner trước khi đổi giới tính.", true);
      return;
    }
    try {
      let personRef;
      const completeData = id ? { ...old, ...data } : {
          ...data,
          isAttending: true,
          roomKey: null,
          hotelId: null,
          hotelName: null,
          roomNumber: null,
          dinnerTableId: null,
          dinnerTableName: null,
          createdAt: firebase.firestore.FieldValue.serverTimestamp(),
        };
      if (id) {
        personRef = db.collection("persons").doc(id);
        await personRef.update(data);
      } else {
        personRef = await db.collection("persons").add(completeData);
      }
      const publicBatch = db.batch();
      publicBatch.set(db.collection("dinner_candidates").doc(personRef.id), {
        fullName: completeData.fullName,
        className: completeData.className,
        isFemale: Boolean(completeData.isFemale),
        isAttending: completeData.isAttending !== false,
        dinnerTableId: completeData.dinnerTableId || null,
        dinnerTableName: completeData.dinnerTableName || null,
      }, { merge: true });
      publicBatch.set(db.collection("public_results").doc(personRef.id), {
        name: completeData.fullName,
        className: completeData.className,
        isFemale: Boolean(completeData.isFemale),
        isAttending: completeData.isAttending !== false,
        roomKey: completeData.roomKey || null,
        hotelName: completeData.hotelName || null,
        roomNumber: completeData.roomNumber || null,
        tableName: completeData.dinnerTableName || null,
      }, { merge: true });
      await publicBatch.commit();
      closePersonModal();
      toast(id ? "Đã cập nhật thành viên." : "Đã thêm thành viên.");
    } catch (err) {
      toast(err.message, true);
    }
  };
  const personKey = (p) =>
    `${String(p.fullName || "")
      .trim()
      .replace(/\s+/g, " ")
      .toLocaleLowerCase("vi")}::${p.className}`;
  function normalizeImportedPerson(value) {
    if (!value || typeof value !== "object" || Array.isArray(value))
      return null;
    const fullName = String(value.fullName || "")
        .trim()
        .replace(/\s+/g, " "),
      className = String(value.className || "")
        .trim()
        .toUpperCase();
    if (
      !fullName ||
      !["96Q1", "96Q2"].includes(className) ||
      typeof value.isFemale !== "boolean"
    )
      return null;
    return {
      fullName,
      className,
      isFemale: value.isFemale,
      isAttending: value.isAttending !== false,
      phone: String(value.phone || "").trim(),
      note: String(value.note || "").trim(),
      roomKey: null,
      hotelId: null,
      hotelName: null,
      roomNumber: null,
      dinnerTableId: null,
      dinnerTableName: null,
    };
  }
  async function importPersons(files) {
    const button = document.getElementById("import-persons-button");
    button.disabled = true;
    button.classList.add("cursor-wait", "opacity-60");
    try {
      let raw = [],
        invalid = 0;
      for (const file of files) {
        let parsed;
        try {
          parsed = JSON.parse(await file.text());
        } catch {
          throw new Error(`File ${file.name} không phải JSON hợp lệ.`);
        }
        if (!Array.isArray(parsed))
          throw new Error(`File ${file.name} phải chứa một mảng person.`);
        raw.push(...parsed);
      }
      const existingKeys = new Set(persons.map(personKey)),
        seen = new Set(),
        valid = [];
      let duplicates = 0;
      for (const value of raw) {
        const person = normalizeImportedPerson(value);
        if (!person) {
          invalid++;
          continue;
        }
        const key = personKey(person);
        if (existingKeys.has(key) || seen.has(key)) {
          duplicates++;
          continue;
        }
        seen.add(key);
        valid.push(person);
      }
      if (!valid.length) {
        toast(
          `Không có person mới để import (${duplicates} trùng, ${invalid} không hợp lệ).`,
          true,
        );
        return;
      }
      const approved = confirm(
        `Đã đọc ${raw.length} dòng.\n\nSẽ thêm: ${valid.length}\nBỏ qua do trùng: ${duplicates}\nKhông hợp lệ: ${invalid}\n\nTiếp tục import?`,
      );
      if (!approved) return;
      for (let start = 0; start < valid.length; start += 200) {
        const batch = db.batch();
        valid.slice(start, start + 200).forEach((person) => {
          const ref = db.collection("persons").doc(),
            timestamp = firebase.firestore.FieldValue.serverTimestamp();
          batch.set(ref, {
            ...person,
            createdAt: timestamp,
            updatedAt: timestamp,
            updatedBy: currentAdmin.uid,
          });
          batch.set(db.collection("dinner_candidates").doc(ref.id), {
            fullName: person.fullName,
            className: person.className,
            isFemale: person.isFemale,
            dinnerTableId: null,
            dinnerTableName: null,
          });
        });
        await batch.commit();
      }
      toast(
        `Đã import ${valid.length} thành viên; bỏ qua ${duplicates} trùng và ${invalid} không hợp lệ.`,
      );
    } catch (error) {
      toast(error.message || "Không thể import danh sách.", true);
    } finally {
      button.disabled = false;
      button.classList.remove("cursor-wait", "opacity-60");
      document.getElementById("import-persons-input").value = "";
    }
  }
  async function deletePerson(id) {
    const p = persons.find((x) => x.id === id);
    if (!p || !confirm(`Xóa ${p.fullName} khỏi danh sách?`)) return;
    try {
      await db.runTransaction(async (tx) => {
        const personRef = db.collection("persons").doc(id),
          personSnap = await tx.get(personRef);
        if (!personSnap.exists) return;
        const data = personSnap.data();
        if (data.roomKey) {
          const roomRef = db.collection("rooms").doc(data.roomKey),
            roomSnap = await tx.get(roomRef);
          if (roomSnap.exists)
            tx.update(roomRef, roomMetadataAfter(roomSnap.data(), data, -1));
        }
        tx.delete(personRef);
        tx.delete(db.collection("dinner_candidates").doc(id));
      });
      if (selectedPersonId === id) selectedPersonId = "";
      toast("Đã xóa thành viên.");
    } catch (e) {
      toast(e.message, true);
    }
  }
  document.getElementById("add-person-button").onclick = () =>
    openPersonModal();
  document.getElementById("import-persons-button").onclick = () =>
    document.getElementById("import-persons-input").click();
  document.getElementById("import-persons-input").onchange = (e) => {
    const files = [...e.target.files];
    if (files.length) importPersons(files);
  };
  document
    .querySelectorAll("[data-close-modal]")
    .forEach((b) => (b.onclick = closePersonModal));
  document.getElementById("person-search").oninput = renderPersons;
  document.getElementById("person-filter").onchange = renderPersons;
  document.querySelectorAll("[data-class-attendance]").forEach((button) => {
    button.onclick = () => {
      classAttendanceView = button.dataset.classAttendance;
      document.getElementById("person-search").value = "";
      renderPersons();
    };
  });
  document.querySelectorAll("[data-hotel-tab]").forEach(
    (b) =>
      (b.onclick = () => {
        hotelFilter = b.dataset.hotelTab;
        document
          .querySelectorAll(".hotel-tab")
          .forEach(
            (x) =>
              (x.className =
                "hotel-tab rounded-md px-3 py-2 text-xs font-semibold text-gray-600"),
          );
        b.className =
          "hotel-tab rounded-md bg-navy-900 px-3 py-2 text-xs font-bold text-white";
        renderRooms();
      }),
  );
  async function updateHomepageSetting(field, value) {
    try {
      await db
        .collection("public_settings")
        .doc("homepage")
        .set(
          {
            [field]: value,
            updatedAt: firebase.firestore.FieldValue.serverTimestamp(),
            updatedBy: currentAdmin.uid,
          },
          { merge: true },
        );
      toast(
        value
          ? "Đã bật thẻ kết quả trên trang chủ."
          : "Đã ẩn thẻ kết quả trên trang chủ.",
      );
    } catch (error) {
      toast(error.message, true);
    }
  }
  document.getElementById("show-accommodation-result").onchange = (event) =>
    updateHomepageSetting("showAccommodationResult", event.target.checked);
  document.getElementById("sync-accommodation-results").onclick = async (event) => {
    const button = event.currentTarget;
    button.disabled = true;
    button.textContent = "Đang đồng bộ...";
    try {
      await syncPublicResults();
      toast("Đã đồng bộ dữ liệu chỗ ở công khai.");
    } catch (error) {
      toast(error.message, true);
    } finally {
      button.disabled = false;
      button.textContent = "Đồng bộ dữ liệu chỗ ở";
    }
  };
  document.getElementById("show-dinner-result").onchange = (event) =>
    updateHomepageSetting("showDinnerResult", event.target.checked);
  document.getElementById("show-pickleball-result").onchange = async (event) => {
    const checkbox = event.target,
      value = checkbox.checked;
    checkbox.disabled = true;
    try {
      await db.collection("public_settings").doc("pickleball").set(
        {
          showResult: value,
          updatedAt: firebase.firestore.FieldValue.serverTimestamp(),
          updatedBy: currentAdmin.uid,
        },
        { merge: true },
      );
      toast(value ? "Đã công khai kết quả Pickleball." : "Đã ẩn kết quả Pickleball.");
    } catch (error) {
      checkbox.checked = !value;
      toast(`Không cập nhật được Pickleball: ${error.message}`, true);
    } finally {
      checkbox.disabled = false;
    }
  };
  document.getElementById("logout-button").onclick = async () => {
    await auth.signOut();
    location.replace(loginUrl);
  };
  document.getElementById("change-password-button").onclick = () => {
    const m = document.getElementById("password-modal");
    m.classList.remove("hidden");
    m.classList.add("flex");
  };
  document.getElementById("close-password").onclick = () => {
    const m = document.getElementById("password-modal");
    m.classList.add("hidden");
    m.classList.remove("flex");
  };
  document.getElementById("password-form").onsubmit = async (e) => {
    e.preventDefault();
    const current = document.getElementById("current-password").value,
      next = document.getElementById("new-password").value,
      confirmValue = document.getElementById("confirm-password").value,
      msg = document.getElementById("password-message");
    if (next !== confirmValue) {
      msg.textContent = "Mật khẩu xác nhận không khớp.";
      msg.className = "mt-3 rounded-lg bg-red-50 p-3 text-xs text-red-700";
      return;
    }
    try {
      await currentAdmin.reauthenticateWithCredential(
        firebase.auth.EmailAuthProvider.credential(currentAdmin.email, current),
      );
      await currentAdmin.updatePassword(next);
      await auth.signOut();
      location.replace(loginUrl);
    } catch {
      msg.textContent =
        "Mật khẩu hiện tại không đúng hoặc mật khẩu mới chưa hợp lệ.";
      msg.className = "mt-3 rounded-lg bg-red-50 p-3 text-xs text-red-700";
    }
  };
</script>
