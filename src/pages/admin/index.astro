---
import Layout from "../../layouts/Layout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const loginUrl = `${base}/admin/login/index.html`;
const homeUrl = `${base}/`;
const dinnerUrl = `${base}/admin/dinner/index.html`;
const pickleballUrl = `${base}/admin/pickleball/index.html`;
---

<Layout title="Quản trị thành viên & khách sạn - 96Q">
  <div
    id="auth-loading"
    class="fixed inset-0 z-[200] flex items-center justify-center bg-navy-900 text-white"
  >
    <div class="text-center">
      <i
        data-lucide="loader-2"
        class="mx-auto h-9 w-9 animate-spin text-gold-400"></i><p
        class="mt-3 text-sm"
      >
        Đang kiểm tra quyền quản trị...
      </p>
    </div>
  </div>
  <div id="admin-app" class="hidden min-h-screen bg-gray-100">
    <header
      class="sticky top-0 z-40 border-b border-white/10 bg-navy-900 text-white shadow-lg"
    >
      <div
        class="mx-auto flex max-w-[1500px] items-center justify-between gap-4 px-4 py-3 sm:px-6"
      >
        <div class="flex items-center gap-3">
          <img src={`${base}/logo30.png`} alt="96Q" class="h-11 w-auto" /><div>
            <h1 class="font-serif font-bold">Quản trị lưu trú</h1><p
              class="text-[10px] uppercase tracking-wider text-gold-400"
            >
              30 năm hội ngộ 96Q
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span
            id="admin-email-label"
            class="hidden text-xs text-gray-300 lg:block"></span><button
            id="change-password-button"
            class="rounded-lg border border-white/15 p-2 text-gray-300 hover:text-gold-400"
            title="Đổi mật khẩu"
            ><i data-lucide="key-round" class="h-4 w-4"></i></button
          ><button
            id="logout-button"
            class="flex items-center gap-2 rounded-lg bg-white/10 px-3 py-2 text-xs font-semibold hover:bg-red-500"
            ><i data-lucide="log-out" class="h-4 w-4"></i><span
              class="hidden sm:inline">Đăng xuất</span
            ></button
          >
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-[1500px] p-4 sm:p-6">
      <nav
        aria-label="Chuyển trang quản trị"
        class="mb-5 grid grid-cols-3 rounded-xl bg-white p-1 shadow-sm sm:ml-auto sm:w-fit"
      >
        <span
          aria-current="page"
          class="flex items-center justify-center gap-2 rounded-lg bg-navy-900 px-4 py-2.5 text-xs font-bold text-white"
          ><i data-lucide="hotel" class="h-4 w-4"></i>Xếp phòng</span
        >
        <a
          href={dinnerUrl}
          class="flex items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-xs font-bold text-gray-600 transition hover:bg-gold-100 hover:text-navy-900"
          ><i data-lucide="circle-dot" class="h-4 w-4"></i>Bàn Dinner</a
        >
        <a
          href={pickleballUrl}
          class="flex items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-xs font-bold text-gray-600 transition hover:bg-gold-100 hover:text-navy-900"
          ><i data-lucide="trophy" class="h-4 w-4"></i>Pickleball</a
        >
      </nav>
      <section
        class="mb-5 rounded-xl border border-gold-200 bg-gold-50 p-4 shadow-sm"
      >
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="font-bold text-navy-900">
              Hiển thị kết quả trên trang chủ
            </h2><p class="text-xs text-gray-600">
              Bật hoặc tắt độc lập hai thẻ tra cứu dành cho thành viên.
            </p>
          </div><div class="flex flex-wrap items-center gap-4">
            <button
              id="sync-accommodation-results"
              type="button"
              class="rounded-lg border border-navy-900 bg-white px-3 py-2 text-xs font-bold text-navy-900 hover:bg-navy-900 hover:text-white"
            >Đồng bộ dữ liệu chỗ ở</button>
            <label
              class="flex cursor-pointer items-center gap-2 text-sm font-semibold text-navy-900"
              ><input
                id="show-accommodation-result"
                type="checkbox"
                class="h-5 w-5 accent-gold-500"
              /> Kết quả xếp chỗ ở</label
            ><label
              class="flex cursor-pointer items-center gap-2 text-sm font-semibold text-navy-900"
              ><input
                id="show-dinner-result"
                type="checkbox"
                class="h-5 w-5 accent-gold-500"
              /> Kết quả xếp bàn ăn</label
            >
            <label
              class="flex cursor-pointer items-center gap-2 text-sm font-semibold text-navy-900"
              ><input
                id="show-pickleball-result"
                type="checkbox"
                class="h-5 w-5 accent-gold-500"
              /> Danh sách & xếp hạng Pickleball</label
            >
          </div>
        </div>
      </section>
      <div class="mb-5 grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-6">
        <div class="rounded-xl bg-white p-4 shadow-sm"><span class="text-xs text-gray-500">Tổng thành viên</span><strong id="stat-total" class="mt-1 block text-2xl text-navy-900">0</strong></div>
        <div class="rounded-xl bg-white p-4 shadow-sm"><span class="text-xs text-gray-500">Thành viên không tham gia</span><strong id="stat-not-attending" class="mt-1 block text-2xl text-gray-500">0</strong></div>
        <div class="rounded-xl bg-white p-4 shadow-sm"><span class="text-xs text-gray-500">Thành viên tham gia</span><strong id="stat-attending" class="mt-1 block text-2xl text-blue-600">0</strong></div>
        <div class="rounded-xl bg-white p-4 shadow-sm"><span class="text-xs text-gray-500">Đã xếp phòng</span><strong id="stat-assigned" class="mt-1 block text-2xl text-green-600">0</strong></div>
        <div class="rounded-xl bg-white p-4 shadow-sm"><span class="text-xs text-gray-500">Chưa xếp phòng</span><strong id="stat-unassigned" class="mt-1 block text-2xl text-orange-500">0</strong></div>
        <div class="rounded-xl bg-white p-4 shadow-sm"><span class="text-xs text-gray-500">Chỗ ở còn lại</span><strong id="stat-available" class="mt-1 block text-2xl text-gold-600">0</strong></div>
      </div>

      <div class="grid gap-5 xl:grid-cols-[420px_1fr] xl:items-start">
        <section class="rounded-2xl bg-white shadow-sm xl:sticky xl:top-24">
          <div class="border-b border-gray-100 p-4">
            <div class="flex items-start justify-between gap-2">
              <div>
                <h2 class="font-bold text-navy-900">
                  Danh sách các thành viên
                </h2><p class="text-xs text-gray-500">
                  Chọn một người để xếp phòng
                </p>
              </div><div class="flex shrink-0 gap-2">
                <button
                  id="import-persons-button"
                  type="button"
                  class="flex items-center gap-1 rounded-lg border border-navy-900 px-2.5 py-2 text-xs font-bold text-navy-900 hover:bg-gray-50"
                  title="Import danh sách person từ JSON"
                  ><i data-lucide="file-up" class="h-4 w-4"></i><span
                    class="hidden sm:inline">Import JSON</span
                  ></button
                ><button
                  id="add-person-button"
                  type="button"
                  class="flex items-center gap-1 rounded-lg bg-navy-900 px-3 py-2 text-xs font-bold text-white hover:bg-gold-500"
                  ><i data-lucide="user-plus" class="h-4 w-4"></i> Thêm</button
                >
              </div>
            </div>
            <input
              id="import-persons-input"
              type="file"
              accept="application/json,.json"
              multiple
              class="hidden"
            />
            <div class="mt-3 flex gap-2">
              <div class="relative flex-1">
                <i
                  data-lucide="search"
                  class="absolute left-3 top-2.5 h-4 w-4 text-gray-400"
                ></i><input
                  id="person-search"
                  type="search"
                  placeholder="Tìm theo tên, lớp..."
                  class="w-full rounded-lg border border-gray-200 py-2 pl-9 pr-3 text-sm outline-none focus:border-gold-500"
                />
              </div><select
                id="person-filter"
                class="rounded-lg border border-gray-200 bg-white px-2 text-xs"
                ><option value="all">Tất cả</option><option value="unassigned"
                  >Chưa xếp</option
                ><option value="assigned">Đã xếp</option><option
                  value="attending">Xác nhận tham gia</option><option
                  value="not-attending">Không tham gia</option
                ><option value="96Q1">96Q1</option><option value="96Q2"
                  >96Q2</option
                ></select
              >
            </div>
            <div id="class-attendance-summary" class="mt-3 hidden grid-cols-3 gap-2 rounded-xl border p-2.5 text-center">
              <button type="button" data-class-attendance="all" class="class-attendance-button rounded-lg px-1 py-1.5 transition"><span class="block text-[10px] font-semibold uppercase text-gray-500">Tổng số</span><b id="class-stat-total" class="text-lg text-navy-900">0</b></button>
              <button type="button" data-class-attendance="attending" class="class-attendance-button rounded-lg px-1 py-1.5 transition"><span class="block text-[10px] font-semibold uppercase text-green-700">Tham gia</span><b id="class-stat-attending" class="text-lg text-green-600">0</b></button>
              <button type="button" data-class-attendance="not-attending" class="class-attendance-button rounded-lg px-1 py-1.5 transition"><span class="block text-[10px] font-semibold uppercase text-gray-500">Không tham gia</span><b id="class-stat-not-attending" class="text-lg text-gray-500">0</b></button>
            </div>
          </div>
          <div
            id="selected-person-banner"
            class="hidden border-b border-gold-200 bg-gold-50 p-3 text-sm"
          >
          </div>
          <div
            id="persons-list"
            class="max-h-[calc(100vh-300px)] min-h-52 overflow-y-auto p-3"
          >
          </div>
        </section>

        <section>
          <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
            <div>
              <h2 class="font-serif text-2xl font-bold text-navy-900">
                Sơ đồ phòng khách sạn
              </h2><p class="text-xs text-gray-500">
                Phòng có người chỉ nhận thêm thành viên cùng lớp
              </p>
            </div><div class="flex rounded-lg bg-white p-1 shadow-sm">
              <button
                data-hotel-tab="all"
                class="hotel-tab rounded-md bg-navy-900 px-3 py-2 text-xs font-bold text-white"
                >Tất cả</button
              ><button
                data-hotel-tab="milla"
                class="hotel-tab rounded-md px-3 py-2 text-xs font-semibold text-gray-600"
                >Milla</button
              ><button
                data-hotel-tab="milla-park"
                class="hotel-tab rounded-md px-3 py-2 text-xs font-semibold text-gray-600"
                >Milla Park</button
              ><button
                data-hotel-tab="dragon-nest"
                class="hotel-tab rounded-md px-3 py-2 text-xs font-semibold text-gray-600"
                >Dragon Nest</button
              >
            </div>
          </div>
          <div id="rooms-container" class="space-y-6"></div>
        </section>
      </div>
    </main>
  </div>

  <div
    id="person-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-navy-900/70 p-4 backdrop-blur-sm"
  >
    <form
      id="person-form"
      class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl"
    >
      <div class="mb-5 flex items-center justify-between">
        <h2
          id="person-modal-title"
          class="font-serif text-xl font-bold text-navy-900"
        >
          Thêm thành viên
        </h2><button
          type="button"
          data-close-modal
          class="text-gray-400 hover:text-navy-900"
          ><i data-lucide="x" class="h-5 w-5"></i></button
        >
      </div>
      <input id="person-id" type="hidden" /><div class="space-y-4">
        <div>
          <label class="mb-1 block text-sm font-medium">Họ và tên *</label
          ><input
            id="person-name"
            required
            class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm outline-none focus:border-gold-500"
          />
        </div><div>
          <label class="mb-1 block text-sm font-medium">Lớp *</label><select
            id="person-class"
            required
            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm"
            ><option value="96Q1">96Q1</option><option value="96Q2">96Q2</option
            ></select
          >
        </div><label
          class="flex cursor-pointer items-center gap-3 rounded-lg bg-gray-50 p-3 text-sm"
          ><input id="person-is-female" type="checkbox" class="h-4 w-4" /> Thành viên
          nữ</label
        ><div>
          <label class="mb-1 block text-sm font-medium">Số điện thoại</label
          ><input
            id="person-phone"
            type="tel"
            class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm"
          />
        </div><div>
          <label class="mb-1 block text-sm font-medium">Ghi chú</label><textarea
            id="person-note"
            rows="2"
            class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm"
          ></textarea>
        </div>
      </div>
      <div class="mt-6 grid grid-cols-2 gap-3">
        <button
          type="button"
          data-close-modal
          class="rounded-lg border border-gray-300 py-2.5 text-sm font-semibold text-gray-600"
          >Hủy</button
        ><button
          id="save-person-button"
          type="submit"
          class="rounded-lg bg-navy-900 py-2.5 text-sm font-bold text-white hover:bg-gold-500"
          >Lưu thành viên</button
        >
      </div>
    </form>
  </div>

  <div
    id="password-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-navy-900/70 p-4"
  >
    <form
      id="password-form"
      class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-2xl"
    >
      <h2 class="font-serif text-xl font-bold text-navy-900">Đổi mật khẩu</h2><p
        class="mt-1 text-xs text-gray-500"
      >
        Bạn sẽ cần đăng nhập lại sau khi đổi.
      </p><div id="password-message" class="mt-3 hidden rounded-lg p-3 text-xs">
      </div><div class="mt-4 space-y-3">
        <input
          id="current-password"
          type="password"
          required
          placeholder="Mật khẩu hiện tại"
          class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm"
        /><input
          id="new-password"
          type="password"
          required
          minlength="10"
          placeholder="Mật khẩu mới (ít nhất 10 ký tự)"
          class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm"
        /><input
          id="confirm-password"
          type="password"
          required
          minlength="10"
          placeholder="Nhập lại mật khẩu mới"
          class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm"
        />
      </div><div class="mt-5 grid grid-cols-2 gap-3">
        <button
          id="close-password"
          type="button"
          class="rounded-lg border border-gray-300 py-2.5 text-sm">Hủy</button
        ><button
          type="submit"
          class="rounded-lg bg-navy-900 py-2.5 text-sm font-bold text-white"
          >Đổi mật khẩu</button
        >
      </div>
    </form>
  </div>

  <div
    id="attendance-modal"
    class="fixed inset-0 z-[140] hidden items-center justify-center bg-navy-900/70 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="attendance-modal-title"
  >
    <div
      class="w-full max-w-md overflow-hidden rounded-2xl bg-white shadow-2xl"
    >
      <div class="bg-navy-900 px-6 py-5 text-white">
        <div class="flex items-center gap-3">
          <span
            class="flex h-10 w-10 items-center justify-center rounded-full bg-gold-500 text-navy-900"
            ><i data-lucide="user-check" class="h-5 w-5"></i></span
          ><div>
            <h2
              id="attendance-modal-title"
              class="font-serif text-xl font-bold"
            >
              Xác nhận tham gia
            </h2><p class="text-xs text-white/70">
              Cập nhật trạng thái thành viên
            </p>
          </div>
        </div>
      </div>
      <div class="p-6">
        <p id="attendance-modal-message" class="font-semibold text-navy-900">
        </p><p
          id="attendance-modal-note"
          class="mt-3 rounded-lg bg-amber-50 p-3 text-sm leading-6 text-amber-800"
        >
        </p><div class="mt-6 grid grid-cols-2 gap-3">
          <button
            id="attendance-cancel"
            type="button"
            class="rounded-lg border border-gray-300 py-2.5 text-sm font-semibold text-gray-600 hover:bg-gray-50"
            >Hủy</button
          ><button
            id="attendance-confirm"
            type="button"
            class="rounded-lg bg-navy-900 py-2.5 text-sm font-bold text-white hover:bg-gold-500 hover:text-navy-900"
            >Xác nhận</button
          >
        </div>
      </div>
    </div>
  </div>

  <div
    id="toast"
    class="fixed bottom-5 right-5 z-[150] hidden max-w-sm rounded-xl px-4 py-3 text-sm font-medium text-white shadow-xl"
  >
  </div>
</Layout>

<script
  is:inline
  src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"
></script>
<script
  is:inline
  src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"
></script>
<script
  is:inline
  src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"
></script>
<script define:vars={{ loginUrl, homeUrl }}>
  const firebaseConfig = {
    apiKey: "AIzaSyAfKEUC4xTaT-6Wo7fMdUUbmf2xAP2CaNM",
    authDomain: "register-to-participate.firebaseapp.com",
    projectId: "register-to-participate",
    storageBucket: "register-to-participate.firebasestorage.app",
    messagingSenderId: "578991866095",
    appId: "1:578991866095:web:9ce9b6b5e5d13314359b1a",
  };
  if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
  const auth = firebase.auth();
  const db = firebase.firestore();
  const hotelConfigs = [
    {
      id: "milla",
      name: "Milla",
      rooms: [
        { number: "206", bed: "1.6m + 1.2m", extra: "—", capacity: 3 },
        { number: "208", bed: "1.6m + 1.2m", extra: "—", capacity: 3 },
        { number: "306", bed: "1.6m + 1.2m", extra: "—", capacity: 3 },
        { number: "308", bed: "1.6m + 1.2m", extra: "—", capacity: 3 },
        { number: "406", bed: "1 × 1.8m", extra: "—", capacity: 2 },
        { number: "408", bed: "1 × 1.8m", extra: "—", capacity: 2 },
        { number: "506", bed: "1 × 1.8m", extra: "—", capacity: 2 },
        { number: "508", bed: "1.8m + 1.2m", extra: "—", capacity: 3 },
      ],
    },
    {
      id: "milla-park",
      name: "Milla Park",
      rooms: [
        { number: "206", bed: "Chưa cập nhật", extra: "—", capacity: 3 },
        { number: "208", bed: "Chưa cập nhật", extra: "—", capacity: 3 },
      ],
    },
    {
      id: "dragon-nest",
      name: "Dragon Nest",
      rooms: [
        { number: "201", bed: "2 × 1.6m", extra: "—", capacity: 4 },
        { number: "202", bed: "2 × 1.6m", extra: "—", capacity: 4 },
        { number: "303", bed: "2 × 1.6m", extra: "—", capacity: 4 },
        { number: "304", bed: "2 × 1.6m", extra: "+1", capacity: 5 },
        { number: "405", bed: "1 × 2.6m", extra: "+1", capacity: 4 },
        { number: "406", bed: "1 × 2.6m", extra: "+1", capacity: 4 },
        { number: "507", bed: "1 × 1.8m", extra: "+1", capacity: 3 },
        { number: "508", bed: "1 × 1.8m", extra: "+1", capacity: 3 },
      ],
    },
  ];
  let persons = [],
    rooms = {},
    selectedPersonId = "",
    hotelFilter = "all",
    classAttendanceView = "all",
    activeClassFilter = "",
    currentAdmin = null,
    inactivityTimer;
  const roomKey = (hotelId, number) => `${hotelId}-${number}`;
  const esc = (value = "") =>
    String(value).replace(
      /[&<>'"]/g,
      (c) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          "'": "&#39;",
          '"': "&quot;",
        })[c],
    );
  function toast(text, error = false) {
    const el = document.getElementById("toast");
    el.textContent = text;
    el.className = `fixed bottom-5 right-5 z-[150] max-w-sm rounded-xl px-4 py-3 text-sm font-medium text-white shadow-xl ${error ? "bg-red-600" : "bg-green-600"}`;
    clearTimeout(el.timer);
    el.timer = setTimeout(() => el.classList.add("hidden"), 3500);
  }
  function confirmAttendance(person, isAttending) {
    return new Promise((resolve) => {
      const modal = document.getElementById("attendance-modal"),
        message = document.getElementById("attendance-modal-message"),
        note = document.getElementById("attendance-modal-note"),
        confirmButton = document.getElementById("attendance-confirm"),
        cancelButton = document.getElementById("attendance-cancel");
      message.textContent = isAttending
        ? `Xác nhận ${person.fullName} sẽ tham gia?`
        : `Đánh dấu ${person.fullName} là không tham gia?`;
      note.textContent = isAttending
        ? "Thành viên sẽ có thể được xếp phòng và quay bàn Dinner."
        : "Dữ liệu phòng và bàn Dinner đã xếp (nếu có) vẫn được giữ nguyên.";
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      const finish = (value) => {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        confirmButton.onclick = null;
        cancelButton.onclick = null;
        modal.onclick = null;
        document.onkeydown = null;
        resolve(value);
      };
      confirmButton.onclick = () => finish(true);
      cancelButton.onclick = () => finish(false);
      modal.onclick = (event) => {
