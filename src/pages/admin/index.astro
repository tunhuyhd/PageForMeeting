  function roomMode(counts, occupied, femaleCount) {
    if (!occupied) return null;
    if (femaleCount === occupied) return "FEMALE";
    if (femaleCount === 0 && counts["96Q1"] === occupied) return "96Q1";
    if (femaleCount === 0 && counts["96Q2"] === occupied) return "96Q2";
    return "MIXED";
