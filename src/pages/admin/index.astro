  function personNameParts(fullName = "") {
    const normalized = String(fullName)
      .trim()
      .replace(/\s*\([^)]*\)\s*$/, "")
      .replace(/\s+\S*\d\s*$/, "")
      .replace(/\s+/g, " ");
    return normalized ? normalized.split(" ").reverse() : [];
  }
  function comparePersonsByGivenName(first, second) {
    const firstEndsWithNumber = /\d\s*$/.test(String(first.fullName || "")),
      secondEndsWithNumber = /\d\s*$/.test(String(second.fullName || ""));
    if (firstEndsWithNumber !== secondEndsWithNumber)
      return firstEndsWithNumber ? 1 : -1;
    const firstParts = personNameParts(first.fullName),
      secondParts = personNameParts(second.fullName),
      length = Math.max(firstParts.length, secondParts.length);
    for (let index = 0; index < length; index++) {
      const compared = String(firstParts[index] || "").localeCompare(
        String(secondParts[index] || ""),
        "vi",
        { sensitivity: "base" },
      );
      if (compared) return compared;
    }
    return 0;
  }
