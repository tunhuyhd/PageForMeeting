---
import Layout from "../../layouts/Layout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const adminUrl = `${base}/admin/index.html`;
const homeUrl = `${base}/`;
---

<Layout title="Đăng nhập quản trị - 30 Năm Hội Ngộ 96Q">
  <main class="flex min-h-screen items-center justify-center bg-navy-900 px-4 py-12">
    <div class="absolute inset-0 opacity-10 [background-image:radial-gradient(#d4af37_1px,transparent_1px)] [background-size:24px_24px]"></div>
    <div class="relative w-full max-w-md overflow-hidden rounded-3xl bg-white shadow-2xl">
      <div class="bg-gradient-to-br from-navy-900 to-navy-800 px-8 py-7 text-center">
        <img src={`${base}/logo30.png`} alt="96Q" class="mx-auto h-20 w-auto" />
        <h1 class="mt-3 font-serif text-2xl font-bold text-white">Khu vực quản trị</h1>
        <p class="mt-1 text-xs text-gray-300">Quản lý thành viên và phân phòng khách sạn</p>
      </div>
      <div class="p-7 sm:p-8">
        <div id="login-message" class="mb-4 hidden rounded-xl border px-4 py-3 text-sm" role="alert"></div>
        <form id="admin-login-form" class="space-y-5">
          <div><label for="admin-email" class="mb-1.5 block text-sm font-semibold text-gray-700">Email quản trị</label><input id="admin-email" type="email" required autocomplete="username" placeholder="admin@example.com" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm outline-none focus:border-gold-500 focus:ring-2 focus:ring-gold-400/30" /></div>
          <div><div class="mb-1.5 flex justify-between"><label for="admin-password" class="text-sm font-semibold text-gray-700">Mật khẩu</label><button id="forgot-password" type="button" class="text-xs font-semibold text-gold-600 hover:text-gold-700">Quên mật khẩu?</button></div><div class="relative"><input id="admin-password" type="password" required autocomplete="current-password" class="w-full rounded-xl border border-gray-300 px-4 py-3 pr-11 text-sm outline-none focus:border-gold-500 focus:ring-2 focus:ring-gold-400/30" /><button id="toggle-password" type="button" class="absolute inset-y-0 right-0 px-3 text-gray-400 hover:text-navy-900" aria-label="Hiện mật khẩu"><i data-lucide="eye" class="h-5 w-5"></i></button></div></div>
          <button id="login-button" type="submit" class="flex w-full items-center justify-center gap-2 rounded-xl bg-navy-900 py-3.5 font-bold text-white transition hover:bg-gold-500"><i data-lucide="log-in" class="h-5 w-5"></i> Đăng nhập</button>
        </form>
        <a href={homeUrl} class="mt-6 flex items-center justify-center gap-1 text-xs text-gray-400 hover:text-navy-900"><i data-lucide="arrow-left" class="h-3.5 w-3.5"></i> Về trang chính</a>
      </div>
    </div>
  </main>
</Layout>

<script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>
<script define:vars={{ adminUrl }}>
  const firebaseConfig = { apiKey: "AIzaSyAfKEUC4xTaT-6Wo7fMdUUbmf2xAP2CaNM", authDomain: "register-to-participate.firebaseapp.com", projectId: "register-to-participate", storageBucket: "register-to-participate.firebasestorage.app", messagingSenderId: "578991866095", appId: "1:578991866095:web:9ce9b6b5e5d13314359b1a" };
  if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
  const auth = firebase.auth();
  const db = firebase.firestore();
  const form = document.getElementById("admin-login-form"); const button = document.getElementById("login-button"); const message = document.getElementById("login-message");
  function showMessage(text, error = true) { message.textContent = text; message.className = `mb-4 rounded-xl border px-4 py-3 text-sm ${error ? "border-red-200 bg-red-50 text-red-700" : "border-green-200 bg-green-50 text-green-700"}`; }
  document.getElementById("toggle-password").addEventListener("click", () => { const input = document.getElementById("admin-password"); input.type = input.type === "password" ? "text" : "password"; });
  document.getElementById("forgot-password").addEventListener("click", async () => { const email = document.getElementById("admin-email").value.trim(); if (!email) { showMessage("Nhập email quản trị trước khi yêu cầu đặt lại mật khẩu."); return; } try { await auth.sendPasswordResetEmail(email); showMessage("Nếu email hợp lệ, liên kết đặt lại mật khẩu đã được gửi.", false); } catch { showMessage("Không thể gửi email lúc này. Vui lòng thử lại sau."); } });
  form.addEventListener("submit", async (event) => { event.preventDefault(); button.disabled = true; button.innerHTML = '<i data-lucide="loader-2" class="h-5 w-5 animate-spin"></i> Đang xác thực...'; if (window.lucide) window.lucide.createIcons(); try { await auth.setPersistence(firebase.auth.Auth.Persistence.SESSION); const credential = await auth.signInWithEmailAndPassword(document.getElementById("admin-email").value.trim(), document.getElementById("admin-password").value); const adminDocument = await db.collection("admins").doc(credential.user.uid).get(); if (!adminDocument.exists || adminDocument.data().active !== true) { await auth.signOut(); throw new Error("Tài khoản này không có quyền quản trị."); } window.location.replace(adminUrl); } catch (error) { showMessage(error.message === "Tài khoản này không có quyền quản trị." ? error.message : "Email hoặc mật khẩu không chính xác."); button.disabled = false; button.innerHTML = '<i data-lucide="log-in" class="h-5 w-5"></i> Đăng nhập'; if (window.lucide) window.lucide.createIcons(); } });
</script>
