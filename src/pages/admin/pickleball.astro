---
import Layout from "../../layouts/Layout.astro";
const base=import.meta.env.BASE_URL.replace(/\/$/,"");
const loginUrl=`${base}/admin/login/index.html`,homeUrl=`${base}/`,roomUrl=`${base}/admin/index.html`,dinnerUrl=`${base}/admin/dinner/index.html`;
---
<Layout title="Quản lý giải Pickleball - 96Q">
  <div id="auth-loading" class="fixed inset-0 z-[200] flex items-center justify-center bg-navy-900 text-white"><i data-lucide="loader-2" class="h-9 w-9 animate-spin text-gold-400"></i></div>
  <div id="admin-app" class="hidden min-h-screen bg-gray-100">
    <header class="sticky top-0 z-40 bg-navy-900 text-white shadow-lg"><div class="mx-auto flex max-w-[1500px] items-center justify-between px-4 py-3 sm:px-6"><div class="flex items-center gap-3"><img src={`${base}/logo30.png`} class="h-11" alt="96Q"/><div><h1 class="font-serif font-bold">Quản lý giải Pickleball</h1><p class="text-[10px] uppercase text-gold-400">30 năm hội ngộ 96Q</p></div></div><div class="flex items-center gap-2"><span id="admin-email" class="hidden text-xs text-gray-300 lg:block"></span><button id="logout" class="rounded-lg bg-white/10 px-3 py-2 text-xs font-bold"><i data-lucide="log-out" class="inline h-4 w-4"></i> Đăng xuất</button></div></div></header>
    <main class="mx-auto max-w-[1500px] p-4 sm:p-6">
      <nav class="mb-5 grid grid-cols-3 rounded-xl bg-white p-1 shadow-sm sm:ml-auto sm:w-fit"><a href={roomUrl} class="rounded-lg px-4 py-2.5 text-center text-xs font-bold text-gray-600">Xếp phòng</a><a href={dinnerUrl} class="rounded-lg px-4 py-2.5 text-center text-xs font-bold text-gray-600">Bàn Dinner</a><span class="rounded-lg bg-navy-900 px-4 py-2.5 text-center text-xs font-bold text-white">Pickleball</span></nav>
      <div class="mb-5 grid grid-cols-2 gap-3 md:grid-cols-4"><div class="rounded-xl bg-white p-4 shadow-sm"><small class="text-gray-500">Được chọn tham gia</small><b id="stat-participants" class="mt-1 block text-2xl text-navy-900">0</b></div><div class="rounded-xl bg-white p-4 shadow-sm"><small class="text-gray-500">Chưa ghép cặp</small><b id="stat-free" class="mt-1 block text-2xl text-orange-500">0</b></div><div class="rounded-xl bg-white p-4 shadow-sm"><small class="text-gray-500">Cặp bảng A</small><b id="stat-a" class="mt-1 block text-2xl text-blue-600">0</b></div><div class="rounded-xl bg-white p-4 shadow-sm"><small class="text-gray-500">Cặp bảng B</small><b id="stat-b" class="mt-1 block text-2xl text-purple-600">0</b></div></div>
      <div class="grid gap-5 xl:grid-cols-[430px_1fr] xl:items-start">
        <section class="rounded-2xl bg-white shadow-sm xl:sticky xl:top-24"><div class="border-b p-4"><h2 class="font-bold text-navy-900">Danh sách tham gia Pickleball</h2><p class="text-xs text-gray-500">Tích chọn các thành viên đăng ký thi đấu</p><div class="mt-3 flex gap-2"><input id="person-search" type="search" placeholder="Tìm theo tên, lớp..." class="min-w-0 flex-1 rounded-lg border px-3 py-2 text-sm"/><select id="person-class" class="rounded-lg border px-2 text-xs"><option value="all">Tất cả</option><option value="96Q1">96Q1</option><option value="96Q2">96Q2</option><option value="selected">Đã chọn</option><option value="free">Chưa ghép</option></select></div></div><div id="person-list" class="max-h-[calc(100vh-280px)] overflow-y-auto p-3"></div></section>
        <div class="space-y-5">
          <section class="rounded-2xl bg-white p-5 shadow-sm sm:p-6"><div class="flex items-center gap-3"><span class="flex h-11 w-11 items-center justify-center rounded-full bg-gold-400"><i data-lucide="shuffle" class="h-5 w-5"></i></span><div><h2 class="font-serif text-2xl font-bold text-navy-900">Ghép cặp thi đấu</h2><p class="text-xs text-gray-500">Chọn bảng, người thứ nhất rồi chọn cách ghép</p></div></div><div class="mt-5 grid gap-3 md:grid-cols-2"><label class="rounded-xl border bg-gray-50 p-3 text-sm font-semibold"><span class="block text-xs font-bold text-gold-600">BƯỚC 1</span>Chọn bảng<select id="team-group" class="mt-2 w-full rounded-lg border bg-white px-4 py-3"><option value="A">Bảng A</option><option value="B">Bảng B</option></select></label><label class="rounded-xl border bg-gray-50 p-3 text-sm font-semibold"><span class="block text-xs font-bold text-gold-600">BƯỚC 2</span>Chọn người thứ nhất<select id="player-one" class="mt-2 w-full rounded-lg border bg-white px-4 py-3"><option value="">-- Chọn người chưa có cặp --</option></select></label></div><div id="partner-area" class="mt-5 hidden"><div class="mb-3"><span class="text-xs font-bold text-gold-600">BƯỚC 3</span><h3 class="font-bold text-navy-900">Chọn cách ghép cặp</h3></div><div class="grid gap-5 lg:grid-cols-[minmax(250px,0.8fr)_minmax(350px,1.2fr)]"><div class="rounded-xl border bg-gray-50 p-4"><h4 class="font-bold text-navy-900">Ghép thủ công</h4><p class="mt-1 text-xs text-gray-500">Được phép cùng lớp hoặc khác lớp.</p><select id="player-two" class="mt-4 w-full rounded-xl border bg-white px-4 py-3"><option value="">-- Chọn người đánh cặp --</option></select><button id="pair-manual" class="mt-4 w-full rounded-xl bg-navy-900 px-4 py-3 text-sm font-bold text-white disabled:opacity-40"><i data-lucide="user-plus" class="mr-1 inline h-4 w-4"></i> Ghép cặp đã chọn</button></div><div class="rounded-xl border border-gold-300 bg-gold-50 p-4"><div class="text-center"><h4 class="font-bold text-navy-900">Vòng quay ngẫu nhiên khác lớp</h4><p id="wheel-candidate-count" class="mt-1 text-xs text-gray-600"></p></div><div class="relative mx-auto mt-3 aspect-square w-full max-w-[430px]"><div class="absolute left-1/2 top-0 z-20 h-10 w-10 -translate-x-1/2 bg-navy-900 [clip-path:polygon(0_0,100%_0,50%_100%)]"></div><div id="pickleball-wheel" class="absolute inset-3 overflow-hidden rounded-full border-[8px] border-white bg-gold-400 shadow-xl"></div><button id="pair-random" class="absolute left-1/2 top-1/2 z-30 flex h-24 w-24 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-[6px] border-white bg-navy-900 text-sm font-extrabold text-gold-400 shadow-lg disabled:bg-gray-400 disabled:text-gray-200">QUAY</button></div></div></div></div><div id="random-result" class="mt-5 hidden rounded-xl border-2 border-gold-400 bg-gold-50 p-4 text-center"></div></section>
          <div class="grid gap-5 lg:grid-cols-2"><section class="rounded-2xl border-t-4 border-blue-500 bg-white p-4 shadow-sm"><h2 class="font-serif text-xl font-bold text-blue-800">Bảng A</h2><div id="teams-a" class="mt-3 space-y-2"></div></section><section class="rounded-2xl border-t-4 border-purple-500 bg-white p-4 shadow-sm"><h2 class="font-serif text-xl font-bold text-purple-800">Bảng B</h2><div id="teams-b" class="mt-3 space-y-2"></div></section></div>
          <div class="flex justify-end"><button id="open-awards" type="button" class="flex w-full items-center justify-center gap-2 rounded-xl bg-gold-400 px-5 py-3 text-sm font-extrabold text-navy-900 shadow-sm transition hover:bg-gold-500 sm:w-fit"><i data-lucide="trophy" class="h-5 w-5"></i> Xếp hạng giải thưởng</button></div>
          <section id="awards-modal" class="fixed inset-0 z-[180] hidden items-center justify-center bg-navy-900/70 p-4 backdrop-blur-sm"><div role="dialog" aria-modal="true" aria-labelledby="awards-title" class="max-h-[90vh] w-full max-w-5xl overflow-y-auto rounded-2xl bg-white p-5 shadow-2xl sm:p-7"><div class="flex items-start justify-between gap-4"><div class="flex items-center gap-3"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold-400"><i data-lucide="trophy" class="h-5 w-5 text-navy-900"></i></span><div><h2 id="awards-title" class="font-serif text-2xl font-bold text-navy-900">Xếp hạng giải thưởng</h2><p class="text-xs text-gray-500">Chọn trong các cặp đã được ghép; một cặp chỉ nhận một thứ hạng.</p></div></div><button id="close-awards" type="button" aria-label="Đóng" class="rounded-full bg-gray-100 p-2 text-gray-500 hover:bg-gray-200"><i data-lucide="x" class="h-5 w-5"></i></button></div><div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-4"><label class="rounded-xl border-2 border-yellow-400 bg-yellow-50 p-4 text-sm font-bold text-yellow-800"><span class="mb-2 block">🏆 Hạng Nhất</span><select id="award-first" class="w-full rounded-lg border bg-white px-3 py-3 text-sm font-medium text-navy-900"><option value="">-- Chưa chọn --</option></select></label><label class="rounded-xl border-2 border-slate-300 bg-slate-50 p-4 text-sm font-bold text-slate-700"><span class="mb-2 block">🥈 Hạng Nhì</span><select id="award-second" class="w-full rounded-lg border bg-white px-3 py-3 text-sm font-medium text-navy-900"><option value="">-- Chưa chọn --</option></select></label><label class="rounded-xl border-2 border-amber-600 bg-orange-50 p-4 text-sm font-bold text-amber-800"><span class="mb-2 block">🥉 Hạng Ba</span><select id="award-third-one" class="w-full rounded-lg border bg-white px-3 py-3 text-sm font-medium text-navy-900"><option value="">-- Chưa chọn --</option></select></label><label class="rounded-xl border-2 border-amber-600 bg-orange-50 p-4 text-sm font-bold text-amber-800"><span class="mb-2 block">🥉 Hạng Ba</span><select id="award-third-two" class="w-full rounded-lg border bg-white px-3 py-3 text-sm font-medium text-navy-900"><option value="">-- Chưa chọn --</option></select></label></div><div class="mt-6 flex flex-col-reverse gap-3 border-t pt-5 sm:flex-row sm:justify-end"><button id="cancel-awards" type="button" class="rounded-xl border px-5 py-3 text-sm font-bold text-gray-600 hover:bg-gray-50">Hủy</button><button id="save-awards" type="button" class="rounded-xl bg-navy-900 px-6 py-3 text-sm font-bold text-white hover:bg-navy-800"><i data-lucide="save" class="mr-1 inline h-4 w-4"></i> Lưu xếp hạng</button></div></div></section>
        </div>
      </div>
    </main>
  </div><div id="toast" class="fixed bottom-5 right-5 z-[150] hidden max-w-sm rounded-xl px-4 py-3 text-sm font-medium text-white shadow-xl"></div>
</Layout>
<script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script><script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script><script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>
<script define:vars={{loginUrl,homeUrl}}>
const firebaseConfig={apiKey:"AIzaSyAfKEUC4xTaT-6Wo7fMdUUbmf2xAP2CaNM",authDomain:"register-to-participate.firebaseapp.com",projectId:"register-to-participate",storageBucket:"register-to-participate.firebasestorage.app",messagingSenderId:"578991866095",appId:"1:578991866095:web:9ce9b6b5e5d13314359b1a"};if(!firebase.apps.length)firebase.initializeApp(firebaseConfig);const auth=firebase.auth(),db=firebase.firestore(),configRef=db.collection("pickleball").doc("config");let persons=[],config={participantIds:[],teams:[]},admin,randomPool=[],wheelRotation=0,randomSpinning=false;const esc=(v="")=>String(v).replace(/[&<>'"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;",'"':"&quot;"}[c]));function toast(text,error=false){const e=document.getElementById("toast");e.textContent=text;e.className=`fixed bottom-5 right-5 z-[150] max-w-sm rounded-xl px-4 py-3 text-sm font-medium text-white shadow-xl ${error?"bg-red-600":"bg-green-600"}`;clearTimeout(e.timer);e.timer=setTimeout(()=>e.classList.add("hidden"),3000)}
auth.onAuthStateChanged(async user=>{if(!user){location.replace(loginUrl);return}const a=await db.collection("admins").doc(user.uid).get();if(!a.exists||a.data().active!==true){await auth.signOut();location.replace(homeUrl);return}admin=user;document.getElementById("admin-email").textContent=user.email;document.getElementById("auth-loading").classList.add("hidden");document.getElementById("admin-app").classList.remove("hidden");db.collection("persons").orderBy("fullName").onSnapshot(s=>{persons=s.docs.map(d=>({id:d.id,...d.data()}));render()});configRef.onSnapshot(d=>{config=d.exists?d.data():{participantIds:[],teams:[]};config.participantIds=config.participantIds||[];config.teams=config.teams||[];render()})});
const pairedIds=()=>new Set(config.teams.flatMap(t=>[t.playerOneId,t.playerTwoId]));const person=id=>persons.find(p=>p.id===id);async function save(){await configRef.set({...config,updatedAt:firebase.firestore.FieldValue.serverTimestamp(),updatedBy:admin.uid},{merge:false})}function render(){const paired=pairedIds(),q=document.getElementById("person-search").value.toLowerCase(),filter=document.getElementById("person-class").value,list=persons.filter(p=>(!q||`${p.fullName} ${p.className}`.toLowerCase().includes(q))&&(filter==="all"||p.className===filter||(filter==="selected"&&config.participantIds.includes(p.id))||(filter==="free"&&config.participantIds.includes(p.id)&&!paired.has(p.id))));document.getElementById("person-list").innerHTML=list.map(p=>{const selected=config.participantIds.includes(p.id),used=paired.has(p.id);return `<label class="mb-2 flex items-center gap-3 rounded-xl border p-3 ${selected?"border-green-200 bg-green-50":"border-gray-200"}"><input data-participant="${p.id}" type="checkbox" ${selected?"checked":""} ${used?"disabled":""} class="h-5 w-5 accent-green-600"/><span class="min-w-0 flex-1"><b class="block truncate text-sm text-navy-900">${esc(p.fullName)}</b><small class="font-bold ${p.className==="96Q1"?"text-blue-600":"text-purple-600"}">${p.className}</small>${used?'<small class="ml-2 text-green-700">Đã ghép cặp</small>':""}</span></label>`}).join("")||'<p class="py-8 text-center text-sm text-gray-400">Không có thành viên phù hợp</p>';document.querySelectorAll("[data-participant]").forEach(x=>x.onchange=async()=>{if(x.checked)config.participantIds=[...new Set([...config.participantIds,x.dataset.participant])];else config.participantIds=config.participantIds.filter(id=>id!==x.dataset.participant);await save()});const free=persons.filter(p=>config.participantIds.includes(p.id)&&!paired.has(p.id));document.getElementById("player-one").innerHTML='<option value="">-- Chọn người chưa có cặp --</option>'+free.map(p=>`<option value="${p.id}">${esc(p.fullName)} (${p.className})</option>`).join("");document.getElementById("stat-participants").textContent=config.participantIds.length;document.getElementById("stat-free").textContent=free.length;document.getElementById("stat-a").textContent=config.teams.filter(t=>t.group==="A").length;document.getElementById("stat-b").textContent=config.teams.filter(t=>t.group==="B").length;renderTeams("A");renderTeams("B");if(window.lucide)window.lucide.createIcons()}
function renderTeams(group){const el=document.getElementById(`teams-${group.toLowerCase()}`),teams=config.teams.filter(t=>t.group===group);el.innerHTML=teams.length?teams.map((t,i)=>{const a=person(t.playerOneId),b=person(t.playerTwoId);return `<div class="rounded-xl border bg-gray-50 p-3"><div class="flex justify-between"><b class="text-sm text-navy-900">Cặp ${i+1}</b><button data-remove-team="${t.id}" class="text-red-500"><i data-lucide="x" class="h-4 w-4"></i></button></div><p class="mt-2 text-sm"><b>${esc(a?.fullName||"---")}</b> · ${a?.className||""}</p><p class="mt-1 text-sm"><b>${esc(b?.fullName||"---")}</b> · ${b?.className||""}</p></div>`}).join(""):'<p class="py-8 text-center text-sm italic text-gray-400">Chưa có cặp thi đấu</p>';el.querySelectorAll("[data-remove-team]").forEach(b=>b.onclick=async()=>{config.teams=config.teams.filter(t=>t.id!==b.dataset.removeTeam);await save();toast("Đã gỡ cặp thi đấu.")})}
function renderRandomWheel(pool){randomPool=pool;const wheel=document.getElementById("pickleball-wheel"),count=document.getElementById("wheel-candidate-count"),button=document.getElementById("pair-random");count.textContent=pool.length?`${pool.length} thành viên lớp đối diện chưa có cặp`:"Không còn thành viên lớp đối diện phù hợp";button.disabled=!pool.length||randomSpinning;if(!pool.length){wheel.style.background="#d1d5db";wheel.innerHTML='<span class="absolute inset-0 flex items-center justify-center px-16 text-center text-xs font-semibold text-gray-500">Không có ứng viên</span>';return}const step=360/pool.length,colors=["#d4af37","#ef8354","#6aa7a1","#5b7cba","#9b72cf","#d96f91"],segments=pool.map((_,i)=>`${colors[i%colors.length]} ${i*step}deg ${(i+1)*step}deg`).join(",");wheel.style.background=`conic-gradient(from -${step/2}deg,${segments})`;const font=pool.length>24?7:pool.length>14?8:10;wheel.innerHTML=pool.map((p,i)=>{const angle=i*step,x=50+Math.sin(angle*Math.PI/180)*36,y=50-Math.cos(angle*Math.PI/180)*36;return `<span title="${esc(p.fullName)}" style="position:absolute;left:${x}%;top:${y}%;width:${pool.length>20?22:30}%;transform:translate(-50%,-50%);font-size:${font}px;line-height:1.05;text-align:center;font-weight:800;color:white;text-shadow:0 1px 3px #000;pointer-events:none">${esc(p.fullName)}</span>`}).join("")}
document.getElementById("player-one").onchange=e=>{const p=person(e.target.value),area=document.getElementById("partner-area"),paired=pairedIds();area.classList.toggle("hidden",!p);document.getElementById("random-result").classList.add("hidden");if(!p){randomPool=[];return}const candidates=persons.filter(x=>config.participantIds.includes(x.id)&&!paired.has(x.id)&&x.id!==p.id),opposite=candidates.filter(x=>x.className!==p.className);document.getElementById("player-two").innerHTML='<option value="">-- Chọn người đánh cặp --</option>'+candidates.map(x=>`<option value="${x.id}">${esc(x.fullName)} (${x.className})</option>`).join("");document.getElementById("pair-manual").disabled=true;renderRandomWheel(opposite)};
async function createPair(twoId,random=false){const one=person(document.getElementById("player-one").value),two=person(twoId);if(!one||!two)return toast("Hãy chọn đủ hai thành viên.",true);const group=document.getElementById("team-group").value;config.teams.push({id:`team-${Date.now()}`,group,playerOneId:one.id,playerTwoId:two.id});await save();document.getElementById("player-one").value="";document.getElementById("partner-area").classList.add("hidden");if(random){const box=document.getElementById("random-result");box.innerHTML=`<b class="text-navy-900">Kết quả ghép ngẫu nhiên vào bảng ${group}</b><p class="mt-2">${esc(one.fullName)} (${one.className})</p><p class="font-bold text-gold-600">&</p><p>${esc(two.fullName)} (${two.className})</p>`;box.classList.remove("hidden")}toast(`Đã thêm cặp vào bảng ${group}.`)}
document.getElementById("player-two").onchange=e=>document.getElementById("pair-manual").disabled=!e.target.value;document.getElementById("pair-manual").onclick=()=>createPair(document.getElementById("player-two").value);document.getElementById("pair-random").onclick=()=>{if(randomSpinning||!randomPool.length)return;const chosenIndex=Math.floor(Math.random()*randomPool.length),step=360/randomPool.length,normal=((wheelRotation%360)+360)%360,target=(360-chosenIndex*step)%360,wheel=document.getElementById("pickleball-wheel"),button=document.getElementById("pair-random");randomSpinning=true;button.disabled=true;button.textContent="ĐANG QUAY";wheelRotation+=1800+(target-normal+360)%360;wheel.style.transition="transform 4.5s cubic-bezier(.12,.72,.08,1)";wheel.style.transform=`rotate(${wheelRotation}deg)`;setTimeout(async()=>{randomSpinning=false;button.textContent="QUAY";await createPair(randomPool[chosenIndex].id,true)},4600)};document.getElementById("person-search").oninput=render;document.getElementById("person-class").onchange=render;document.getElementById("logout").onclick=async()=>{await auth.signOut();location.replace(loginUrl)};
const originalPickleballRender=render;
let pickleballClassAttendanceView="all",activePickleballClassFilter="";
const pickleballFilterRow=document.getElementById("person-class").parentElement,pickleballClassSummary=document.createElement("div");
pickleballClassSummary.id="pickleball-class-summary";pickleballClassSummary.className="mt-3 hidden grid-cols-3 gap-2 rounded-xl border p-2.5 text-center";pickleballClassSummary.innerHTML='<button type="button" data-pickleball-class-attendance="all" class="rounded-lg px-1 py-1.5 transition"><span class="block text-[10px] font-semibold uppercase text-gray-500">Tổng số</span><b id="pickleball-class-total" class="text-lg text-navy-900">0</b></button><button type="button" data-pickleball-class-attendance="attending" class="rounded-lg px-1 py-1.5 transition"><span class="block text-[10px] font-semibold uppercase text-green-700">Tham gia</span><b id="pickleball-class-attending" class="text-lg text-green-600">0</b></button><button type="button" data-pickleball-class-attendance="not-attending" class="rounded-lg px-1 py-1.5 transition"><span class="block text-[10px] font-semibold uppercase text-gray-500">Không tham gia</span><b id="pickleball-class-not-attending" class="text-lg text-gray-500">0</b></button>';pickleballFilterRow.insertAdjacentElement("afterend",pickleballClassSummary);
function pickleballNameParts(fullName=""){const normalized=String(fullName).trim().replace(/\s*\([^)]*\)\s*$/,"").replace(/\s+\S*\d\s*$/,"").replace(/\s+/g," ");return normalized?normalized.split(" ").reverse():[]}
function comparePickleballPersons(first,second){const firstEnds=/\d\s*$/.test(String(first.fullName||"")),secondEnds=/\d\s*$/.test(String(second.fullName||""));if(firstEnds!==secondEnds)return firstEnds?1:-1;const firstParts=pickleballNameParts(first.fullName),secondParts=pickleballNameParts(second.fullName),length=Math.max(firstParts.length,secondParts.length);for(let index=0;index<length;index++){const compared=String(firstParts[index]||"").localeCompare(String(secondParts[index]||""),"vi",{sensitivity:"base"});if(compared)return compared}return 0}
