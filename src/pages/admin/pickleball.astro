<script is:inline type="application/json">
const renderPickleballPage = render;

function ensureAwards() {
  if (!config.awards || typeof config.awards !== "object") {
    config.awards = { first: null, second: null, third: [] };
  }
  config.awards.first = config.awards.first || null;
  config.awards.second = config.awards.second || null;
  config.awards.third = Array.isArray(config.awards.third)
    ? config.awards.third.slice(0, 2)
    : [];
}

const savePickleballConfig = save;
save = async function () {
  ensureAwards();
  const teamIds = new Set(config.teams.map((team) => team.id));
  config.awards.first = teamIds.has(config.awards.first) ? config.awards.first : null;
  config.awards.second = teamIds.has(config.awards.second) ? config.awards.second : null;
  config.awards.third = config.awards.third.filter((id) => teamIds.has(id));
  await savePickleballConfig();
};

function awardTeamLabel(team) {
  const first = person(team.playerOneId);
  const second = person(team.playerTwoId);
  return `Bảng ${team.group} · ${first?.fullName || "---"} (${first?.className || "---"}) & ${second?.fullName || "---"} (${second?.className || "---"})`;
}

function renderAwards() {
  ensureAwards();
  const fields = [
    ["award-first", config.awards.first],
    ["award-second", config.awards.second],
    ["award-third-one", config.awards.third[0]],
    ["award-third-two", config.awards.third[1]],
  ];
  const options = config.teams
    .map((team) => `<option value="${esc(team.id)}">${esc(awardTeamLabel(team))}</option>`)
    .join("");

  fields.forEach(([id, value]) => {
    const select = document.getElementById(id);
    if (!select) return;
    select.innerHTML = '<option value="">-- Chưa chọn --</option>' + options;
    select.value = config.teams.some((team) => team.id === value) ? value : "";
  });
}

render = function () {
  ensureAwards();
  renderPickleballPage();
  renderAwards();
};

document.querySelectorAll("[data-award-select]").forEach((select) => {
  select.addEventListener("change", async () => {
    const first = document.getElementById("award-first").value;
    const second = document.getElementById("award-second").value;
    const thirdOne = document.getElementById("award-third-one").value;
    const thirdTwo = document.getElementById("award-third-two").value;
    const selected = [first, second, thirdOne, thirdTwo].filter(Boolean);

    if (new Set(selected).size !== selected.length) {
      toast("Một cặp không thể nhận nhiều thứ hạng.", true);
      renderAwards();
      return;
    }

    config.awards = {
      first: first || null,
      second: second || null,
      third: [thirdOne, thirdTwo].filter(Boolean),
    };
    try {
      await save();
      toast("Đã cập nhật xếp hạng giải thưởng.");
    } catch {
      toast("Không thể lưu xếp hạng. Vui lòng thử lại.", true);
      renderAwards();
    }
  });
});

const awardsPanel = document.getElementById("award-first")?.closest("section");
if (awardsPanel) {
  const awardsButton = document.createElement("button");
  awardsButton.type = "button";
  awardsButton.className = "flex w-full items-center justify-center gap-2 rounded-xl bg-gold-400 px-5 py-3 text-sm font-extrabold text-navy-900 shadow-sm transition hover:bg-gold-500 sm:ml-auto sm:w-fit";
  awardsButton.innerHTML = '<i data-lucide="trophy" class="h-5 w-5"></i><span>Xếp hạng giải thưởng</span>';
  awardsPanel.parentElement.insertBefore(awardsButton, awardsPanel);

  awardsPanel.className = "fixed inset-0 z-[180] hidden items-center justify-center bg-navy-900/70 p-4 backdrop-blur-sm";
  const dialogContent = document.createElement("div");
  dialogContent.className = "max-h-[90vh] w-full max-w-5xl overflow-y-auto rounded-2xl bg-white p-5 shadow-2xl sm:p-7";
  while (awardsPanel.firstChild) dialogContent.appendChild(awardsPanel.firstChild);
  dialogContent.setAttribute("role", "dialog");
  dialogContent.setAttribute("aria-modal", "true");
  dialogContent.setAttribute("aria-label", "Xếp hạng giải thưởng Pickleball");

  const actions = document.createElement("div");
  actions.className = "mt-6 flex flex-col-reverse gap-3 border-t pt-5 sm:flex-row sm:justify-end";
  actions.innerHTML = '<button id="cancel-awards" type="button" class="rounded-xl border px-5 py-3 text-sm font-bold text-gray-600 hover:bg-gray-50">Hủy</button><button id="save-awards" type="button" class="rounded-xl bg-navy-900 px-6 py-3 text-sm font-bold text-white hover:bg-navy-800"><i data-lucide="save" class="mr-1 inline h-4 w-4"></i> Lưu xếp hạng</button>';
  dialogContent.appendChild(actions);
  awardsPanel.appendChild(dialogContent);

  const closeAwards = () => {
    awardsPanel.classList.add("hidden");
    awardsPanel.classList.remove("flex");
    document.body.style.overflow = "";
    renderAwards();
  };
  const openAwards = () => {
    renderAwards();
    awardsPanel.classList.remove("hidden");
    awardsPanel.classList.add("flex");
    document.body.style.overflow = "hidden";
    document.getElementById("award-first")?.focus();
  };

  document.querySelectorAll("[data-award-select]").forEach((select) => {
    select.addEventListener("change", (event) => event.stopImmediatePropagation(), true);
  });

  awardsButton.addEventListener("click", openAwards);
  document.getElementById("cancel-awards").addEventListener("click", closeAwards);
  awardsPanel.addEventListener("click", (event) => {
    if (event.target === awardsPanel) closeAwards();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !awardsPanel.classList.contains("hidden")) closeAwards();
  });

  document.getElementById("save-awards").addEventListener("click", async () => {
    const first = document.getElementById("award-first").value;
    const second = document.getElementById("award-second").value;
    const thirdOne = document.getElementById("award-third-one").value;
    const thirdTwo = document.getElementById("award-third-two").value;
    const selected = [first, second, thirdOne, thirdTwo].filter(Boolean);
    if (new Set(selected).size !== selected.length) {
      toast("Một cặp không thể nhận nhiều thứ hạng.", true);
      return;
    }

    const saveButton = document.getElementById("save-awards");
    saveButton.disabled = true;
    saveButton.classList.add("opacity-60");
    config.awards = {
      first: first || null,
      second: second || null,
      third: [thirdOne, thirdTwo].filter(Boolean),
    };
    try {
      await save();
      closeAwards();
      toast("Đã lưu xếp hạng giải thưởng.");
    } catch {
      toast("Không thể lưu xếp hạng. Vui lòng thử lại.", true);
    } finally {
      saveButton.disabled = false;
      saveButton.classList.remove("opacity-60");
    }
  });

  if (window.lucide) window.lucide.createIcons();
}
</script>
