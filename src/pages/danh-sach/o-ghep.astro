---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Danh Sách Đăng Ký Ở Ghép - 30 Năm Hội Ngộ 96Q">
	<Header />

	<main class="pt-24 pb-20 bg-ivory min-h-screen">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<!-- Header Title -->
			<div class="text-center mb-5">
				<h1
					class="text-2xl sm:text-3xl font-serif font-bold text-navy-900 mt-2 uppercase tracking-tight"
				>
					DANH SÁCH ĐĂNG KÝ Ở GHÉP
				</h1>
				<p class="text-xs text-gray-500 mt-1">
					Hội ngộ 30 năm Kỷ niệm 96Q1 & 96Q2
				</p>
			</div>

			<!-- Nav links -->
			<div class="flex justify-center gap-3 mb-5">
				<a
					href={import.meta.env.BASE_URL + "danh-sach/"}
					class="px-4 py-2 text-sm font-medium text-gray-500 hover:text-navy-900 border border-gray-200 rounded-lg hover:border-navy-900 transition-all flex items-center gap-2"
				>
					<svg
						class="w-4 h-4"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
						><path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M15 19l-7-7 7-7"></path></svg
					>
					Quay lại
				</a>
				<a
					href={import.meta.env.BASE_URL + "danh-sach/ban-an/"}
					class="px-4 py-2 text-sm font-medium text-gray-500 hover:text-navy-900 border border-gray-200 rounded-lg hover:border-navy-900 transition-all flex items-center gap-2"
				>
					<svg
						class="w-4 h-4"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
						><path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
						></path></svg
					>
					Xem Bàn Ăn
				</a>
			</div>

			<!-- Header Card Banner -->
			<div
				class="bg-navy-900 text-white p-4 rounded-xl shadow-sm flex justify-between items-center mb-4"
			>
				<div>
					<h2
						class="font-serif font-bold text-sm sm:text-base text-gold-400 uppercase"
					>
						ĐĂNG KÝ Ở GHÉP PHÒNG
					</h2>
					<p class="text-[11px] text-gray-300">
						Đêm nghỉ 15/08 tại khu du lịch
					</p>
				</div>
				<div class="text-right shrink-0">
					<span
						id="stat-total-oghep"
						class="text-lg sm:text-xl font-bold text-gold-400"
						>0</span
					>
					<span class="block text-[10px] text-gray-300 uppercase"
						>Lượt Đăng Ký</span
					>
				</div>
			</div>

			<!-- Search & Filter -->
			<div
				class="relative bg-white p-3 rounded-xl border border-gray-200 shadow-2xs space-y-2.5 mb-4"
			>
				<div
					class="relative flex items-center bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 focus-within:bg-white focus-within:ring-2 focus-within:ring-navy-900 transition-all"
				>
					<svg
						class="w-4 h-4 text-gray-400 shrink-0 mr-2"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
						><path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
						></path></svg
					>
					<input
						type="text"
						id="search-o-ghep"
						oninput="filterOGhep()"
						placeholder="Nhập tên thành viên cần tìm..."
						class="w-full text-xs sm:text-sm bg-transparent outline-none text-navy-900 placeholder-gray-400"
					/>
					<button
						id="clear-search-oghep"
						onclick="clearSearch('search-o-ghep', filterOGhep)"
						class="hidden text-gray-400 hover:text-gray-600 ml-1"
					>
						<svg
							class="w-4 h-4"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
							><path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M6 18L18 6M6 6l12 12"></path></svg
						>
					</button>
				</div>
				<div id="name-suggestions-oghep" class="absolute left-3 right-3 top-[58px] z-30 hidden max-h-72 overflow-y-auto rounded-xl border border-gray-200 bg-white p-1 shadow-xl"></div>
				<!-- <div class="flex items-center gap-1.5 overflow-x-auto text-xs no-scrollbar pt-0.5">
					<span class="text-gray-400 font-medium text-[11px] shrink-0">Lọc lớp:</span>
					<button onclick="setClassFilterOGhep('ALL')" id="filter-oghep-all" class="filter-pill-oghep active-pill px-3 py-1 rounded-lg font-semibold whitespace-nowrap bg-navy-900 text-white shadow-2xs">Tất cả</button>
					<button onclick="setClassFilterOGhep('96Q1')" id="filter-oghep-q1" class="filter-pill-oghep px-3 py-1 rounded-lg font-semibold whitespace-nowrap bg-gray-100 text-gray-700 hover:bg-gray-200">Lớp 96Q1</button>
					<button onclick="setClassFilterOGhep('96Q2')" id="filter-oghep-q2" class="filter-pill-oghep px-3 py-1 rounded-lg font-semibold whitespace-nowrap bg-gray-100 text-gray-700 hover:bg-gray-200">Lớp 96Q2</button>
				</div> -->
			</div>

			<!-- Container Thẻ Ở Ghép -->
			<div id="cards-container-o-ghep" class="space-y-3">
				<!-- JS Render Thẻ Ở Ghép -->
			</div>
		</div>
	</main>

	<Footer />
</Layout>

<style>
	.no-scrollbar::-webkit-scrollbar {
		display: none;
	}
	.no-scrollbar {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
</style>

<!-- Firebase SDKs -->
<script
	is:inline
	src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"
></script>
<script
	is:inline
	src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"
></script>

<script is:inline>
	const firebaseConfig = {
		apiKey: "AIzaSyAfKEUC4xTaT-6Wo7fMdUUbmf2xAP2CaNM",
		authDomain: "register-to-participate.firebaseapp.com",
		projectId: "register-to-participate",
		storageBucket: "register-to-participate.firebasestorage.app",
		messagingSenderId: "578991866095",
		appId: "1:578991866095:web:9ce9b6b5e5d13314359b1a",
		measurementId: "G-DYQZETP6LS",
	};

	firebase.initializeApp(firebaseConfig);
	const db = firebase.firestore();

	let rawOGhep = [];
	let currentFilterOGhep = "ALL";

	window.setClassFilterOGhep = function (filter) {
		currentFilterOGhep = filter;
		document.querySelectorAll(".filter-pill-oghep").forEach((el) => {
			el.className =
				"filter-pill-oghep px-3 py-1 rounded-lg font-semibold whitespace-nowrap bg-gray-100 text-gray-700 hover:bg-gray-200";
		});
		if (filter === "ALL")
			document.getElementById("filter-oghep-all").className =
				"filter-pill-oghep active-pill px-3 py-1 rounded-lg font-semibold whitespace-nowrap bg-navy-900 text-white shadow-2xs";
		if (filter === "96Q1")
			document.getElementById("filter-oghep-q1").className =
				"filter-pill-oghep active-pill px-3 py-1 rounded-lg font-semibold whitespace-nowrap bg-navy-900 text-white shadow-2xs";
		if (filter === "96Q2")
			document.getElementById("filter-oghep-q2").className =
				"filter-pill-oghep active-pill px-3 py-1 rounded-lg font-semibold whitespace-nowrap bg-navy-900 text-white shadow-2xs";
		renderOGhepCards();
	};

	window.clearSearch = function (inputId, renderFn) {
		document.getElementById(inputId).value = "";
		renderFn();
	};

	function renderOGhepCards() {
		const container = document.getElementById("cards-container-o-ghep");
		const searchInput = document.getElementById("search-o-ghep");
		const clearBtn = document.getElementById("clear-search-oghep");
		const searchKeyword = (searchInput.value || "").toLowerCase().trim();

		if (clearBtn) {
			if (searchKeyword) clearBtn.classList.remove("hidden");
			else clearBtn.classList.add("hidden");
		}

		document.getElementById("stat-total-oghep").innerText =
			`${rawOGhep.length}`;

		const filtered = rawOGhep.filter((item) => {
			const matchSearch =
				!searchKeyword ||
				(item.name &&
					item.name.toLowerCase().includes(searchKeyword)) ||
				(item.roommate &&
					item.roommate.toLowerCase().includes(searchKeyword)) ||
				(item.hotelName &&
					item.hotelName.toLowerCase().includes(searchKeyword)) ||
				(item.roomNumber &&
					String(item.roomNumber).toLowerCase().includes(searchKeyword)) ||
				(item.className &&
					item.className.toLowerCase().includes(searchKeyword));
			let matchClass = true;
			if (currentFilterOGhep === "96Q1")
				matchClass = item.className === "96Q1";
			if (currentFilterOGhep === "96Q2")
				matchClass = item.className === "96Q2";
			return matchSearch && matchClass;
		});

		if (filtered.length === 0) {
			container.innerHTML = `
				<div class="bg-white rounded-xl p-6 text-center border border-gray-200 shadow-2xs">
					<p class="text-xs text-gray-500 font-medium">
						${searchKeyword || currentFilterOGhep !== "ALL" ? "Không tìm thấy kết quả phù hợp" : "Chưa có lượt đăng ký ở ghép nào"}
					</p>
				</div>
			`;
			return;
		}

		container.innerHTML = filtered
			.map((item, index) => {
				let dateStr = "";
				if (item.createdAt && item.createdAt.toDate) {
					const d = item.createdAt.toDate();
					dateStr = `${d.getHours()}:${String(d.getMinutes()).padStart(2, "0")} - ${d.getDate()}/${d.getMonth() + 1}/${d.getFullYear()}`;
				}

				const initial = (item.name || "U").charAt(0).toUpperCase();

				return `
				<div class="bg-white rounded-xl p-3.5 border border-gray-200 shadow-2xs space-y-2.5">
					<div class="flex items-center justify-between gap-2">
						<div class="flex items-center gap-2.5 min-w-0">
							<div class="w-8 h-8 rounded-full bg-navy-900 text-gold-400 font-bold text-xs flex items-center justify-center shrink-0">
								${initial}
							</div>
							<div class="min-w-0">
								<div class="flex items-center gap-1.5">
									<h4 class="font-bold text-sm text-navy-900 truncate">${item.name || "---"}</h4>
									<span class="bg-blue-50 text-navy-900 border border-blue-200 text-[10px] px-1.5 py-0.2 rounded font-bold shrink-0">${item.className || "---"}</span>
								</div>
								${dateStr ? `<span class="text-[10px] text-gray-400 block">${dateStr}</span>` : ""}
							</div>
						</div>
						<span class="text-xs font-bold text-gray-300 shrink-0">#${index + 1}</span>
					</div>

					${item.roomNumber ? `
					<div class="bg-gold-50/70 p-3 rounded-lg border border-gold-200/80">
						<div class="flex items-center justify-between gap-3">
							<span class="text-xs font-medium text-navy-900">🏨 ${item.hotelName || "Khách sạn"}</span>
							<span class="rounded bg-navy-900 px-2 py-1 text-xs font-bold text-gold-400">Phòng ${item.roomNumber}</span>
						</div>
						<div class="mt-2 rounded-lg border border-gold-200 bg-white/80 p-2.5">
							<span class="block text-[10px] font-bold uppercase tracking-wide text-gray-500">Ở cùng phòng</span>
							<span class="mt-1 block text-xs font-semibold leading-5 text-navy-900">${item.roommate || "Chưa có người ở cùng"}</span>
						</div>
					</div>` : `
					<div class="bg-gray-50 p-2.5 rounded-lg border border-gray-200 flex items-center justify-between">
						<span class="text-xs text-gray-600 font-medium">Đăng ký cũ · Ở ghép cùng:</span>
						<span class="text-xs font-bold text-gray-600">${item.roommate || "Chưa chỉ định"}</span>
					</div>`}

					${
						item.note
							? `
						<div class="text-xs text-gray-600 bg-gray-50 p-2 rounded-md">
							<span class="font-semibold text-gray-700">Ghi chú:</span> ${item.note}
						</div>
					`
							: ""
					}
				</div>
			`;
			})
			.join("");
	}

	let selectedOGhepPersonId = "";
	const foldVietnamese = (value = "") =>
		String(value)
			.normalize("NFD")
			.replace(/[\u0300-\u036f]/g, "")
			.replace(/đ/g, "d")
			.replace(/Đ/g, "D")
			.toLocaleLowerCase("vi");
	const escapeOGhep = (value = "") =>
		String(value).replace(/[&<>'"]/g, (char) => ({
			"&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;",
		})[char]);

	function renderSelectedRoom() {
		const container = document.getElementById("cards-container-o-ghep"),
			selected = rawOGhep.find((person) => person.id === selectedOGhepPersonId);
		document.getElementById("stat-total-oghep").innerText = `${rawOGhep.length}`;
		if (!selected) {
			container.innerHTML = `<div class="rounded-xl border border-gray-200 bg-white p-8 text-center shadow-2xs"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-gold-100 text-navy-900">🔎</span><p class="mt-3 text-sm font-bold text-navy-900">Chọn một thành viên để tra cứu phòng</p><p class="mt-1 text-xs text-gray-500">Nhập từng ký tự trong tên rồi chọn đúng người từ danh sách gợi ý.</p></div>`;
			return;
		}
		const occupants = rawOGhep
			.filter((person) => selected.roomKey
				? person.roomKey === selected.roomKey
				: person.hotelName === selected.hotelName && String(person.roomNumber) === String(selected.roomNumber))
			.sort((a, b) => a.id === selected.id ? -1 : b.id === selected.id ? 1 : (a.name || "").localeCompare(b.name || "", "vi"));
		container.innerHTML = `<article class="overflow-hidden rounded-2xl border border-gold-300 bg-white shadow-md"><header class="flex flex-wrap items-center justify-between gap-3 bg-navy-900 px-5 py-4 text-white"><div><p class="text-[10px] font-bold uppercase tracking-widest text-gold-400">Kết quả chỗ ở</p><h3 class="mt-1 font-serif text-xl font-bold">🏨 ${escapeOGhep(selected.hotelName || "Khách sạn")}</h3></div><span class="rounded-lg bg-gold-400 px-3 py-2 text-sm font-extrabold text-navy-900">Phòng ${escapeOGhep(selected.roomNumber)}</span></header><div class="p-4 sm:p-5"><div class="mb-3 flex items-center justify-between gap-2"><h4 class="font-bold text-navy-900">Những người ở cùng phòng</h4><span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-600">${occupants.length} người</span></div><div class="space-y-2">${occupants.map((person) => { const active = person.id === selected.id; return `<div class="flex items-center gap-3 rounded-xl border p-3 ${active ? "border-gold-400 bg-gold-50" : "border-gray-200 bg-gray-50"}"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full ${active ? "bg-gold-400 text-navy-900" : "bg-navy-900 text-gold-400"} text-sm font-extrabold">${escapeOGhep((person.name || "?").charAt(0))}</span><span class="min-w-0 flex-1"><b class="block text-sm text-navy-900">${escapeOGhep(person.name || "---")}</b><small class="font-bold ${person.className === "96Q1" ? "text-blue-600" : "text-purple-600"}">${escapeOGhep(person.className || "---")}</small></span>${active ? '<span class="shrink-0 rounded-full bg-gold-400 px-2 py-1 text-[10px] font-extrabold text-navy-900">Đang tra cứu</span>' : ""}</div>`; }).join("")}</div></div></article>`;
	}

	function renderNameSuggestions() {
		const input = document.getElementById("search-o-ghep"),
			clearButton = document.getElementById("clear-search-oghep"),
			suggestions = document.getElementById("name-suggestions-oghep"),
			keyword = foldVietnamese(input.value.trim());
		selectedOGhepPersonId = "";
		clearButton.classList.toggle("hidden", !keyword);
		if (!keyword) {
			suggestions.classList.add("hidden");
			renderSelectedRoom();
			return;
		}
		const matches = rawOGhep.filter((person) => foldVietnamese(person.name).includes(keyword)).slice(0, 15);
		suggestions.innerHTML = matches.length
			? matches.map((person) => `<button type="button" data-select-oghep="${escapeOGhep(person.id)}" class="flex w-full items-center justify-between gap-3 rounded-lg px-3 py-2.5 text-left hover:bg-gold-50"><span><b class="block text-sm text-navy-900">${escapeOGhep(person.name)}</b><small class="font-bold ${person.className === "96Q1" ? "text-blue-600" : "text-purple-600"}">${escapeOGhep(person.className || "---")}</small></span><span class="text-xs text-gray-400">Phòng ${escapeOGhep(person.roomNumber)}</span></button>`).join("")
			: '<p class="px-3 py-4 text-center text-xs text-gray-500">Không tìm thấy thành viên phù hợp</p>';
		suggestions.classList.remove("hidden");
		suggestions.querySelectorAll("[data-select-oghep]").forEach((button) => button.onclick = () => {
			selectedOGhepPersonId = button.dataset.selectOghep;
			const selected = rawOGhep.find((person) => person.id === selectedOGhepPersonId);
			input.value = selected?.name || "";
			suggestions.classList.add("hidden");
			clearButton.classList.remove("hidden");
			renderSelectedRoom();
		});
	}

	window.filterOGhep = renderNameSuggestions;
	window.clearSearch = function (inputId) {
		document.getElementById(inputId).value = "";
		selectedOGhepPersonId = "";
		document.getElementById("name-suggestions-oghep").classList.add("hidden");
		document.getElementById("clear-search-oghep").classList.add("hidden");
		renderSelectedRoom();
	};
	document.addEventListener("click", (event) => {
		if (!event.target.closest("#search-o-ghep") && !event.target.closest("#name-suggestions-oghep"))
			document.getElementById("name-suggestions-oghep").classList.add("hidden");
	});

	document.addEventListener("DOMContentLoaded", () => {
		db.collection("public_results")
			.onSnapshot((snapshot) => {
				rawOGhep = [];
				snapshot.forEach((doc) => {
					const person = doc.data();
					if (person.roomNumber) rawOGhep.push({ id: doc.id, ...person });
				});
				rawOGhep.sort((a,b)=>(a.name||"").localeCompare(b.name||"","vi"));
				rawOGhep.forEach((person) => {
					person.roommate = rawOGhep
						.filter((other) => other.id !== person.id && (person.roomKey
							? other.roomKey === person.roomKey
							: other.hotelName === person.hotelName && String(other.roomNumber) === String(person.roomNumber)))
						.map((other) => `${other.name} (${other.className || "---"})`)
						.join(", ");
				});
				renderSelectedRoom();
			});
	});
</script>
