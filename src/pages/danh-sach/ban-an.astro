---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Sơ Đồ 6 Bàn Ăn - 30 Năm Hội Ngộ 96Q">
	<Header />

	<main class="pt-24 pb-20 bg-ivory min-h-screen">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

			<!-- Header Title -->
			<div class="text-center mb-5">
				<h1 class="text-2xl sm:text-3xl font-serif font-bold text-navy-900 mt-2 uppercase tracking-tight">
					SƠ ĐỒ 6 BÀN ĂN GALA DINNER
				</h1>
				<p class="text-xs text-gray-500 mt-1">Hội ngộ 30 năm Kỷ niệm 96Q1 & 96Q2</p>
			</div>

			<!-- Nav links -->
			<div class="flex justify-center gap-3 mb-5">
				<a href="/PageForMeeting/danh-sach/" class="px-4 py-2 text-sm font-medium text-gray-500 hover:text-navy-900 border border-gray-200 rounded-lg hover:border-navy-900 transition-all flex items-center gap-2">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
					Quay lại
				</a>
				<a href="/PageForMeeting/danh-sach/o-ghep/" class="px-4 py-2 text-sm font-medium text-gray-500 hover:text-navy-900 border border-gray-200 rounded-lg hover:border-navy-900 transition-all flex items-center gap-2">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
					Xem Ở Ghép
				</a>
			</div>

			<!-- Quick Stats Bar -->
			<div class="grid grid-cols-3 gap-2 text-center mb-4">
				<div class="bg-white p-2.5 rounded-xl border border-gray-200 shadow-2xs">
					<span class="block text-[10px] text-gray-500 uppercase font-semibold">Đã Xếp Bàn</span>
					<span id="stat-total-seated" class="text-base sm:text-xl font-bold text-navy-900">0/60</span>
				</div>
				<div class="bg-white p-2.5 rounded-xl border border-gray-200 shadow-2xs">
					<span class="block text-[10px] text-gray-500 uppercase font-semibold">Ghế Trống</span>
					<span id="stat-total-remaining" class="text-base sm:text-xl font-bold text-green-600">60</span>
				</div>
				<div class="bg-white p-2.5 rounded-xl border border-gray-200 shadow-2xs">
					<span class="block text-[10px] text-gray-500 uppercase font-semibold">Thành Viên Nữ</span>
					<span id="stat-total-female" class="text-base sm:text-xl font-bold text-pink-600">0</span>
				</div>
			</div>

			<!-- Search Box & Filter Pills -->
			<div class="bg-white p-3 rounded-xl border border-gray-200 shadow-2xs space-y-2.5 mb-4">
				<div class="relative flex items-center bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 focus-within:bg-white focus-within:ring-2 focus-within:ring-navy-900 transition-all">
					<svg class="w-4 h-4 text-gray-400 shrink-0 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
					<input type="text" id="search-ban-an" oninput="filterBanAn()" placeholder="Tìm tên thành viên..." class="w-full text-xs sm:text-sm bg-transparent outline-none text-navy-900 placeholder-gray-400">
					<button id="clear-search-ban-an" onclick="clearSearch('search-ban-an', filterBanAn)" class="hidden text-gray-400 hover:text-gray-600 ml-1">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
					</button>
				</div>
				<!-- Filter Pills -->
				<div class="flex items-center gap-1.5 overflow-x-auto text-xs no-scrollbar pt-0.5">
					<span class="text-gray-400 font-medium text-[11px] shrink-0">Lọc:</span>
					<button onclick="setClassFilterBanAn('ALL')" id="filter-banan-all" class="filter-pill-banan active-pill px-3 py-1 rounded-lg font-semibold whitespace-nowrap bg-navy-900 text-white shadow-2xs">Tất cả</button>
					<button onclick="setClassFilterBanAn('96Q1')" id="filter-banan-q1" class="filter-pill-banan px-3 py-1 rounded-lg font-semibold whitespace-nowrap bg-gray-100 text-gray-700 hover:bg-gray-200">Lớp 96Q1</button>
					<button onclick="setClassFilterBanAn('96Q2')" id="filter-banan-q2" class="filter-pill-banan px-3 py-1 rounded-lg font-semibold whitespace-nowrap bg-gray-100 text-gray-700 hover:bg-gray-200">Lớp 96Q2</button>
					<button onclick="setClassFilterBanAn('FEMALE')" id="filter-banan-female" class="filter-pill-banan px-3 py-1 rounded-lg font-semibold whitespace-nowrap bg-pink-50 text-pink-700 border border-pink-200 hover:bg-pink-100">Nữ</button>
				</div>
			</div>

			<!-- Thanh chuyển nhanh bàn -->
			<div class="flex gap-1.5 overflow-x-auto pb-1 no-scrollbar text-xs mb-4">
				<button onclick="scrollToTable('table-1')" class="px-3 py-1.5 rounded-lg bg-white border border-gray-200 shadow-2xs font-semibold text-navy-900 shrink-0">1. Nặn Tượng</button>
				<button onclick="scrollToTable('table-2')" class="px-3 py-1.5 rounded-lg bg-white border border-gray-200 shadow-2xs font-semibold text-navy-900 shrink-0">2. Vật Lý KT</button>
				<button onclick="scrollToTable('table-3')" class="px-3 py-1.5 rounded-lg bg-white border border-gray-200 shadow-2xs font-semibold text-navy-900 shrink-0">3. Hình Học HH</button>
				<button onclick="scrollToTable('table-4')" class="px-3 py-1.5 rounded-lg bg-white border border-gray-200 shadow-2xs font-semibold text-navy-900 shrink-0">4. Mực Nho</button>
				<button onclick="scrollToTable('table-5')" class="px-3 py-1.5 rounded-lg bg-white border border-gray-200 shadow-2xs font-semibold text-navy-900 shrink-0">5. ĐA Quán Hoa</button>
				<button onclick="scrollToTable('table-6')" class="px-3 py-1.5 rounded-lg bg-white border border-gray-200 shadow-2xs font-semibold text-navy-900 shrink-0">6. Sức Bền VL</button>
			</div>

			<!-- Grid 6 Bàn -->
			<div id="grid-6-tables" class="grid grid-cols-1 md:grid-cols-2 gap-4">
				<!-- JS Render 6 Bàn -->
			</div>

		</div>
	</main>

	<Footer />
</Layout>

<style>
	.no-scrollbar::-webkit-scrollbar { display: none; }
	.no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<!-- Firebase SDKs -->
<script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>

<script is:inline>
	const firebaseConfig = {
		apiKey: "AIzaSyAfKEUC4xTaT-6Wo7fMdUUbmf2xAP2CaNM",
		authDomain: "register-to-participate.firebaseapp.com",
		projectId: "register-to-participate",
		storageBucket: "register-to-participate.firebasestorage.app",
		messagingSenderId: "578991866095",
		appId: "1:578991866095:web:9ce9b6b5e5d13314359b1a",
		measurementId: "G-DYQZETP6LS"
	};

	firebase.initializeApp(firebaseConfig);
	const db = firebase.firestore();

	const tableNames = [
		"Bàn Nặn tượng",
		"Bàn Vật lý kiến trúc",
		"Bàn Hình học họa hình",
		"Bàn Mực nho - Đi màu",
		"Bàn ĐA Quán Hoa",
		"Bàn Sức bền Vật Liệu"
	];

	let rawBocTham = [];
	let currentFilterBanAn = 'ALL';

	window.scrollToTable = function(tableId) {
		const el = document.getElementById(tableId);
		if (el) {
			const offset = 140;
			const bodyRect = document.body.getBoundingClientRect().top;
			const elementRect = el.getBoundingClientRect().top;
			const offsetPosition = (elementRect - bodyRect) - offset;
			window.scrollTo({ top: offsetPosition, behavior: 'smooth' });
		}
	};

	window.setClassFilterBanAn = function(filter) {
		currentFilterBanAn = filter;
		document.querySelectorAll('.filter-pill-banan').forEach(el => {
			el.className = 'filter-pill-banan px-3 py-1 rounded-lg font-semibold whitespace-nowrap bg-gray-100 text-gray-700 hover:bg-gray-200';
		});
		if (filter === 'ALL') document.getElementById('filter-banan-all').className = 'filter-pill-banan active-pill px-3 py-1 rounded-lg font-semibold whitespace-nowrap bg-navy-900 text-white shadow-2xs';
		if (filter === '96Q1') document.getElementById('filter-banan-q1').className = 'filter-pill-banan active-pill px-3 py-1 rounded-lg font-semibold whitespace-nowrap bg-navy-900 text-white shadow-2xs';
		if (filter === '96Q2') document.getElementById('filter-banan-q2').className = 'filter-pill-banan active-pill px-3 py-1 rounded-lg font-semibold whitespace-nowrap bg-navy-900 text-white shadow-2xs';
		if (filter === 'FEMALE') document.getElementById('filter-banan-female').className = 'filter-pill-banan active-pill px-3 py-1 rounded-lg font-semibold whitespace-nowrap bg-pink-600 text-white shadow-2xs';
		render6Tables();
	};

	window.clearSearch = function(inputId, renderFn) {
		document.getElementById(inputId).value = '';
		renderFn();
	};

	function render6Tables() {
		const container = document.getElementById('grid-6-tables');
		const searchInput = document.getElementById('search-ban-an');
		const clearBtn = document.getElementById('clear-search-ban-an');
		const searchKeyword = (searchInput.value || '').toLowerCase().trim();

		if (clearBtn) {
			if (searchKeyword) clearBtn.classList.remove('hidden');
			else clearBtn.classList.add('hidden');
		}

		const totalSeated = rawBocTham.length;
		const totalFemale = rawBocTham.filter(item => item.isFemale).length;
		const totalRemaining = Math.max(0, 60 - totalSeated);

		document.getElementById('stat-total-seated').innerText = `${totalSeated}/60`;
		document.getElementById('stat-total-remaining').innerText = `${totalRemaining}`;
		document.getElementById('stat-total-female').innerText = `${totalFemale}`;

		container.innerHTML = tableNames.map((tName, tIdx) => {
			const members = rawBocTham.filter(item => item.tableName === tName);
			const count = members.length;
			const isFull = count >= 10;
			const percent = Math.min(100, (count / 10) * 100);

			const filteredMembers = members.filter(m => {
				const matchSearch = !searchKeyword ||
					(m.name && m.name.toLowerCase().includes(searchKeyword)) ||
					(m.className && m.className.toLowerCase().includes(searchKeyword));
				let matchClass = true;
				if (currentFilterBanAn === '96Q1') matchClass = m.className === '96Q1';
				if (currentFilterBanAn === '96Q2') matchClass = m.className === '96Q2';
				if (currentFilterBanAn === 'FEMALE') matchClass = !!m.isFemale;
				return matchSearch && matchClass;
			});

			return `
				<div id="table-${tIdx + 1}" class="bg-white rounded-xl border border-gray-200 shadow-2xs overflow-hidden flex flex-col">
					<div class="bg-navy-900 text-white px-3.5 py-3">
						<div class="flex items-center justify-between gap-2 mb-2">
							<div class="min-w-0 flex-1">
								<span class="text-[10px] text-gold-400 font-bold uppercase tracking-wider block leading-tight">Bàn #${tIdx + 1}</span>
								<h3 class="font-bold text-sm text-white font-serif truncate">${tName}</h3>
							</div>
							<span class="text-[11px] px-2.5 py-0.5 rounded-full font-bold shrink-0 ${isFull ? 'bg-amber-500 text-white' : 'bg-gold-500 text-navy-900'}">
								${count}/10 người
							</span>
						</div>
						<div class="w-full bg-white/10 rounded-full h-1.5 overflow-hidden">
							<div class="bg-gold-400 h-1.5 rounded-full transition-all duration-300" style="width: ${percent}%"></div>
						</div>
					</div>
					<div class="p-3 flex-1 space-y-1.5">
						${filteredMembers.length === 0 ? `
							<div class="text-center py-5 px-3 bg-gray-50 rounded-lg border border-dashed border-gray-200">
								<p class="text-xs text-gray-400 italic">
									${searchKeyword || currentFilterBanAn !== 'ALL' ? 'Không khớp bộ lọc' : 'Chưa có ai bốc vào bàn này'}
								</p>
							</div>
						` : filteredMembers.map((m, idx) => {
							const initial = (m.name || 'U').charAt(0).toUpperCase();
							return `
								<div class="flex items-center justify-between p-2 rounded-lg bg-gray-50 border border-gray-100">
									<div class="flex items-center gap-2 min-w-0 flex-1 pr-2">
										<div class="w-7 h-7 rounded-full ${m.isFemale ? 'bg-pink-100 text-pink-700' : 'bg-navy-900 text-gold-400'} font-bold text-xs flex items-center justify-center shrink-0">
											${initial}
										</div>
										<span class="font-bold text-xs sm:text-sm text-navy-900 truncate">${m.name || '---'}</span>
									</div>
									<div class="flex items-center gap-1 shrink-0">
										${m.isFemale ? '<span class="bg-pink-100 text-pink-700 text-[10px] px-1.5 py-0.5 rounded font-bold">Nữ</span>' : ''}
										<span class="bg-gray-200 text-gray-700 text-[10px] px-1.5 py-0.5 rounded font-bold">${m.className || ''}</span>
									</div>
								</div>
							`;
						}).join('')}
					</div>
				</div>
			`;
		}).join('');
	}

	window.filterBanAn = render6Tables;

	document.addEventListener('DOMContentLoaded', () => {
		db.collection("boc_tham").orderBy("createdAt", "desc").onSnapshot(snapshot => {
			rawBocTham = [];
			snapshot.forEach(doc => {
				rawBocTham.push({ id: doc.id, ...doc.data() });
			});
			render6Tables();
		});
	});
</script>
