---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
const danhSachUrl = import.meta.env.BASE_URL + "danh-sach/o-ghep/";
---

<Layout title="Đăng ký Ở Ghép - 30 Năm Hội Ngộ 96Q">
  <Header />

  <main class="pt-28 pb-16 bg-ivory min-h-screen">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header Title -->
      <div class="text-center mb-10">
        <span
          class="bg-gold-100 text-gold-700 text-xs px-3 py-1 rounded-full uppercase tracking-wider font-semibold border border-gold-300"
          >Trang Thử Nghiệm Nội Bộ</span
        >
        <h1
          class="text-3xl md:text-4xl font-serif font-bold text-navy-900 mt-3 uppercase"
        >
          ĐĂNG KÝ Ở GHÉP PHÒNG
        </h1>
        <p class="text-gray-600 text-sm mt-2">
          Dành cho cựu sinh viên 96Q1 & 96Q2
        </p>
      </div>

      <!-- Nav links -->
      <div class="flex justify-center gap-3 mb-8">
        <a
          href={import.meta.env.BASE_URL + "dang-ky-thu/"}
          class="px-4 py-2 text-sm font-medium text-gray-500 hover:text-navy-900 border border-gray-200 rounded-lg hover:border-navy-900 transition-all flex items-center gap-2"
        >
          <i data-lucide="arrow-left" class="w-4 h-4"></i>
          Quay lại
        </a>
        <a
          href={import.meta.env.BASE_URL + "dang-ky-thu/boc-tham/"}
          class="px-4 py-2 text-sm font-medium text-gray-500 hover:text-navy-900 border border-gray-200 rounded-lg hover:border-navy-900 transition-all flex items-center gap-2"
        >
          <i data-lucide="sparkles" class="w-4 h-4"></i>
          Đặt chỗ đêm Gala
        </a>
      </div>

      <!-- Form Card -->
      <div
        class="bg-white rounded-2xl p-6 md:p-8 shadow-md border border-gray-100"
      >
        <div class="max-w-xl mx-auto">
          <div class="flex items-center gap-3 mb-2">
            <div
              class="w-10 h-10 bg-navy-900 rounded-xl flex items-center justify-center flex-shrink-0"
            >
              <i data-lucide="home" class="w-5 h-5 text-white"></i>
            </div>
            <div>
              <h2 class="text-xl font-bold text-navy-900">
                Form Đăng ký ở ghép phòng nghỉ
              </h2>
              <p class="text-xs text-gray-500">
                Đêm 15/08 — Gala Dinner 30 năm hội ngộ
              </p>
            </div>
          </div>
          <p class="text-xs text-gray-500 mb-6 mt-3 pl-1">
            Vui lòng điền thông tin người bạn muốn sắp xếp ở chung phòng đêm
            15/08.
          </p>

          <form
            id="form-o-ghep"
            onsubmit="handleFormOGhep(event)"
            class="space-y-4"
          >
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Họ và tên của bạn <span class="text-red-500">*</span></label
              >
              <input
                type="text"
                id="oghep-name"
                required
                placeholder="Nguyễn Văn A"
                class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-navy-900 focus:border-navy-900 outline-none text-sm"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Lớp <span class="text-red-500">*</span></label
              >
              <select
                id="oghep-class"
                required
                class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-navy-900 focus:border-navy-900 outline-none text-sm"
              >
                <option value="">-- Chọn lớp --</option>
                <option value="96Q1">96Q1</option>
                <option value="96Q2">96Q2</option>
              </select>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Họ tên người bạn muốn ở ghép <span
                  class="text-gray-400 font-normal text-xs">(Tùy chọn)</span
                ></label
              >
              <input
                type="text"
                id="oghep-roommate"
                placeholder="Trần Văn B"
                class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-navy-900 focus:border-navy-900 outline-none text-sm"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Ghi chú thêm (Nếu có)</label
              >
              <textarea
                id="oghep-note"
                rows="2"
                placeholder="Ví dụ: Mong muốn ở phòng tầng thấp..."
                class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-navy-900 focus:border-navy-900 outline-none text-sm"
              ></textarea>
            </div>

            <button
              type="submit"
              id="btn-submit-oghep"
              class="w-full bg-navy-900 text-white font-medium py-3 rounded-lg hover:bg-gold-500 transition-colors shadow-sm flex items-center justify-center gap-2 text-sm mt-4"
            >
              <i data-lucide="send" class="w-4 h-4"></i>
              Gửi Đăng Ký Ở Ghép
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<!-- Firebase App & Firestore SDKs -->
<script
  is:inline
  src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"
></script>
<script
  is:inline
  src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"
></script>

<script define:vars={{ danhSachUrl }}>
  const firebaseConfig = {
    apiKey: "AIzaSyAfKEUC4xTaT-6Wo7fMdUUbmf2xAP2CaNM",
    authDomain: "register-to-participate.firebaseapp.com",
    projectId: "register-to-participate",
    storageBucket: "register-to-participate.firebasestorage.app",
    messagingSenderId: "578991866095",
    appId: "1:578991866095:web:9ce9b6b5e5d13314359b1a",
    measurementId: "G-DYQZETP6LS",
  };

  const isFirebaseConfigured = firebaseConfig.apiKey !== "YOUR_API_KEY";
  let db = null;

  if (isFirebaseConfigured) {
    try {
      firebase.initializeApp(firebaseConfig);
      db = firebase.firestore();
    } catch (e) {
      console.error("Firebase Init Error:", e);
    }
  }

  // Xử lý Form Đăng ký ở ghép
  window.handleFormOGhep = async function (e) {
    e.preventDefault();
    const name = document.getElementById("oghep-name").value.trim();
    const className = document.getElementById("oghep-class").value;
    const roommate = document.getElementById("oghep-roommate").value.trim();
    const note = document.getElementById("oghep-note").value.trim();

    const btn = document.getElementById("btn-submit-oghep");
    btn.disabled = true;
    btn.innerHTML =
      '<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i> Đang gửi...';

    try {
      if (db) {
        await db.collection("o_ghep").add({
          name: name,
          className: className,
          roommate: roommate,
          note: note,
          createdAt: firebase.firestore.FieldValue.serverTimestamp(),
        });
      }

      const roommateMsg = roommate ? `\nỞ ghép cùng: ${roommate}` : "";
      alert(
        `Đăng ký ở ghép thành công!\n\nNgười đăng ký: ${name} (${className})${roommateMsg}`,
      );
      document.getElementById("form-o-ghep").reset();
      window.location.replace(danhSachUrl);
    } catch (err) {
      alert("Có lỗi xảy ra khi kết nối Firebase: " + err.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML =
        '<i data-lucide="send" class="w-4 h-4"></i> Gửi Đăng Ký Ở Ghép';
      if (window.lucide) window.lucide.createIcons();
    }
  };
</script>
