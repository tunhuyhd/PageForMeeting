---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
const danhSachUrl = import.meta.env.BASE_URL + "danh-sach/o-ghep/";
---

<Layout title="Đăng ký Phòng Nghỉ - 30 Năm Hội Ngộ 96Q">
  <Header />
  <main class="min-h-screen bg-ivory pb-16 pt-28">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="mb-9 text-center">
        <span class="rounded-full border border-gold-300 bg-gold-100 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-gold-700">Trang thử nghiệm nội bộ</span>
        <h1 class="mt-3 font-serif text-3xl font-bold uppercase text-navy-900 md:text-4xl">Đăng ký phòng nghỉ</h1>
        <p class="mt-2 text-sm text-gray-600">Đêm 15/08 — chọn chỗ còn trống trong phòng</p>
      </div>

      <div class="mb-8 flex justify-center gap-3">
        <a href={import.meta.env.BASE_URL + "dang-ky-thu/"} class="flex items-center gap-2 rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-500 transition hover:border-navy-900 hover:text-navy-900"><i data-lucide="arrow-left" class="h-4 w-4"></i> Quay lại</a>
        <a href={import.meta.env.BASE_URL + "danh-sach/o-ghep/"} class="flex items-center gap-2 rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-500 transition hover:border-navy-900 hover:text-navy-900"><i data-lucide="list" class="h-4 w-4"></i> Danh sách phòng</a>
      </div>

      <div class="grid gap-7 lg:grid-cols-[340px_1fr] lg:items-start">
        <section class="rounded-2xl border border-gray-100 bg-white p-6 shadow-md lg:sticky lg:top-28">
          <div class="mb-5 flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-navy-900"><i data-lucide="user-round" class="h-5 w-5 text-white"></i></div>
            <div><h2 class="font-bold text-navy-900">Thông tin thành viên</h2><p class="text-xs text-gray-500">Chọn lớp để xem đúng khách sạn</p></div>
          </div>
          <form id="form-o-ghep" class="space-y-4">
            <div>
              <label for="oghep-name" class="mb-1 block text-sm font-medium text-gray-700">Họ và tên <span class="text-red-500">*</span></label>
              <input id="oghep-name" type="text" required autocomplete="name" placeholder="Nguyễn Văn A" class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm outline-none focus:border-navy-900 focus:ring-2 focus:ring-navy-900/15" />
            </div>
            <div>
              <label for="oghep-class" class="mb-1 block text-sm font-medium text-gray-700">Lớp <span class="text-red-500">*</span></label>
              <select id="oghep-class" required class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm outline-none focus:border-navy-900 focus:ring-2 focus:ring-navy-900/15">
                <option value="">-- Chọn lớp --</option><option value="96Q1">96Q1</option><option value="96Q2">96Q2</option>
              </select>
            </div>
            <div>
              <label for="oghep-note" class="mb-1 block text-sm font-medium text-gray-700">Ghi chú <span class="text-xs font-normal text-gray-400">(tùy chọn)</span></label>
              <textarea id="oghep-note" rows="2" placeholder="Nhu cầu hỗ trợ đặc biệt..." class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm outline-none focus:border-navy-900 focus:ring-2 focus:ring-navy-900/15"></textarea>
            </div>
            <input id="oghep-room" name="room" type="hidden" required />
            <div id="selected-room-summary" class="hidden rounded-xl border border-gold-300 bg-gold-50 p-3 text-sm"></div>
            <button id="btn-submit-oghep" type="submit" disabled class="flex w-full items-center justify-center gap-2 rounded-lg bg-navy-900 py-3 text-sm font-medium text-white shadow-sm transition hover:bg-gold-500 disabled:cursor-not-allowed disabled:bg-gray-300"><i data-lucide="bed-double" class="h-4 w-4"></i> Xác nhận chỗ trong phòng</button>
          </form>
        </section>

        <section class="rounded-2xl border border-gray-100 bg-white p-5 shadow-md sm:p-7">
          <div id="room-empty-state" class="py-16 text-center">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-gray-100"><i data-lucide="hotel" class="h-7 w-7 text-gray-400"></i></div>
            <h2 class="font-bold text-navy-900">Vui lòng chọn lớp</h2>
            <p class="mt-1 text-sm text-gray-500">96Q1 ở khách sạn Milla · 96Q2 ở Dragon Nest</p>
          </div>
          <div id="rooms-view" class="hidden">
            <div class="mb-5 flex flex-wrap items-start justify-between gap-3 border-b border-gray-100 pb-5">
              <div><p id="hotel-class" class="text-xs font-bold uppercase tracking-wider text-gold-600"></p><h2 id="hotel-name" class="mt-1 font-serif text-2xl font-bold text-navy-900"></h2></div>
              <div class="rounded-xl bg-navy-900 px-4 py-2 text-center text-white"><strong id="hotel-available" class="block text-lg text-gold-400">0</strong><span class="text-[10px] uppercase">chỗ còn lại</span></div>
            </div>
            <div class="mb-3 grid grid-cols-[1fr_auto] gap-2 text-xs text-gray-500"><span>Chọn một phòng còn chỗ bên dưới</span><span><i class="inline-block h-2.5 w-2.5 rounded-full bg-green-500"></i> Còn chỗ</span></div>
            <div id="rooms-grid" class="grid gap-3 sm:grid-cols-2"></div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <div id="registration-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-navy-900/70 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="registration-modal-title">
    <div class="w-full max-w-md overflow-hidden rounded-2xl bg-white shadow-2xl" role="document">
      <div class="bg-gradient-to-r from-navy-900 to-navy-800 px-6 py-5 text-center text-white">
        <div class="mx-auto mb-3 flex h-14 w-14 items-center justify-center rounded-full bg-green-500 text-white ring-4 ring-white/20"><i data-lucide="check" class="h-8 w-8"></i></div>
        <h2 id="registration-modal-title" class="font-serif text-2xl font-bold">Đăng ký thành công!</h2>
        <p class="mt-1 text-xs text-gray-300">Chỗ trong phòng đã được giữ cho bạn</p>
      </div>
      <div class="p-6">
        <div class="mb-5 rounded-xl border border-gold-200 bg-gold-50 p-4">
          <div class="flex items-center gap-3 border-b border-gold-200 pb-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-navy-900 font-bold text-gold-400" id="modal-initial">N</div>
            <div><strong id="modal-name" class="block text-navy-900"></strong><span id="modal-class" class="text-xs font-semibold text-gold-600"></span></div>
          </div>
          <dl class="mt-3 grid grid-cols-[100px_1fr] gap-x-3 gap-y-2 text-sm">
            <dt class="text-gray-500">Khách sạn</dt><dd id="modal-hotel" class="font-semibold text-navy-900"></dd>
            <dt class="text-gray-500">Phòng</dt><dd id="modal-room" class="font-bold text-gold-600"></dd>
            <dt class="text-gray-500">Giường</dt><dd id="modal-bed" class="font-medium text-gray-700"></dd>
            <dt class="text-gray-500">Công suất</dt><dd id="modal-capacity" class="font-medium text-gray-700"></dd>
          </dl>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <button id="modal-close" type="button" class="rounded-xl border border-gray-300 px-4 py-3 text-sm font-semibold text-gray-600 transition hover:border-navy-900 hover:text-navy-900">Đóng</button>
          <a href={danhSachUrl} class="flex items-center justify-center gap-2 rounded-xl bg-navy-900 px-4 py-3 text-sm font-semibold text-white transition hover:bg-gold-500"><i data-lucide="list" class="h-4 w-4"></i> Xem danh sách</a>
        </div>
      </div>
    </div>
  </div>
  <Footer />
</Layout>

<style>
  :global(.room-card) { display: block; cursor: pointer; border: 2px solid #e5e7eb; border-radius: .9rem; padding: 1rem; transition: border-color .2s, box-shadow .2s, transform .2s; }
  :global(.room-card:hover) { border-color: #d4af37; transform: translateY(-1px); }
  :global(.room-card.selected) { border-color: #0b1b3d; box-shadow: 0 0 0 3px rgb(11 27 61 / .1); background: #f8fafc; }
  :global(.room-card.full) { cursor: not-allowed; opacity: .58; background: #f3f4f6; }
  :global(.room-card.full:hover) { border-color: #e5e7eb; transform: none; }
</style>

<script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>
<script define:vars={{ danhSachUrl }}>
  const firebaseConfig = { apiKey: "AIzaSyAfKEUC4xTaT-6Wo7fMdUUbmf2xAP2CaNM", authDomain: "register-to-participate.firebaseapp.com", projectId: "register-to-participate", storageBucket: "register-to-participate.firebasestorage.app", messagingSenderId: "578991866095", appId: "1:578991866095:web:9ce9b6b5e5d13314359b1a", measurementId: "G-DYQZETP6LS" };
  if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
  const db = firebase.firestore();

  const hotels = {
    "96Q1": { id: "milla", name: "Milla", rooms: [
      { number: "206", bed: "1.6m + 1.2m", extra: "—", capacity: 3 }, { number: "208", bed: "1.6m + 1.2m", extra: "—", capacity: 3 },
      { number: "306", bed: "1.6m + 1.2m", extra: "—", capacity: 3 }, { number: "308", bed: "1.6m + 1.2m", extra: "—", capacity: 3 },
      { number: "406", bed: "1 × 1.8m", extra: "—", capacity: 2 }, { number: "408", bed: "1 × 1.8m", extra: "—", capacity: 2 },
      { number: "506", bed: "1 × 1.8m", extra: "—", capacity: 2 }, { number: "508", bed: "1.8m + 1.2m", extra: "—", capacity: 3 }
    ]},
    "96Q2": { id: "dragon-nest", name: "Dragon Nest", rooms: [
      { number: "201", bed: "2 × 1.6m", extra: "—", capacity: 4 }, { number: "202", bed: "2 × 1.6m", extra: "—", capacity: 4 },
      { number: "303", bed: "2 × 1.6m", extra: "—", capacity: 4 }, { number: "304", bed: "2 × 1.6m", extra: "+1", capacity: 5 },
      { number: "405", bed: "1 × 2.6m", extra: "+1", capacity: 4 }, { number: "406", bed: "1 × 2.6m", extra: "+1", capacity: 4 },
      { number: "507", bed: "1 × 1.8m", extra: "+1", capacity: 3 }, { number: "508", bed: "1 × 1.8m", extra: "+1", capacity: 3 }
    ]}
  };

  let inventory = {};
  let selectedRoomKey = "";
  const classSelect = document.getElementById("oghep-class");
  const roomInput = document.getElementById("oghep-room");
  const submitButton = document.getElementById("btn-submit-oghep");

  function roomKey(hotel, room) { return `${hotel.id}-${room.number}`; }
  function occupiedFor(key) { return Number(inventory[key] || 0); }

  function showRegistrationModal({ name, className, hotel, room }) {
    document.getElementById("modal-initial").textContent = name.charAt(0).toUpperCase();
    document.getElementById("modal-name").textContent = name;
    document.getElementById("modal-class").textContent = className;
    document.getElementById("modal-hotel").textContent = hotel.name;
    document.getElementById("modal-room").textContent = `Phòng ${room.number}`;
    document.getElementById("modal-bed").textContent = `${room.bed}${room.extra !== "—" ? ` · Extra ${room.extra}` : ""}`;
    document.getElementById("modal-capacity").textContent = `Tối đa ${room.capacity} người`;
    const modal = document.getElementById("registration-modal");
    modal.classList.remove("hidden"); modal.classList.add("flex");
    document.body.style.overflow = "hidden";
    document.getElementById("modal-close").focus();
  }

  function closeRegistrationModal() {
    const modal = document.getElementById("registration-modal");
    modal.classList.add("hidden"); modal.classList.remove("flex");
    document.body.style.overflow = "";
  }

  document.getElementById("modal-close").addEventListener("click", closeRegistrationModal);
  document.getElementById("registration-modal").addEventListener("click", (event) => { if (event.target.id === "registration-modal") closeRegistrationModal(); });
  document.addEventListener("keydown", (event) => { if (event.key === "Escape") closeRegistrationModal(); });

  function renderRooms() {
    const className = classSelect.value;
    const hotel = hotels[className];
    document.getElementById("room-empty-state").classList.toggle("hidden", Boolean(hotel));
    document.getElementById("rooms-view").classList.toggle("hidden", !hotel);
    if (!hotel) return;
    document.getElementById("hotel-class").textContent = `${className} · Khách sạn dành riêng cho lớp`;
    document.getElementById("hotel-name").textContent = `🏨 ${hotel.name}`;
    const available = hotel.rooms.reduce((sum, room) => sum + Math.max(0, room.capacity - occupiedFor(roomKey(hotel, room))), 0);
    document.getElementById("hotel-available").textContent = available;
    document.getElementById("rooms-grid").innerHTML = hotel.rooms.map((room) => {
      const key = roomKey(hotel, room); const occupied = occupiedFor(key); const remaining = Math.max(0, room.capacity - occupied); const full = remaining === 0;
      const percent = Math.min(100, occupied / room.capacity * 100);
      return `<button type="button" class="room-card ${full ? "full" : ""} ${selectedRoomKey === key ? "selected" : ""}" data-room-key="${key}" ${full ? "disabled" : ""}>
        <span class="flex items-center justify-between"><strong class="text-lg text-navy-900">Phòng ${room.number}</strong><span class="rounded-full px-2 py-1 text-[10px] font-bold ${full ? "bg-red-100 text-red-600" : "bg-green-100 text-green-700"}">${full ? "Đã đủ" : `Còn ${remaining} chỗ`}</span></span>
        <span class="mt-3 grid grid-cols-2 gap-2 text-left text-xs text-gray-500"><span>🛏️ Giường<br><b class="text-gray-700">${room.bed}</b></span><span>➕ Extra<br><b class="text-gray-700">${room.extra}</b></span></span>
        <span class="mt-3 block h-2 overflow-hidden rounded-full bg-gray-200"><span class="block h-full rounded-full ${full ? "bg-red-400" : "bg-gold-500"}" style="width:${percent}%"></span></span>
        <span class="mt-1.5 flex justify-between text-[10px] text-gray-400"><span>${occupied} đã chọn</span><span>Tối đa ${room.capacity} người</span></span>
      </button>`;
    }).join("");
    document.querySelectorAll("[data-room-key]").forEach((button) => button.addEventListener("click", () => selectRoom(button.dataset.roomKey)));
  }

  function selectRoom(key) {
    selectedRoomKey = key; roomInput.value = key;
    const className = classSelect.value; const hotel = hotels[className];
    const room = hotel?.rooms.find((item) => roomKey(hotel, item) === key);
    const summary = document.getElementById("selected-room-summary");
    summary.classList.toggle("hidden", !room);
    if (room) summary.innerHTML = `<span class="font-semibold text-navy-900">Đã chọn: ${hotel.name} — Phòng ${room.number}</span><br><span class="text-xs text-gray-500">${room.bed} · tối đa ${room.capacity} người</span>`;
    submitButton.disabled = !room;
    renderRooms();
  }

  classSelect.addEventListener("change", () => { selectedRoomKey = ""; roomInput.value = ""; submitButton.disabled = true; document.getElementById("selected-room-summary").classList.add("hidden"); renderRooms(); });

  db.collection("room_inventory").onSnapshot((snapshot) => {
    inventory = {}; snapshot.forEach((doc) => { inventory[doc.id] = Number(doc.data().occupied || 0); });
    if (selectedRoomKey) {
      const hotel = hotels[classSelect.value]; const room = hotel?.rooms.find((item) => roomKey(hotel, item) === selectedRoomKey);
      if (!room || occupiedFor(selectedRoomKey) >= room.capacity) selectRoom(""); else renderRooms();
    } else renderRooms();
  });

  document.getElementById("form-o-ghep").addEventListener("submit", async (event) => {
    event.preventDefault();
    const name = document.getElementById("oghep-name").value.trim(); const className = classSelect.value; const note = document.getElementById("oghep-note").value.trim();
    const hotel = hotels[className]; const room = hotel?.rooms.find((item) => roomKey(hotel, item) === selectedRoomKey);
    if (!room) { alert("Vui lòng chọn một phòng còn chỗ."); return; }
    submitButton.disabled = true; submitButton.innerHTML = '<i data-lucide="loader-2" class="h-4 w-4 animate-spin"></i> Đang giữ chỗ...'; if (window.lucide) window.lucide.createIcons();
    try {
      const existing = await db.collection("o_ghep").where("name", "==", name).where("className", "==", className).get();
      if (!existing.empty) throw new Error("Bạn đã đăng ký phòng trước đó rồi.");
      const inventoryRef = db.collection("room_inventory").doc(selectedRoomKey); const registrationRef = db.collection("o_ghep").doc();
      await db.runTransaction(async (transaction) => {
        const snapshot = await transaction.get(inventoryRef); const occupied = snapshot.exists ? Number(snapshot.data().occupied || 0) : 0;
        if (occupied >= room.capacity) throw new Error("Phòng này vừa hết chỗ. Vui lòng chọn phòng khác.");
        transaction.set(inventoryRef, { hotelId: hotel.id, hotelName: hotel.name, roomNumber: room.number, capacity: room.capacity, occupied: occupied + 1, updatedAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
        transaction.set(registrationRef, { name, className, note, hotelId: hotel.id, hotelName: hotel.name, roomNumber: room.number, roomKey: selectedRoomKey, bed: room.bed, extraBed: room.extra, capacity: room.capacity, createdAt: firebase.firestore.FieldValue.serverTimestamp() });
      });
      showRegistrationModal({ name, className, hotel, room });
      document.getElementById("form-o-ghep").reset();
      selectedRoomKey = ""; roomInput.value = "";
      document.getElementById("selected-room-summary").classList.add("hidden");
      submitButton.innerHTML = '<i data-lucide="bed-double" class="h-4 w-4"></i> Xác nhận chỗ trong phòng';
      renderRooms();
      if (window.lucide) window.lucide.createIcons();
    } catch (error) {
      alert(error.message || "Có lỗi khi đăng ký phòng."); submitButton.disabled = false; submitButton.innerHTML = '<i data-lucide="bed-double" class="h-4 w-4"></i> Xác nhận chỗ trong phòng'; if (window.lucide) window.lucide.createIcons();
    }
  });
</script>
