---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Đặt chỗ đêm Gala - 30 Năm Hội Ngộ 96Q">
  <Header />

  <main class="min-h-screen bg-ivory pb-16 pt-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 text-center">
        <h1
          class="mt-3 font-serif text-3xl font-bold uppercase text-navy-900 md:text-4xl"
        >
          Đặt chỗ bàn Gala Dinner
        </h1>
        <p class="mt-2 text-sm text-gray-600">
          Dành cho cựu sinh viên 96Q1 &amp; 96Q2
        </p>
      </div>

      <div class="mb-8 flex flex-wrap justify-center gap-3">
        <a
          href={import.meta.env.BASE_URL + "dang-ky-thu/"}
          class="flex items-center gap-2 rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-500 transition-all hover:border-navy-900 hover:text-navy-900"
        >
          <i data-lucide="arrow-left" class="h-4 w-4"></i> Quay lại
        </a>
        <a
          href={import.meta.env.BASE_URL + "danh-sach/ban-an/"}
          class="flex items-center gap-2 rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-500 transition-all hover:border-navy-900 hover:text-navy-900"
        >
          <i data-lucide="list" class="h-4 w-4"></i> Danh sách bàn
        </a>
      </div>

      <div
        class="overflow-hidden rounded-3xl border border-gray-100 bg-white shadow-xl shadow-navy-900/5"
      >
        <div class="grid items-center lg:grid-cols-2">
          <section
            class="border-t border-gray-100 p-6 sm:p-10 lg:border-l lg:border-t-0"
          >
            <div class="mb-6 flex items-center gap-3">
              <div
                class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-gold-500 to-gold-600 shadow-md"
              >
                <i data-lucide="user-round" class="h-5 w-5 text-white"></i>
              </div>
              <div>
                <h2 class="text-xl font-bold text-navy-900">
                  Thông tin Đặt chỗ
                </h2>
                <p class="text-xs leading-relaxed text-gray-500">
                  Mỗi bàn 10 người, tối đa 2 thành viên nữ.
                </p>
              </div>
            </div>

            <form id="form-boc-tham" class="space-y-5">
              <div>
                <label for="boctham-class" class="mb-1.5 block text-sm font-medium text-gray-700">Lọc theo lớp</label>
                <select id="boctham-class" class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-gold-500 focus:ring-2 focus:ring-gold-400/30">
                  <option value="">Tất cả lớp</option>
                  <option value="96Q1">96Q1</option>
                  <option value="96Q2">96Q2</option>
                </select>
              </div>

              <div class="relative">
                <label for="boctham-search" class="mb-1.5 block text-sm font-medium text-gray-700">Tìm tên của bạn <span class="text-red-500">*</span></label>
                <div class="relative"><i data-lucide="search" class="absolute left-3.5 top-3.5 h-4 w-4 text-gray-400"></i><input type="search" id="boctham-search" autocomplete="off" placeholder="Ví dụ: Ti, Tiến, Nguyễn..." class="w-full rounded-xl border border-gray-300 py-3 pl-10 pr-4 text-sm outline-none transition focus:border-gold-500 focus:ring-2 focus:ring-gold-400/30" /></div>
                <div id="person-search-results" class="absolute z-30 mt-1 hidden max-h-64 w-full overflow-y-auto rounded-xl border border-gray-200 bg-white p-1 shadow-xl"></div>
              </div>

              <div id="selected-person" class="hidden rounded-xl border-2 border-gold-400 bg-gold-50 p-4"></div>
              <p id="person-loading" class="rounded-xl bg-gray-50 p-3 text-center text-xs text-gray-500">Đang tải danh sách thành viên...</p>

              <button
                type="submit"
                id="btn-spin"
                disabled
                class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-gold-500 to-gold-600 py-3.5 text-base font-bold text-white shadow-md transition-all hover:-translate-y-0.5 hover:from-gold-600 hover:to-gold-700 hover:shadow-lg disabled:cursor-not-allowed disabled:opacity-50"
              >
                <i data-lucide="play" class="h-5 w-5"></i> QUAY BÀN NGẪU NHIÊN
              </button>
              <p class="text-center text-xs text-gray-400">
                Mỗi thành viên chỉ được quay bàn một lần.
              </p>
            </form>
          </section>
          <section
            class="wheel-panel px-5 py-9 sm:px-10 sm:py-12"
            aria-labelledby="wheel-title"
          >
            <div class="mb-7 text-center">
              <p
                id="wheel-title"
                class="font-serif text-2xl font-bold text-navy-900"
              >
                Vòng quay Đặt chỗ
              </p>
              <p
                id="wheel-status"
                class="mt-1 text-sm text-gray-500"
                aria-live="polite"
              >
                Điền thông tin và nhấn “Quay bàn”
              </p>
            </div>

            <div class="wheel-stage mx-auto">
              <div class="wheel-pointer" aria-hidden="true"></div>
              <div
                id="table-wheel"
                class="table-wheel"
                role="img"
                aria-label="Vòng quay gồm 6 bàn ăn"
              >
                <div id="wheel-labels"></div>
              </div>
              <button
                type="submit"
                form="form-boc-tham"
                id="wheel-spin-button"
                disabled
                class="wheel-center"
                aria-label="Quay bàn ngẫu nhiên"
              >
                <i data-lucide="sparkles" class="h-6 w-6"></i>
                <span>QUAY</span>
              </button>
            </div>

            <div
              id="result-box"
              class="result-box mt-8 hidden text-center"
              aria-live="polite"
            >
              <span
                class="text-xs font-bold uppercase tracking-[0.2em] text-gold-600"
                >Chúc mừng bạn!</span
              >
              <p class="mt-1 text-sm font-medium text-navy-900">
                Bàn của bạn là
              </p>
              <div
                id="result-table-name"
                class="mt-1 font-serif text-2xl font-bold uppercase text-gold-600"
              >
                ---
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .wheel-panel {
    background: radial-gradient(
      circle at 50% 40%,
      #fff 0%,
      #fffbeb 58%,
      #f8f4e8 100%
    );
  }
  .wheel-stage {
    position: relative;
    width: min(78vw, 390px);
    aspect-ratio: 1;
    filter: drop-shadow(0 18px 24px rgb(11 27 61 / 0.18));
  }
  .table-wheel {
    position: absolute;
    inset: 10px;
    overflow: hidden;
    border: 9px solid white;
    border-radius: 50%;
    background: conic-gradient(
      from -30deg,
      #d4af37 0deg 60deg,
      #ef8354 60deg 120deg,
      #6aa7a1 120deg 180deg,
      #5b7cba 180deg 240deg,
      #9b72cf 240deg 300deg,
      #d96f91 300deg 360deg
    );
    box-shadow:
      inset 0 0 0 2px rgb(255 255 255 / 0.45),
      0 0 0 1px rgb(11 27 61 / 0.08);
    transition: transform 4.6s cubic-bezier(0.12, 0.72, 0.08, 1);
    will-change: transform;
  }
  .table-wheel::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: repeating-conic-gradient(
      from -30deg,
      transparent 0deg 59.4deg,
      rgb(255 255 255 / 0.85) 59.4deg 60deg
    );
    pointer-events: none;
  }
  .wheel-pointer {
    position: absolute;
    z-index: 5;
    left: 50%;
    top: -5px;
    width: 46px;
    height: 55px;
    transform: translateX(-50%);
    background: #0b1b3d;
    clip-path: polygon(50% 100%, 0 0, 100% 0);
    filter: drop-shadow(0 4px 3px rgb(0 0 0 / 0.25));
  }
  .wheel-center {
    position: absolute;
    z-index: 4;
    left: 50%;
    top: 50%;
    display: flex;
    width: 30%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    border: 7px solid rgb(255 255 255 / 0.75);
    border-radius: 50%;
    background: white;
    color: #0b1b3d;
    font-size: clamp(0.65rem, 2.4vw, 0.9rem);
    font-weight: 800;
    letter-spacing: 0.12em;
    box-shadow: 0 4px 18px rgb(11 27 61 / 0.18);
    cursor: pointer;
    transition:
      color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .wheel-center:hover {
    color: #b49126;
    box-shadow: 0 6px 22px rgb(11 27 61 / 0.28);
    transform: translate(-50%, -50%) scale(1.04);
  }
  .wheel-center:focus-visible {
    outline: 3px solid #fcd34d;
    outline-offset: 4px;
  }
  .wheel-center:disabled {
    cursor: not-allowed;
    opacity: 0.75;
  }
  :global(.wheel-label) {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 50%;
    width: 30%;
    transform: translate(-50%, -50%);
    color: white;
    font-size: clamp(0.58rem, 2.5vw, 0.78rem);
    font-weight: 800;
    line-height: 1.15;
    text-align: center;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.45);
    pointer-events: none;
  }
  .result-box {
    border: 2px solid #d4af37;
    border-radius: 1rem;
    background: rgb(255 251 235 / 0.92);
    padding: 1rem;
    animation: result-pop 0.45s ease-out both;
  }
  @keyframes result-pop {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .table-wheel {
      transition-duration: 0.01ms;
    }
    .result-box {
      animation: none;
    }
  }
</style>

<script
  is:inline
  src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"
></script>
<script
  is:inline
  src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"
></script>

<script is:inline>
  const firebaseConfig={apiKey:"AIzaSyAfKEUC4xTaT-6Wo7fMdUUbmf2xAP2CaNM",authDomain:"register-to-participate.firebaseapp.com",projectId:"register-to-participate",storageBucket:"register-to-participate.firebasestorage.app",messagingSenderId:"578991866095",appId:"1:578991866095:web:9ce9b6b5e5d13314359b1a"};
  if(!firebase.apps.length)firebase.initializeApp(firebaseConfig);
  const db=firebase.firestore();
  const tableConfigs=[
    {id:"table-1",name:"Bàn Nặn tượng",label:"Nặn tượng",capacity:10},
    {id:"table-2",name:"Bàn Vật lý kiến trúc",label:"Vật lý KT",capacity:10},
    {id:"table-3",name:"Bàn Hình học họa hình",label:"Hình họa",capacity:10},
    {id:"table-4",name:"Bàn Mực nho - Đi màu",label:"Mực nho",capacity:10},
    {id:"table-5",name:"Bàn ĐA Quán Hoa",label:"ĐA Quán Hoa",capacity:10},
    {id:"table-6",name:"Bàn Sức bền Vật Liệu",label:"Sức bền VL",capacity:10},
  ];
  let candidates=[],tables={},selectedPerson=null,currentRotation=0,isSpinning=false,candidateLoadError="";
  const normalize=value=>String(value||"").normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLocaleLowerCase("vi").trim();
  const esc=(value="")=>String(value).replace(/[&<>'"]/g,char=>({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;",'"':"&quot;"}[char]));

  function renderWheelLabels() {
    document.getElementById("wheel-labels").innerHTML = tableConfigs
      .map((table, index) => {
        const angle = index * 60;
        const radians = (angle * Math.PI) / 180;
        const x = 50 + Math.sin(radians) * 34;
        const y = 50 - Math.cos(radians) * 34;
        return `<span class="wheel-label" style="left:${x}%;top:${y}%;transform:translate(-50%,-50%) rotate(${angle}deg)">${table.label}</span>`;
      })
      .join("");
  }

  function updateSpinState(){const disabled=!selectedPerson||Boolean(selectedPerson.dinnerTableId)||isSpinning;document.getElementById("btn-spin").disabled=disabled;document.getElementById("wheel-spin-button").disabled=disabled;}
  function selectPerson(person){selectedPerson=person;document.getElementById("boctham-search").value=person.fullName;document.getElementById("person-search-results").classList.add("hidden");const box=document.getElementById("selected-person");box.innerHTML=`<p class="text-xs font-bold uppercase tracking-wider text-gold-600">Đã chọn</p><p class="mt-1 font-semibold text-navy-900">${esc(person.fullName)}</p><p class="text-xs text-gray-500">${esc(person.className)}${person.isFemale?" · Nữ":""}</p>`;box.classList.remove("hidden");if(person.dinnerTableId){const index=tableConfigs.findIndex(table=>table.id===person.dinnerTableId);if(index>=0)spinToTable(index);document.getElementById("wheel-status").textContent="Bạn đã quay bàn trước đó";showResult(person.dinnerTableName,"Kết quả trước của bạn là");}else{document.getElementById("result-box").classList.add("hidden");document.getElementById("wheel-status").textContent="Đã chọn thành viên — nhấn QUAY";}updateSpinState();}
  function renderSearchResults(){const query=normalize(document.getElementById("boctham-search").value),className=document.getElementById("boctham-class").value,container=document.getElementById("person-search-results");if(candidateLoadError){container.innerHTML=`<p class="rounded-lg bg-red-50 p-3 text-center text-xs font-medium text-red-600">${esc(candidateLoadError)}</p>`;container.classList.remove("hidden");return;}if(query.length<2){container.innerHTML='<p class="p-3 text-center text-xs text-gray-400">Nhập ít nhất 2 ký tự để tìm kiếm</p>';container.classList.toggle("hidden",!query);return;}const matches=candidates.filter(person=>!person.dinnerTableId&&(!className||person.className===className)&&normalize(person.fullName).includes(query)).slice(0,12);container.innerHTML=matches.length?matches.map(person=>`<button type="button" data-person-id="${person.id}" class="flex w-full items-center justify-between rounded-lg px-3 py-2.5 text-left hover:bg-gold-50"><span><b class="block text-sm text-navy-900">${esc(person.fullName)}</b><small class="text-gray-500">${esc(person.className)}${person.isFemale?" · Nữ":""}</small></span><small class="ml-2 shrink-0 font-semibold text-orange-500">Chưa quay</small></button>`).join(""):'<p class="p-3 text-center text-xs text-gray-400">Không có thành viên chưa có bàn phù hợp</p>';container.classList.remove("hidden");container.querySelectorAll("[data-person-id]").forEach(button=>button.onclick=()=>selectPerson(candidates.find(person=>person.id===button.dataset.personId)));}
  function subscribeData(){db.collection("dinner_candidates").orderBy("fullName").onSnapshot(snapshot=>{candidateLoadError="";candidates=snapshot.docs.map(doc=>({id:doc.id,...doc.data()}));document.getElementById("person-loading").classList.add("hidden");renderSearchResults();},error=>{candidateLoadError=error?.code==="permission-denied"?"Firebase chưa cấp quyền đọc danh sách. Quản trị viên cần Publish firestore.rules mới.":"Chưa thể tải danh sách thành viên. Vui lòng thử lại.";const loading=document.getElementById("person-loading");loading.textContent=candidateLoadError;loading.className="rounded-xl bg-red-50 p-3 text-center text-xs font-medium text-red-600";renderSearchResults();console.error(error);});db.collection("dinner_tables").onSnapshot(snapshot=>{tables={};snapshot.forEach(doc=>{tables[doc.id]={id:doc.id,...doc.data()};});},error=>console.error(error));
  }

  function showResult(tableName, message = "Bàn của bạn là") {
    const resultBox = document.getElementById("result-box");
    document.querySelector("#result-box p").textContent = message;
    document.getElementById("result-table-name").textContent = tableName;
    resultBox.classList.remove("hidden");
  }

  function spinToTable(index) {
    const wheel = document.getElementById("table-wheel");
    const normalized = ((currentRotation % 360) + 360) % 360;
    const desired = (360 - index * 60) % 360;
    const adjustment = (desired - normalized + 360) % 360;
    currentRotation += 5 * 360 + adjustment;
    wheel.style.transform = `rotate(${currentRotation}deg)`;
  }

  async function handleSpin(event) {
    event.preventDefault();
    if (isSpinning) return;

    if(!selectedPerson)return;
    const button = document.getElementById("btn-spin");
    const wheelButton = document.getElementById("wheel-spin-button");
    const resultBox = document.getElementById("result-box");
    const status = document.getElementById("wheel-status");

    if(selectedPerson.dinnerTableId){showResult(selectedPerson.dinnerTableName,"Kết quả trước của bạn là");return;}
    let availableTables=tableConfigs.filter(config=>{const table=tables[config.id];return table&&!table.locked&&Number(table.occupied||0)<config.capacity&&(!selectedPerson.isFemale||Number(table.females||0)<2);});
    if (!availableTables.length) {
      alert("Rất tiếc! Tất cả 6 bàn đều đã kín chỗ.");
      return;
    }

    const selectedTable=availableTables[Math.floor(Math.random()*availableTables.length)],selectedIndex=tableConfigs.findIndex(table=>table.id===selectedTable.id);
    isSpinning = true;
    button.disabled = true;
    wheelButton.disabled = true;
    button.innerHTML =
      '<i data-lucide="loader-2" class="h-5 w-5 animate-spin"></i> ĐANG QUAY...';
    resultBox.classList.add("hidden");
    status.textContent = "Vòng quay đang chọn bàn cho bạn...";
    if (window.lucide) window.lucide.createIcons();
    try{await db.runTransaction(async transaction=>{const candidateRef=db.collection("dinner_candidates").doc(selectedPerson.id),tableRef=db.collection("dinner_tables").doc(selectedTable.id),personRef=db.collection("persons").doc(selectedPerson.id),candidateSnapshot=await transaction.get(candidateRef),tableSnapshot=await transaction.get(tableRef);if(!candidateSnapshot.exists||!tableSnapshot.exists)throw Error("Dữ liệu không tồn tại.");const candidate=candidateSnapshot.data(),table=tableSnapshot.data();if(candidate.dinnerTableId)throw Error("Thành viên đã có bàn.");if(table.locked||Number(table.occupied||0)>=Number(table.capacity||10))throw Error("Bàn vừa hết chỗ.");if(candidate.isFemale&&Number(table.females||0)>=2)throw Error("Bàn vừa đủ thành viên nữ.");const assignedAt=firebase.firestore.FieldValue.serverTimestamp();transaction.update(tableRef,{occupied:Number(table.occupied||0)+1,females:Number(table.females||0)+(candidate.isFemale?1:0),lastAssignedPersonId:selectedPerson.id,updatedAt:assignedAt});transaction.update(candidateRef,{dinnerTableId:selectedTable.id,dinnerTableName:selectedTable.name,dinnerAssignedAt:assignedAt});transaction.update(personRef,{dinnerTableId:selectedTable.id,dinnerTableName:selectedTable.name,dinnerAssignedAt:assignedAt});});}catch(error){isSpinning=false;button.innerHTML='<i data-lucide="play" class="h-5 w-5"></i> QUAY BÀN NGẪU NHIÊN';status.textContent=error.message;updateSpinState();if(window.lucide)window.lucide.createIcons();return;}
    spinToTable(selectedIndex);
    window.setTimeout(() => {
      status.textContent = "Vòng quay đã dừng — chúc mừng bạn!";
      showResult(selectedTable.name);
      selectedPerson={...selectedPerson,dinnerTableId:selectedTable.id,dinnerTableName:selectedTable.name};
      button.innerHTML =
        '<i data-lucide="check-circle-2" class="h-5 w-5"></i> ĐÃ Đặt chỗ XONG';
      if (window.lucide) window.lucide.createIcons();
      isSpinning = false;
      updateSpinState();
    }, 4700);
  }

  document.addEventListener("DOMContentLoaded", () => {
    renderWheelLabels();
    subscribeData();
    document.getElementById("boctham-search").addEventListener("input",()=>{selectedPerson=null;document.getElementById("selected-person").classList.add("hidden");document.getElementById("result-box").classList.add("hidden");updateSpinState();renderSearchResults();});
    document.getElementById("boctham-search").addEventListener("focus",renderSearchResults);
    document.getElementById("boctham-class").addEventListener("change",()=>{selectedPerson=null;document.getElementById("selected-person").classList.add("hidden");updateSpinState();renderSearchResults();});
    document.addEventListener("click",event=>{if(!event.target.closest("#person-search-results")&&!event.target.closest("#boctham-search"))document.getElementById("person-search-results").classList.add("hidden");});
    document
      .getElementById("form-boc-tham")
      ?.addEventListener("submit", handleSpin);
  });
</script>
