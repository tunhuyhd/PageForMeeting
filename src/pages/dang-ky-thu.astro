---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Đăng ký & Bốc thăm Bàn - 30 Năm Hội Ngộ 96Q">
	<Header />
	
	<main class="pt-28 pb-16 bg-ivory min-h-screen">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<!-- Header Title -->
			<div class="text-center mb-10">
				<span class="bg-gold-100 text-gold-700 text-xs px-3 py-1 rounded-full uppercase tracking-wider font-semibold border border-gold-300">Trang Thử Nghiệm Nội Bộ</span>
				<h1 class="text-3xl md:text-4xl font-serif font-bold text-navy-900 mt-3 uppercase">ĐĂNG KÝ & BỐC THĂM BÀN GALA DINNER</h1>
				<p class="text-gray-600 text-sm mt-2">Dành cho cựu sinh viên 96Q1 & 96Q2</p>
			</div>

			<!-- Tabs Header -->
			<div class="flex justify-center mb-8 border-b border-gray-200">
				<button id="tab-btn-o-ghep" onclick="switchTab('o-ghep')" class="px-6 py-3 font-medium text-sm border-b-2 border-gold-500 text-navy-900 transition-all flex items-center gap-2">
					<i data-lucide="home" class="w-4 h-4"></i>
					1. Đăng ký ở ghép
				</button>
				<button id="tab-btn-boc-tham" onclick="switchTab('boc-tham')" class="px-6 py-3 font-medium text-sm border-b-2 border-transparent text-gray-500 hover:text-navy-900 transition-all flex items-center gap-2">
					<i data-lucide="sparkles" class="w-4 h-4"></i>
					2. Bốc thăm bàn ăn (Random)
				</button>
			</div>

			<!-- TAB 1: ĐĂNG KÝ Ở GHÉP -->
			<div id="tab-content-o-ghep" class="bg-white rounded-2xl p-6 md:p-8 shadow-md border border-gray-100">
				<div class="max-w-xl mx-auto">
					<h3 class="text-xl font-bold text-navy-900 mb-2">Form Đăng ký ở ghép phòng nghỉ</h3>
					<p class="text-xs text-gray-500 mb-6">Vui lòng điền thông tin người bạn muốn sắp xếp ở chung phòng đêm 15/08.</p>
					
					<form id="form-o-ghep" onsubmit="handleFormOGhep(event)" class="space-y-4">
						<div>
							<label class="block text-sm font-medium text-gray-700 mb-1">Họ và tên của bạn <span class="text-red-500">*</span></label>
							<input type="text" id="oghep-name" required placeholder="Nguyễn Văn A" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-navy-900 focus:border-navy-900 outline-none text-sm">
						</div>

						<div>
							<label class="block text-sm font-medium text-gray-700 mb-1">Lớp <span class="text-red-500">*</span></label>
							<select id="oghep-class" required class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-navy-900 focus:border-navy-900 outline-none text-sm">
								<option value="">-- Chọn lớp --</option>
								<option value="96Q1">96Q1</option>
								<option value="96Q2">96Q2</option>
							</select>
						</div>

						<div>
							<label class="block text-sm font-medium text-gray-700 mb-1">Họ tên người bạn muốn ở ghép <span class="text-red-500">*</span></label>
							<input type="text" id="oghep-roommate" required placeholder="Trần Văn B" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-navy-900 focus:border-navy-900 outline-none text-sm">
						</div>

						<div>
							<label class="block text-sm font-medium text-gray-700 mb-1">Ghi chú thêm (Nếu có)</label>
							<textarea id="oghep-note" rows="2" placeholder="Ví dụ: Mong muốn ở phòng tầng thấp..." class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-navy-900 focus:border-navy-900 outline-none text-sm"></textarea>
						</div>

						<button type="submit" id="btn-submit-oghep" class="w-full bg-navy-900 text-white font-medium py-3 rounded-lg hover:bg-gold-500 transition-colors shadow-sm flex items-center justify-center gap-2 text-sm mt-4">
							<i data-lucide="send" class="w-4 h-4"></i>
							Gửi Đăng Ký Ở Ghép
						</button>
					</form>
				</div>
			</div>

			<!-- TAB 2: BỐC THĂM BÀN RANDOM -->
			<div id="tab-content-boc-tham" class="hidden bg-white rounded-2xl p-6 md:p-8 shadow-md border border-gray-100">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
					<!-- Cột trái: Form bốc thăm -->
					<div class="lg:col-span-6 space-y-5">
						<div>
							<h3 class="text-xl font-bold text-navy-900 mb-1">Bốc thăm bàn Gala Dinner</h3>
							<p class="text-xs text-gray-500">Mỗi bàn 10 người. Hệ thống tự động xếp bàn và trừ chỗ khả dụng.</p>
						</div>

						<form id="form-boc-tham" onsubmit="handleBocTham(event)" class="space-y-4 bg-gray-50 p-5 rounded-xl border border-gray-200">
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Họ và tên của bạn <span class="text-red-500">*</span></label>
								<input type="text" id="boctham-name" required placeholder="Nguyễn Văn A" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-navy-900 focus:border-navy-900 outline-none text-sm">
							</div>

							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Lớp <span class="text-red-500">*</span></label>
								<select id="boctham-class" required class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-navy-900 focus:border-navy-900 outline-none text-sm">
									<option value="">-- Chọn lớp --</option>
									<option value="96Q1">96Q1</option>
									<option value="96Q2">96Q2</option>
								</select>
							</div>

							<div class="flex items-center gap-2 pt-1">
								<input type="checkbox" id="boctham-is-female" class="w-4 h-4 text-navy-900 rounded border-gray-300 focus:ring-navy-900">
								<label for="boctham-is-female" class="text-sm font-medium text-gray-700 select-none cursor-pointer">Thành viên Nữ (Hệ thống xếp tối đa 2 nữ/bàn)</label>
							</div>

							<button type="submit" id="btn-spin" class="w-full bg-gradient-to-r from-gold-500 to-gold-600 text-white font-bold py-3.5 rounded-lg hover:from-gold-600 hover:to-gold-700 transition-all shadow-md flex items-center justify-center gap-2 text-base mt-4">
								<i data-lucide="dice-5" class="w-5 h-5"></i>
								BỐC THĂM BÀN NGẪU NHIÊN
							</button>
						</form>

						<!-- Kết quả bốc thăm -->
						<div id="result-box" class="hidden p-5 rounded-xl bg-gold-50 border-2 border-gold-400 text-center space-y-2 animate-bounce-short">
							<span class="text-xs text-gold-700 font-bold uppercase tracking-wider">Chúc mừng bạn!</span>
							<p class="text-sm text-navy-900 font-medium">Hệ thống đã xếp bạn vào:</p>
							<div id="result-table-name" class="text-2xl font-serif font-bold text-navy-900 text-gold-600 uppercase">
								---
							</div>
						</div>
					</div>

					<!-- Cột phải: Danh sách bàn & chỗ trống -->
					<div class="lg:col-span-6 space-y-3">
						<h4 class="text-sm font-bold text-navy-900 uppercase tracking-wider flex items-center justify-between">
							<span>Tình trạng 6 bàn ăn</span>
							<span class="text-xs font-normal text-gray-500">(Mỗi bàn 10 ghế)</span>
						</h4>

						<div id="tables-list" class="space-y-3">
							<!-- Sẽ được JS tự Render -->
						</div>
					</div>
				</div>
			</div>

			<!-- Hướng dẫn cấu hình Google Sheets (Dành cho Ban tổ chức) -->
			<div class="mt-12 bg-white rounded-xl p-6 border border-gray-200 text-xs text-gray-600 space-y-3">
				<h4 class="font-bold text-navy-900 text-sm flex items-center gap-2">
					<i data-lucide="settings" class="w-4 h-4 text-gold-500"></i>
					Hướng dẫn tích hợp Google Sheets dành cho Ban Tổ Chức:
				</h4>
				<p>Để lưu trữ dữ liệu thực tế vào file Excel Google Sheets của bạn:</p>
				<ol class="list-decimal pl-5 space-y-1">
					<li>Tạo 1 Google Sheet mới.</li>
					<li>Vào <strong>Mở rộng (Extensions) &gt; Apps Script</strong> và dán đoạn mã backend được cung cấp.</li>
					<li>Triển khai dưới dạng Web App (Deploy as Web App) với quyền <em>Anyone (Bất kỳ ai)</em>.</li>
					<li>Dán đường link Web App URL vào biến <code>GOOGLE_SCRIPT_URL</code> trong file này.</li>
				</ol>
			</div>
		</div>
	</main>

	<Footer />
</Layout>

<!-- Firebase App & Firestore SDKs -->
<script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
<script is:inline src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>

<script is:inline>
	// 1. Cấu hình Firebase thực tế từ bạn
	const firebaseConfig = {
		apiKey: "AIzaSyAfKEUC4xTaT-6Wo7fMdUUbmf2xAP2CaNM",
		authDomain: "register-to-participate.firebaseapp.com",
		projectId: "register-to-participate",
		storageBucket: "register-to-participate.firebasestorage.app",
		messagingSenderId: "578991866095",
		appId: "1:578991866095:web:9ce9b6b5e5d13314359b1a",
		measurementId: "G-DYQZETP6LS"
	};

	// Kiểm tra xem đã dán config thật chưa
	const isFirebaseConfigured = firebaseConfig.apiKey !== "YOUR_API_KEY";
	let db = null;

	if (isFirebaseConfigured) {
		try {
			firebase.initializeApp(firebaseConfig);
			db = firebase.firestore();
		} catch (e) {
			console.error("Firebase Init Error:", e);
		}
	}

	// 6 Bàn cố định
	let tables = [
		{ id: 1, name: "Bàn Nặn tượng", total: 10, occupied: 0, females: 0 },
		{ id: 2, name: "Bàn Vật lý kiến trúc", total: 10, occupied: 0, females: 0 },
		{ id: 3, name: "Bàn Hình học họa hình", total: 10, occupied: 0, females: 0 },
		{ id: 4, name: "Bàn Mực nho - Đi màu", total: 10, occupied: 0, females: 0 },
		{ id: 5, name: "Bàn ĐA Quán Hoa", total: 10, occupied: 0, females: 0 },
		{ id: 6, name: "Bàn Sức bền Vật Liệu", total: 10, occupied: 0, females: 0 }
	];

	// Switch Tab Logic
	window.switchTab = function(tabName) {
		const tabOghep = document.getElementById('tab-content-o-ghep');
		const tabBocTham = document.getElementById('tab-content-boc-tham');
		const btnOghep = document.getElementById('tab-btn-o-ghep');
		const btnBocTham = document.getElementById('tab-btn-boc-tham');

		if (tabName === 'o-ghep') {
			tabOghep.classList.remove('hidden');
			tabBocTham.classList.add('hidden');
			btnOghep.className = 'px-6 py-3 font-medium text-sm border-b-2 border-gold-500 text-navy-900 transition-all flex items-center gap-2';
			btnBocTham.className = 'px-6 py-3 font-medium text-sm border-b-2 border-transparent text-gray-500 hover:text-navy-900 transition-all flex items-center gap-2';
		} else {
			tabOghep.classList.add('hidden');
			tabBocTham.classList.remove('hidden');
			btnBocTham.className = 'px-6 py-3 font-medium text-sm border-b-2 border-gold-500 text-navy-900 transition-all flex items-center gap-2';
			btnOghep.className = 'px-6 py-3 font-medium text-sm border-b-2 border-transparent text-gray-500 hover:text-navy-900 transition-all flex items-center gap-2';
		}
	};

	// Tải dữ liệu thực tế từ Firebase Firestore
	async function loadTablesFromFirebase() {
		if (!db) {
			renderTables();
			return;
		}

		try {
			// Lắng nghe dữ liệu real-time từ collection 'boc_tham'
			db.collection("boc_tham").onSnapshot(snapshot => {
				// Reset lại số lượng
				tables.forEach(t => { t.occupied = 0; t.females = 0; });

				snapshot.forEach(doc => {
					const data = doc.data();
					const targetTable = tables.find(t => t.name === data.tableName);
					if (targetTable) {
						targetTable.occupied += 1;
						if (data.isFemale) targetTable.females += 1;
					}
				});

				renderTables();
			});
		} catch (err) {
			console.error("Lỗi khi tải dữ liệu Firebase:", err);
			renderTables();
		}
	}

	// Render tình trạng 6 bàn
	function renderTables() {
		const container = document.getElementById('tables-list');
		if (!container) return;
		
		container.innerHTML = tables.map(t => {
			const remaining = t.total - t.occupied;
			const percent = Math.min(100, (t.occupied / t.total) * 100);
			return `
				<div class="bg-gray-50 p-3.5 rounded-lg border border-gray-200">
					<div class="flex justify-between items-center mb-1.5">
						<span class="font-bold text-xs text-navy-900">${t.name}</span>
						<span class="text-xs ${remaining > 0 ? 'text-green-600 font-semibold' : 'text-red-500 font-semibold'}">
							${remaining > 0 ? `Còn ${remaining} chỗ` : 'Đã hết chỗ'}
						</span>
					</div>
					<div class="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
						<div class="bg-gold-500 h-2 rounded-full transition-all duration-500" style="width: ${percent}%"></div>
					</div>
				</div>
			`;
		}).join('');
	}

	// Xử lý Form Đăng ký ở ghép (Lưu vào Collection 'o_ghep')
	window.handleFormOGhep = async function(e) {
		e.preventDefault();
		const name = document.getElementById('oghep-name').value.trim();
		const className = document.getElementById('oghep-class').value;
		const roommate = document.getElementById('oghep-roommate').value.trim();
		const note = document.getElementById('oghep-note').value.trim();

		const btn = document.getElementById('btn-submit-oghep');
		btn.disabled = true;
		btn.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i> Đang gửi...';

		try {
			if (db) {
				await db.collection("o_ghep").add({
					name: name,
					className: className,
					roommate: roommate,
					note: note,
					createdAt: firebase.firestore.FieldValue.serverTimestamp()
				});
			}

			alert(`Đăng ký ở ghép thành công!\n\nNgười đăng ký: ${name} (${className})\nỞ ghép cùng: ${roommate}`);
			document.getElementById('form-o-ghep').reset();
		} catch (err) {
			alert('Có lỗi xảy ra khi kết nối Firebase: ' + err.message);
		} finally {
			btn.disabled = false;
			btn.innerHTML = '<i data-lucide="send" class="w-4 h-4"></i> Gửi Đăng Ký Ở Ghép';
			if (window.lucide) window.lucide.createIcons();
		}
	};

	// Xử lý Bốc thăm Bàn (Lưu vào Collection 'boc_tham')
	window.handleBocTham = async function(e) {
		e.preventDefault();
		const name = document.getElementById('boctham-name').value.trim();
		const className = document.getElementById('boctham-class').value;
		const isFemale = document.getElementById('boctham-is-female').checked;

		const btn = document.getElementById('btn-spin');
		const resultBox = document.getElementById('result-box');
		const resultTableName = document.getElementById('result-table-name');

		// Kiểm tra nếu đã có Firebase, kiểm tra xem tên người này đã bốc chưa
		if (db) {
			const existing = await db.collection("boc_tham")
				.where("name", "==", name)
				.where("className", "==", className)
				.get();

			if (!existing.empty) {
				const prevData = existing.docs[0].data();
				alert(`Bạn (${name} - ${className}) đã bốc thăm trước đó rồi!\nBàn của bạn là: ${prevData.tableName}`);
				resultTableName.innerText = prevData.tableName;
				resultBox.classList.remove('hidden');
				return;
			}
		}

		// Lọc các bàn còn chỗ
		let availableTables = tables.filter(t => t.occupied < t.total);

		// Nếu là nữ, ưu tiên các bàn chưa quá 2 nữ
		if (isFemale) {
			const femaleTables = availableTables.filter(t => t.females < 2);
			if (femaleTables.length > 0) {
				availableTables = femaleTables;
			}
		}

		if (availableTables.length === 0) {
			alert('Rất tiếc! Tất cả 6 bàn đều đã kín chỗ!');
			return;
		}

		btn.disabled = true;
		btn.innerHTML = '<i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i> ĐANG QUAY BỐC THĂM...';
		resultBox.classList.add('hidden');

		// Mô phỏng quay số random 1.8 giây
		setTimeout(async () => {
			const selectedTable = availableTables[Math.floor(Math.random() * availableTables.length)];

			if (db) {
				try {
					await db.collection("boc_tham").add({
						name: name,
						className: className,
						isFemale: isFemale,
						tableName: selectedTable.name,
						createdAt: firebase.firestore.FieldValue.serverTimestamp()
					});
				} catch (err) {
					console.error("Lỗi khi lưu bốc thăm:", err);
				}
			} else {
				// Nếu chưa cấu hình Firebase, update local
				selectedTable.occupied += 1;
				if (isFemale) selectedTable.females += 1;
				renderTables();
			}

			resultTableName.innerText = selectedTable.name;
			resultBox.classList.remove('hidden');

			btn.disabled = false;
			btn.innerHTML = '<i data-lucide="dice-5" class="w-5 h-5"></i> BỐC THĂM BÀN NGỮU NHIÊN';
			if (window.lucide) window.lucide.createIcons();
		}, 1800);
	};

	// Khởi tạo ban đầu
	document.addEventListener('DOMContentLoaded', () => {
		loadTablesFromFirebase();
	});
</script>
