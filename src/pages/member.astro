---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Members from '../components/Members.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Danh Sách Thành Viên 96Q">
	<Header />
	<main class="pt-24 pb-12 bg-gray-50 min-h-[80vh]">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-4">
            <a href="/" class="inline-flex items-center gap-2 text-navy-900 hover:text-gold-500 font-medium transition-colors bg-white px-4 py-2 rounded-lg shadow-sm border border-gray-100">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Quay lại Trang chủ
            </a>
        </div>
		<Members />
	</main>
	<Footer />
</Layout>
