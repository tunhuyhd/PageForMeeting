---

---

<section
  id="ban-do"
  class="py-16 bg-ivory relative z-10 border-t border-gray-100"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2
        class="text-3xl md:text-4xl font-serif font-bold text-navy-900 uppercase"
      >
        CÁC ĐỊA ĐIỂM CHÍNH
      </h2>
      <div class="mt-4 flex items-center justify-center gap-2">
        <div class="h-[1px] w-12 bg-gold-400"></div>
        <div class="w-2 h-2 rotate-45 bg-gold-400"></div>
        <div class="h-[1px] w-12 bg-gold-400"></div>
      </div>
      <p class="text-gray-500 mt-4 text-sm max-w-2xl mx-auto">
        Bản đồ vị trí các khu vực trong sự kiện
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Map 1 -->
      <div class="flex flex-col gap-3">
        <h3 class="text-lg font-bold text-navy-900 flex items-center gap-2">
          <i data-lucide="map-pin" class="w-5 h-5 text-gold-500"></i>
          1. Nhà hàng Con Sò - Galadinner (Tối 15/8)
        </h3>
        <div
          class="w-full h-[350px] rounded-xl overflow-hidden shadow-lg border border-gray-200 bg-white"
        >
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3732.274448016981!2d106.77394007476073!3d20.69907709902139!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x314a6d01b7b1e865%3A0x13d51e095a1762d3!2zTmjDoCBow6BuZyBDb24gU8Oy!5e0!3m2!1svi!2ssg!4v1785122372197!5m2!1svi!2ssg"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
      </div>
      <!-- Map 2 -->
      <div id="san-pickleball" class="flex flex-col gap-3 scroll-mt-24">
        <h3 class="text-lg font-bold text-navy-900 flex items-center gap-2">
          <i data-lucide="map-pin" class="w-5 h-5 text-gold-500"></i>
          2. Sân Pickleball
        </h3>
        <div
          class="w-full h-[350px] rounded-xl overflow-hidden shadow-lg border border-gray-200 bg-white"
        >
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m17!1m12!1m3!1d3732.2652474727593!2d106.77307737476059!3d20.699450899008625!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zMjDCsDQxJzU4LjAiTiAxMDbCsDQ2JzMyLjQiRQ!5e0!3m2!1svi!2ssg!4v1785122422099!5m2!1svi!2ssg"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
      </div>
      <!-- Map 3 -->
      <div class="flex flex-col gap-3">
        <h3 class="text-lg font-bold text-navy-900 flex items-center gap-2">
          <i data-lucide="map-pin" class="w-5 h-5 text-gold-500"></i>
          3. Mila Garden - Nơi nghỉ (Đêm 15/8)
        </h3>
        <div
          class="w-full h-[350px] rounded-xl overflow-hidden shadow-lg border border-gray-200 bg-white"
        >
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3732.297923699199!2d106.76762047476072!3d20.69812329905363!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x314a6d0060e4e653%3A0xfd4d331531a4f321!2sMILA%20GARDEN!5e0!3m2!1svi!2ssg!4v1785122455876!5m2!1svi!2ssg"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
      </div>
      <!-- Map 4 -->
      <div class="flex flex-col gap-3">
        <h3 class="text-lg font-bold text-navy-900 flex items-center gap-2">
          <i data-lucide="map-pin" class="w-5 h-5 text-gold-500"></i>
          4. Dragon Nest Hotel
        </h3>
        <div
          class="w-full h-[350px] rounded-xl overflow-hidden shadow-lg border border-gray-200 bg-white"
        >
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3732.3163801066!2d106.77081427476062!3d20.697373399079044!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x314a6d002dd6b5c7%3A0x66f117c7094cf0db!2sDragon%20Nest%20Hotel!5e0!3m2!1svi!2ssg!4v1785122484996!5m2!1svi!2ssg"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
      </div>
      <!-- Map 5 -->
      <div
        id="team-building"
        class="mx-auto flex w-full max-w-3xl flex-col gap-3 scroll-mt-24 lg:col-span-2"
      >
        <h3 class="flex items-center gap-2 text-lg font-bold text-navy-900">
          <i data-lucide="map-pin" class="h-5 w-5 text-gold-500"></i>
          5. Bãi tắm Vụng Hương - Team Building
        </h3>
        <div
          class="h-[350px] w-full overflow-hidden rounded-xl border border-gray-200 bg-white shadow-lg"
        >
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3732.2814725927706!2d106.78148110000001!3d20.6987917!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x314a6d00076ce841%3A0x29a59d08abebbb25!2zQsOjaSB04bqvbSBW4bulbmcgSMawxqFuZw!5e0!3m2!1sen!2s!4v1785830353227!5m2!1sen!2s"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
