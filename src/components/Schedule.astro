---
---
<section id="chuong-trinh" class="py-16 bg-white/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-serif font-bold text-navy-900 uppercase">HÀNH TRÌNH 2 NGÀY 1 ĐÊM</h2>
            <div class="mt-4 flex items-center justify-center gap-2">
                <div class="h-[1px] w-12 bg-gold-400"></div>
                <div class="w-2 h-2 rotate-45 bg-gold-400"></div>
                <div class="h-[1px] w-12 bg-gold-400"></div>
            </div>
        </div>

        <div class="grid md:grid-cols-2 gap-12 lg:gap-24 relative">
            <!-- Vertical Divider (Desktop) -->
            <div class="hidden md:block absolute left-1/2 top-10 bottom-10 w-px bg-gray-200 -translate-x-1/2"></div>

            <!-- Day 1 -->
            <div>
                <div class="inline-block bg-navy-900 text-gold-400 font-bold px-6 py-2 rounded-full text-sm tracking-wide mb-8 mx-auto md:ml-0 md:mr-auto shadow-md">
                    NGÀY 1 - 15.08 (THỨ BẢY)
                </div>
                
                <div class="space-y-8 relative">
                    <!-- Timeline Item -->
                    <div class="flex gap-4">
                        <div class="w-10 h-10 rounded-full bg-orange-50 border border-orange-100 flex items-center justify-center shrink-0 z-10 text-gold-600">
                            <i data-lucide="utensils" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <div class="text-navy-900 font-semibold mb-1">11:00 - 13:00</div>
                            <div class="text-gray-600">Đón đoàn & Ăn trưa</div>
                        </div>
                    </div>
                    
                    <!-- Timeline Item -->
                    <div class="flex gap-4">
                        <div class="w-10 h-10 rounded-full bg-orange-50 border border-orange-100 flex items-center justify-center shrink-0 z-10 text-gold-600">
                            <i data-lucide="trophy" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <div class="text-navy-900 font-semibold mb-1">14:30 - 16:30</div>
                            <div class="text-gray-600">Giải Pickleball giao lưu</div>
                        </div>
                    </div>
                    
                    <!-- Timeline Item -->
                    <div class="flex gap-4">
                        <div class="w-10 h-10 rounded-full bg-orange-50 border border-orange-100 flex items-center justify-center shrink-0 z-10 text-gold-600">
                            <i data-lucide="users-round" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <div class="text-navy-900 font-semibold mb-1">16:30 - 17:30</div>
                            <div class="text-gray-600">Teambuilding</div>
                        </div>
                    </div>
                    
                    <!-- Timeline Item -->
                    <div class="flex gap-4">
                        <div class="w-10 h-10 rounded-full bg-orange-50 border border-orange-100 flex items-center justify-center shrink-0 z-10 text-gold-600">
                            <i data-lucide="shirt" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <div class="text-navy-900 font-semibold mb-1">17:45 - 18:45</div>
                            <div class="text-gray-600">Thay đồ</div>
                        </div>
                    </div>
                    
                    <!-- Timeline Item -->
                    <div class="flex gap-4">
                        <div class="w-10 h-10 rounded-full bg-orange-50 border border-orange-100 flex items-center justify-center shrink-0 z-10 text-gold-600">
                            <i data-lucide="glass-water" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <div class="text-navy-900 font-semibold mb-1">19:00 - 23:00</div>
                            <div class="text-gray-900 font-bold">Gala Dinner</div>
                            <div class="text-gray-600 text-sm mt-1">30 năm hội ngộ</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Day 2 -->
            <div class="mt-8 md:mt-0">
                <div class="inline-block bg-navy-900 text-gold-400 font-bold px-6 py-2 rounded-full text-sm tracking-wide mb-8 mx-auto md:ml-auto md:mr-0 shadow-md flex">
                    NGÀY 2 - 16.08 (CHỦ NHẬT)
                </div>
                
                <div class="space-y-8 relative">
                    <!-- Timeline Item -->
                    <div class="flex gap-4">
                        <div class="w-10 h-10 rounded-full bg-orange-50 border border-orange-100 flex items-center justify-center shrink-0 z-10 text-gold-600">
                            <i data-lucide="coffee" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <div class="text-navy-900 font-semibold mb-1">07:00 - 08:30</div>
                            <div class="text-gray-600">Ăn sáng</div>
                        </div>
                    </div>
                    
                    <!-- Timeline Item -->
                    <div class="flex gap-4">
                        <div class="w-10 h-10 rounded-full bg-orange-50 border border-orange-100 flex items-center justify-center shrink-0 z-10 text-gold-600">
                            <i data-lucide="camera" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <div class="text-navy-900 font-semibold mb-1">09:00 - 10:00</div>
                            <div class="text-gray-600">Tham quan Bến tàu Không số</div>
                        </div>
                    </div>
                    
                    <!-- Timeline Item -->
                    <div class="flex gap-4">
                        <div class="w-10 h-10 rounded-full bg-orange-50 border border-orange-100 flex items-center justify-center shrink-0 z-10 text-gold-600">
                            <i data-lucide="hotel" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <div class="text-navy-900 font-semibold mb-1">10:00 - 12:00</div>
                            <div class="text-gray-600">Trả phòng & Ăn trưa</div>
                        </div>
                    </div>
                    
                    <!-- Timeline Item -->
                    <div class="flex gap-4">
                        <div class="w-10 h-10 rounded-full bg-orange-50 border border-orange-100 flex items-center justify-center shrink-0 z-10 text-gold-600">
                            <i data-lucide="home" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <div class="text-navy-900 font-semibold mb-1">13:00</div>
                            <div class="text-gray-600">Kết thúc chương trình</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Bottom Quote Box -->
        <div class="mt-16 bg-navy-900 rounded-2xl p-8 md:p-10 text-center relative overflow-hidden shadow-xl">
            <!-- Background subtle pattern -->
            <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(#D4AF37 1px, transparent 1px); background-size: 20px 20px;"></div>
            
            <i data-lucide="quote" class="inline-block text-gold-500/20 w-12 h-12 mb-4 rotate-180"></i>
            <h3 class="text-xl md:text-2xl font-serif text-white font-medium max-w-3xl mx-auto leading-relaxed relative z-10">
                Có những người bạn, dù thời gian có trôi đi bao lâu,<br class="hidden md:block">
                vẫn luôn là một phần thanh xuân đẹp nhất của chúng ta.
            </h3>
            <i data-lucide="heart" class="mx-auto mt-6 text-gold-500 w-6 h-6"></i>
        </div>
    </div>
</section>
