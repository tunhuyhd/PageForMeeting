<header class="fixed w-full z-50 transition-all duration-300 bg-navy-900/90 backdrop-blur-md border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
            <!-- Logo Area -->
            <div class="flex-shrink-0 flex items-center gap-3">
                <div class="w-12 h-12 rounded-full border-2 border-gold-500 flex items-center justify-center">
                    <span class="font-serif text-gold-500 font-bold text-xl">96Q</span>
                </div>
            </div>

            <!-- Desktop Navigation -->
            <nav class="hidden md:flex space-x-8">
                <a href="/PageForMeeting/" class="text-gold-400 font-medium text-sm tracking-wide border-b-2 border-gold-400 pb-1">TRANG CHỦ</a>
                <a href="/PageForMeeting/#chuong-trinh" class="text-gray-300 hover:text-gold-400 transition-colors text-sm tracking-wide font-medium">CHƯƠNG TRÌNH</a>
                <a href="/PageForMeeting/member" class="text-gray-300 hover:text-gold-400 transition-colors text-sm tracking-wide font-medium">THÀNH VIÊN</a>
                <a href="/PageForMeeting/#pickleball" class="text-gray-300 hover:text-gold-400 transition-colors text-sm tracking-wide font-medium">GIẢI PICKLEBALL</a>
                <a href="/PageForMeeting/#album" class="text-gray-300 hover:text-gold-400 transition-colors text-sm tracking-wide font-medium">ALBUM ẢNH</a>
                <a href="/PageForMeeting/#thong-bao" class="text-gray-300 hover:text-gold-400 transition-colors text-sm tracking-wide font-medium">THÔNG BÁO</a>
            </nav>

            <!-- CTA Button -->
            <div class="hidden md:block">
                <button class="bg-gold-500 hover:bg-gold-400 text-navy-900 font-semibold py-2 px-6 rounded flex items-center gap-2 transition-all shadow-[0_0_15px_rgba(212,175,55,0.4)]">
                    <i data-lucide="user-check" class="w-4 h-4"></i>
                    XÁC NHẬN THAM DỰ
                </button>
            </div>
        </div>
    </div>
</header>
