---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="py-12 -mt-16 relative z-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-4 md:grid-cols-5">
      <a
        id="home-accommodation-result"
        href={`${base}/danh-sach/o-ghep/index.html`}
        class="order-last hidden rounded-xl border border-gold-400 bg-gold-400 p-6 shadow-md transition-all hover:-translate-y-1 hover:bg-gold-500 flex-col items-center text-center group md:col-start-2"
      >
        <div
          class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-navy-900 text-gold-400"
        >
          <i data-lucide="hotel" class="h-6 w-6"></i>
        </div><h4 class="mb-1 text-sm font-extrabold uppercase text-navy-900">
          PHÒNG LƯU TRÚ
        </h4><p class="text-xs font-medium text-navy-900/70">
          Tra cứu khách sạn và phòng ngủ
        </p>
      </a>
      <a
        id="home-dinner-result"
        href={`${base}/danh-sach/ban-an/index.html`}
        class="order-last hidden rounded-xl border border-gold-400 bg-gold-400 p-6 shadow-md transition-all hover:-translate-y-1 hover:bg-gold-500 flex-col items-center text-center group"
      >
        <div
          class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-navy-900 text-gold-400"
        >
          <i data-lucide="utensils" class="h-6 w-6"></i>
        </div><h4 class="mb-1 text-sm font-extrabold uppercase text-navy-900">
          BÀN ĂN
        </h4><p class="text-xs font-medium text-navy-900/70">
          Tra cứu vị trí bàn Dinner
        </p>
      </a>
      <!-- Card 2 -->
      <a
        href="#chuong-trinh"
        class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 hover:shadow-md hover:-translate-y-1 transition-all flex flex-col items-center text-center group cursor-pointer"
      >
        <div
          class="w-12 h-12 rounded-full bg-blue-50 text-navy-900 flex items-center justify-center mb-3 group-hover:bg-navy-900 group-hover:text-gold-400 transition-colors"
        >
          <i data-lucide="calendar-check" class="w-6 h-6"></i>
        </div>
        <h4 class="font-bold text-gray-800 text-sm mb-1 uppercase">
          CHƯƠNG TRÌNH
        </h4>
        <p class="text-xs text-gray-500">Chi tiết sự kiện</p>
      </a>
      <!-- Team Building -->
      <button
        type="button"
        data-open-team-building
        class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 hover:shadow-md hover:-translate-y-1 transition-all flex flex-col items-center text-center group cursor-pointer"
      >
        <div
          class="w-12 h-12 rounded-full bg-blue-50 text-navy-900 flex items-center justify-center mb-3 group-hover:bg-navy-900 group-hover:text-gold-400 transition-colors"
        >
          <i data-lucide="users-round" class="w-6 h-6"></i>
        </div>
        <h4 class="font-bold text-gray-800 text-sm mb-1 uppercase">
          TEAM BUILDING
        </h4>
        <p class="text-xs text-gray-500">Kết nối & tạo ký ức mới</p>
      </button>
      <!-- Card 3 -->
      <div
        onclick="document.getElementById('pickleball-modal').classList.remove('hidden'); document.getElementById('pickleball-modal').classList.add('flex')"
        class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 hover:shadow-md hover:-translate-y-1 transition-all flex flex-col items-center text-center group cursor-pointer"
      >
        <div
          class="w-12 h-12 rounded-full bg-blue-50 text-navy-900 flex items-center justify-center mb-3 group-hover:bg-navy-900 group-hover:text-gold-400 transition-colors"
        >
          <i data-lucide="medal" class="w-6 h-6"></i>
        </div>
        <h4 class="font-bold text-gray-800 text-sm mb-1 uppercase">
          GIẢI PICKLEBALL
        </h4>
        <p class="text-xs text-gray-500">Thông tin & đăng ký</p>
      </div>
      <!-- Card 4 -->
      <a
        href="#"
        data-open-album-modal
        class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 hover:shadow-md hover:-translate-y-1 transition-all flex flex-col items-center text-center group cursor-pointer"
      >
        <div
          class="w-12 h-12 rounded-full bg-blue-50 text-navy-900 flex items-center justify-center mb-3 group-hover:bg-navy-900 group-hover:text-gold-400 transition-colors"
        >
          <i data-lucide="image" class="w-6 h-6"></i>
        </div>
        <h4 class="font-bold text-gray-800 text-sm mb-1 uppercase">
          ALBUM ẢNH
        </h4>
        <p class="text-xs text-gray-500">Khoảnh khắc kỷ niệm</p>
      </a>
      <!-- Card 5 -->
      <a
        href="#ban-do"
        class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 hover:shadow-md hover:-translate-y-1 transition-all flex flex-col items-center text-center group cursor-pointer"
      >
        <div
          class="w-12 h-12 rounded-full bg-blue-50 text-navy-900 flex items-center justify-center mb-3 group-hover:bg-navy-900 group-hover:text-gold-400 transition-colors"
        >
          <i data-lucide="map" class="w-6 h-6"></i>
        </div>
        <h4 class="font-bold text-gray-800 text-sm mb-1 uppercase">BẢN ĐỒ</h4>
        <p class="text-xs text-gray-500">Địa điểm sự kiện</p>
      </a>
    </div>
  </div>
</section>

<!-- Team Building menu -->
<div
  id="team-building-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-navy-950/75 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="team-building-menu-title"
>
  <div class="relative w-full max-w-md overflow-hidden rounded-2xl bg-white shadow-2xl">
    <header class="bg-navy-900 px-7 py-7 text-center text-white">
      <button id="close-team-building" type="button" aria-label="Đóng" class="absolute right-4 top-4 rounded-full bg-white/10 p-2 text-white/80 hover:bg-white/20 hover:text-white">
        <i data-lucide="x" class="h-5 w-5"></i>
      </button>
      <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-gold-400 text-navy-900">
        <i data-lucide="users-round" class="h-7 w-7"></i>
      </span>
      <h2 id="team-building-menu-title" class="mt-4 font-serif text-2xl font-bold text-gold-400">TEAM BUILDING</h2>
      <p class="mt-1 text-sm text-white/75">Kết nối để tạo nên những ký ức mới</p>
    </header>
    <div class="flex flex-col gap-3 p-6">
      <button id="open-team-building-content" type="button" class="flex items-center justify-center gap-3 rounded-xl bg-navy-900 p-4 font-bold text-white transition hover:bg-gold-500 hover:text-navy-900">
        <i data-lucide="file-text" class="h-5 w-5"></i>Nội dung
      </button>
      <a href="#team-building" id="go-team-building-map" class="flex items-center justify-center gap-3 rounded-xl bg-gray-100 p-4 font-bold text-navy-900 transition hover:bg-gray-200">
        <i data-lucide="map-pin" class="h-5 w-5"></i>Địa điểm
      </a>
    </div>
  </div>
</div>

<!-- Team Building content -->
<div
  id="team-building-content-modal"
  class="fixed inset-0 z-[120] hidden items-center justify-center bg-navy-950/80 p-3 backdrop-blur-sm sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="team-building-content-title"
>
  <article class="flex max-h-[94dvh] w-full max-w-3xl flex-col overflow-hidden rounded-2xl bg-ivory shadow-2xl">
    <header class="relative shrink-0 bg-navy-900 px-12 py-6 text-center text-white">
      <div class="absolute inset-x-0 top-0 h-1 bg-gold-400"></div>
      <button id="close-team-building-content" type="button" aria-label="Đóng" class="absolute right-4 top-4 rounded-full bg-white/10 p-2 text-white/80 hover:bg-white/20 hover:text-white">
        <i data-lucide="x" class="h-5 w-5"></i>
      </button>
      <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-gold-400 text-navy-900">
        <i data-lucide="users-round" class="h-6 w-6"></i>
      </span>
      <h2 id="team-building-content-title" class="mt-3 font-serif text-2xl font-bold text-gold-400 sm:text-3xl">TEAM BUILDING</h2>
      <p class="mt-1 text-sm font-medium text-white/80">Kết nối để tạo nên những ký ức mới</p>
    </header>
    <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-5 py-6 sm:px-10 sm:py-8">
      <div class="space-y-4 text-sm leading-7 text-gray-700 sm:text-base">
        <p>Ba mươi năm trước, chúng ta cùng học tập, cùng vượt qua những đồ án, những đêm thức trắng và những kỷ niệm tuổi trẻ.</p>
        <p>Ba mươi năm sau, hãy cùng nhau tạo thêm những ký ức mới bằng những trò chơi tập thể vui vẻ, gắn kết và đầy tiếng cười.</p>
        <p>Không quan trọng bạn thắng hay thua. Điều quan trọng là chính bạn tạo nên bầu không khí, tiếng cười và những khoảnh khắc đáng nhớ cho ngày Hội ngộ 30 năm của lớp 96Q.</p>
        <p>Mỗi sự tham gia của bạn sẽ làm cho chương trình trở nên ý nghĩa hơn.</p>
        <p>Hãy cùng hòa mình vào Team Building và tạo nên một ngày hội mà nhiều năm sau chúng ta vẫn còn muốn nhắc lại.</p>
      </div>
      <div class="mt-6 rounded-xl border border-gold-300 bg-gold-50 p-4 text-sm font-semibold leading-6 text-navy-900">
        Hãy đến đúng giờ để không bỏ lỡ những trò chơi thú vị và các phần quà của chương trình.
      </div>
      <blockquote class="mt-5 rounded-xl bg-navy-900 px-5 py-5 text-center font-serif text-lg font-semibold italic leading-7 text-gold-400">
        “Không chỉ trở về để gặp lại nhau, mà còn cùng nhau tạo nên những ký ức mới.”
      </blockquote>
      <p class="mt-4 text-center text-sm italic text-gray-500">Tiếp nối tinh thần: “Kết nối – Ký ức – Tiếp nối hành trình.”</p>
      <button id="accept-team-building-content" type="button" class="mx-auto mt-6 flex items-center gap-2 rounded-xl bg-gold-400 px-8 py-3 text-sm font-bold text-navy-900 transition hover:bg-gold-500">
        <i data-lucide="check" class="h-4 w-4"></i>Đóng
      </button>
    </div>
  </article>
</div>

<!-- Pickleball Modal -->
<div
  id="pickleball-modal"
  class="fixed inset-0 z-[100] bg-black/50 hidden items-center justify-center backdrop-blur-sm"
>
  <div
    class="bg-white rounded-2xl p-8 max-w-md w-full mx-4 shadow-2xl relative"
  >
    <button
      onclick="document.getElementById('pickleball-modal').classList.add('hidden'); document.getElementById('pickleball-modal').classList.remove('flex')"
      class="absolute top-4 right-4 text-gray-400 hover:text-gray-600"
    >
      <i data-lucide="x" class="w-6 h-6"></i>
    </button>
    <h3 class="text-2xl font-bold text-navy-900 mb-6 text-center">
      GIẢI PICKLEBALL
    </h3>
    <div class="flex flex-col gap-4">
      <button
        id="open-pickleball-rules"
        type="button"
        class="flex items-center justify-center gap-3 bg-navy-900 text-white p-4 rounded-xl hover:bg-gold-500 transition-colors font-medium"
      >
        <i data-lucide="file-text" class="w-5 h-5"></i>
        Điều lệ giải
      </button>
      <a
        href="#san-pickleball"
        onclick="document.getElementById('pickleball-modal').classList.add('hidden'); document.getElementById('pickleball-modal').classList.remove('flex')"
        class="flex items-center justify-center gap-3 bg-gray-100 text-navy-900 p-4 rounded-xl hover:bg-gray-200 transition-colors font-medium"
      >
        <i data-lucide="map-pin" class="w-5 h-5"></i>
        Địa điểm thi đấu
      </a>
      <a
        id="public-pickleball-result"
        href={`${base}/danh-sach/pickleball/index.html`}
        style="display: none"
        class="items-center justify-center gap-3 rounded-xl bg-gold-400 p-4 font-bold text-navy-900 transition-colors hover:bg-gold-500"
      >
        <i data-lucide="trophy" class="h-5 w-5"></i>
        Danh sách tham gia & xếp hạng
      </a>
    </div>
  </div>
</div>

<div
  id="pickleball-rules-modal"
  class="fixed inset-0 z-[120] hidden items-center justify-center bg-navy-950/80 p-3 backdrop-blur-sm sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="pickleball-rules-title"
>
  <article
    class="flex max-h-[94dvh] w-full max-w-4xl flex-col overflow-hidden rounded-2xl bg-ivory shadow-2xl"
  >
    <header
      class="relative shrink-0 overflow-hidden bg-navy-900 px-12 py-5 text-center text-white sm:px-14 sm:py-7"
    >
      <div class="absolute inset-x-0 top-0 h-1 bg-gold-400"></div>
      <button
        id="close-pickleball-rules"
        type="button"
        aria-label="Đóng điều lệ"
        class="absolute right-4 top-4 rounded-full bg-white/10 p-2 text-white/80 transition hover:bg-white/20 hover:text-white"
        ><i data-lucide="x" class="h-5 w-5"></i></button
      >
      <span
        class="mx-auto mb-2 flex h-10 w-10 items-center justify-center rounded-full bg-gold-400 text-navy-900 sm:mb-3 sm:h-12 sm:w-12"
        ><i data-lucide="trophy" class="h-5 w-5 sm:h-6 sm:w-6"></i></span
      >
      <h2
        id="pickleball-rules-title"
        class="mx-auto max-w-3xl font-serif text-lg font-bold leading-tight text-gold-400 sm:text-2xl lg:text-3xl"
      >
        ĐIỀU LỆ GIẢI PICKLEBALL<br class="sm:hidden" /> GIAO LƯU 96Q
      </h2>
      <p class="mt-2 text-xs leading-5 text-white/75 sm:text-sm">
        Kỷ niệm 30 năm Hội ngộ lớp 96Q <span class="whitespace-nowrap"
          >(1996–2026)</span
        >
      </p>
    </header>
    <div
      class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 py-5 sm:px-10 sm:py-8"
    >
      <div class="grid gap-4 md:grid-cols-2">
        <section class="rounded-xl border border-gold-200 bg-white p-4">
          <h3 class="mb-2 flex items-center gap-2 font-bold text-navy-900">
            <span
              class="flex h-7 w-7 items-center justify-center rounded-full bg-gold-400 text-xs"
              >1</span
            >Mục đích
          </h3><ul
            class="ml-5 list-disc space-y-1 text-sm leading-6 text-gray-700"
          >
            <li>
              Tăng cường giao lưu, kết nối giữa các thành viên lớp 96Q1 và 96Q2.
            </li><li>Thi đấu trên tinh thần đoàn kết, vui vẻ, fair-play.</li>
          </ul>
        </section>
        <section class="rounded-xl border border-gold-200 bg-white p-4">
          <h3 class="mb-2 flex items-center gap-2 font-bold text-navy-900">
            <span
              class="flex h-7 w-7 items-center justify-center rounded-full bg-gold-400 text-xs"
              >2</span
            >Thành phần tham gia
          </h3><ul
            class="ml-5 list-disc space-y-1 text-sm leading-6 text-gray-700"
          >
            <li>Các thành viên đăng ký trước thời hạn quy định.</li><li>
              Ban Tổ chức tổng hợp và công bố danh sách chính thức.
            </li>
          </ul>
        </section>
        <section class="rounded-xl border border-gold-200 bg-white p-4">
          <h3 class="mb-2 flex items-center gap-2 font-bold text-navy-900">
            <span
              class="flex h-7 w-7 items-center justify-center rounded-full bg-gold-400 text-xs"
              >3</span
            >Thành lập đội
          </h3><ul
            class="ml-5 list-disc space-y-1 text-sm leading-6 text-gray-700"
          >
            <li>Mỗi đội gồm 02 vận động viên.</li><li>
              Hai cặp vợ chồng được giữ nguyên theo danh sách Ban Tổ chức.
            </li><li>
              Các đội còn lại được bốc thăm ngẫu nhiên, ghép giữa thành viên
              96Q1 và 96Q2 nhằm tăng tính giao lưu.
            </li>
          </ul>
        </section>
        <section class="rounded-xl border border-gold-200 bg-white p-4">
          <h3 class="mb-2 flex items-center gap-2 font-bold text-navy-900">
            <span
              class="flex h-7 w-7 items-center justify-center rounded-full bg-gold-400 text-xs"
              >4</span
            >Thể thức thi đấu
          </h3><ul
            class="ml-5 list-disc space-y-1 text-sm leading-6 text-gray-700"
          >
            <li>
              Thi đấu đôi nam, đôi nam – nữ hoặc đôi nữ theo kết quả bốc thăm.
            </li><li>
              Thể thức vòng tròn hoặc loại trực tiếp sẽ được Ban Tổ chức quyết
              định căn cứ vào số lượng đội đăng ký.
            </li>
          </ul>
        </section>
        <section class="rounded-xl border border-gold-200 bg-white p-4">
          <h3 class="mb-2 flex items-center gap-2 font-bold text-navy-900">
            <span
              class="flex h-7 w-7 items-center justify-center rounded-full bg-gold-400 text-xs"
              >5</span
            >Luật thi đấu
          </h3><ul
            class="ml-5 list-disc space-y-1 text-sm leading-6 text-gray-700"
          >
            <li>Áp dụng Luật Pickleball hiện hành.</li><li>
              Trường hợp có tranh chấp, quyết định của Ban Tổ chức là quyết định
              cuối cùng.
            </li>
          </ul>
        </section>
        <section class="rounded-xl border border-gold-200 bg-white p-4">
          <h3 class="mb-2 flex items-center gap-2 font-bold text-navy-900">
            <span
              class="flex h-7 w-7 items-center justify-center rounded-full bg-gold-400 text-xs"
              >6</span
            >Tinh thần thi đấu
          </h3><ul
            class="ml-5 list-disc space-y-1 text-sm leading-6 text-gray-700"
          >
            <li>Tôn trọng đối thủ, trọng tài và đồng đội.</li><li>
              Thi đấu trung thực, văn minh.
            </li><li>Ưu tiên niềm vui hội ngộ hơn thành tích.</li>
          </ul>
        </section>
        <section
          class="rounded-xl border border-gold-300 bg-gold-50 p-4 md:col-span-2"
        >
          <h3 class="mb-2 flex items-center gap-2 font-bold text-navy-900">
            <span
              class="flex h-7 w-7 items-center justify-center rounded-full bg-gold-400 text-xs"
              >7</span
            >Giải thưởng
          </h3><div class="grid gap-2 text-sm text-gray-700 sm:grid-cols-2">
            <p>🏆 01 Giải Vô địch</p><p>🥈 01 Giải Nhì</p><p>
              🥉 02 Giải Ba (nếu áp dụng thể thức phù hợp)
            </p><p>🎖️ Có thể bổ sung các giải phụ do Ban Tổ chức quyết định.</p>
          </div>
        </section>
      </div>
      <blockquote
        class="mt-5 rounded-xl bg-navy-900 px-5 py-5 text-center font-serif text-lg font-semibold italic leading-7 text-gold-400"
      >
        “Không chỉ tranh tài – mà còn lưu giữ những khoảnh khắc đáng nhớ sau 30
        năm hội ngộ.”
      </blockquote>
      <button
        id="accept-pickleball-rules"
        type="button"
        class="mx-auto mt-5 flex items-center justify-center gap-2 rounded-xl bg-gold-400 px-8 py-3 text-sm font-bold text-navy-900 transition hover:bg-gold-500"
        ><i data-lucide="check" class="h-4 w-4"></i>Đóng</button
      >
    </div>
  </article>
</div>

<div
  id="album-notice-modal"
  class="fixed inset-0 z-[130] hidden items-center justify-center bg-navy-950/75 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="album-notice-title"
>
  <div
    class="relative w-full max-w-md overflow-hidden rounded-2xl bg-white text-center shadow-2xl"
  >
    <div class="bg-navy-900 px-6 py-7 text-white">
      <button
        id="close-album-notice"
        type="button"
        aria-label="Đóng thông báo"
        class="absolute right-4 top-4 rounded-full bg-white/10 p-2 text-white/80 transition hover:bg-white/20 hover:text-white"
        ><i data-lucide="x" class="h-5 w-5"></i></button
      ><span
        class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-gold-400 text-navy-900"
        ><i data-lucide="images" class="h-7 w-7"></i></span
      ><h2
        id="album-notice-title"
        class="mt-4 font-serif text-2xl font-bold text-gold-400"
      >
        ALBUM ẢNH
      </h2>
    </div>
    <div class="px-6 py-7">
      <p class="text-base font-semibold leading-7 text-navy-900">
        Album ảnh sẽ được biên soạn sau sự kiện
      </p><p class="mt-2 text-sm text-gray-500">
        Những khoảnh khắc đáng nhớ của hội ngộ 30 năm sẽ được cập nhật tại đây.
      </p><button
        id="accept-album-notice"
        type="button"
        class="mt-6 w-full rounded-xl bg-gold-400 px-5 py-3 text-sm font-bold text-navy-900 transition hover:bg-gold-500"
        >Đóng</button>
    </div>
  </div>
</div>

<script
  is:inline
  src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"
></script>
<script
  is:inline
  src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"
></script>
<script is:inline>
  const resultFirebaseConfig = {
    apiKey: "AIzaSyAfKEUC4xTaT-6Wo7fMdUUbmf2xAP2CaNM",
    authDomain: "register-to-participate.firebaseapp.com",
    projectId: "register-to-participate",
    storageBucket: "register-to-participate.firebasestorage.app",
    messagingSenderId: "578991866095",
    appId: "1:578991866095:web:9ce9b6b5e5d13314359b1a",
  };
  if (!firebase.apps.length) firebase.initializeApp(resultFirebaseConfig);
  firebase
    .firestore()
    .collection("public_settings")
    .doc("homepage")
    .onSnapshot((doc) => {
      const data = doc.data() || {},
        accommodation = document.getElementById("home-accommodation-result"),
        dinner = document.getElementById("home-dinner-result"),
        pickleballResult = document.getElementById("public-pickleball-result");
      accommodation.classList.toggle(
        "hidden",
        data.showAccommodationResult !== true,
      );
      accommodation.classList.toggle(
        "flex",
        data.showAccommodationResult === true,
      );
      dinner.classList.toggle("hidden", data.showDinnerResult !== true);
      dinner.classList.toggle("flex", data.showDinnerResult === true);
    });
  firebase
    .firestore()
    .collection("public_settings")
    .doc("pickleball")
    .onSnapshot((doc) => {
      const pickleballResult = document.getElementById("public-pickleball-result");
      pickleballResult.style.display =
        doc.data()?.showResult === true ? "flex" : "none";
    });
  const teamBuildingMenu = document.getElementById("team-building-modal"),
    teamBuildingContent = document.getElementById("team-building-content-modal");
  function showModal(modal) {
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.classList.add("overflow-hidden");
  }
  function hideModal(modal) {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    if (
      teamBuildingMenu.classList.contains("hidden") &&
      teamBuildingContent.classList.contains("hidden")
    )
      document.body.classList.remove("overflow-hidden");
  }
  document.querySelectorAll("[data-open-team-building]").forEach((trigger) => {
    trigger.onclick = (event) => {
      event.preventDefault();
      showModal(teamBuildingMenu);
    };
  });
  if (new URLSearchParams(window.location.search).get("team-building") === "1") {
    showModal(teamBuildingMenu);
    history.replaceState({}, "", `${window.location.pathname}${window.location.hash}`);
  }
  document.getElementById("close-team-building").onclick = () =>
    hideModal(teamBuildingMenu);
  document.getElementById("open-team-building-content").onclick = () => {
    hideModal(teamBuildingMenu);
    showModal(teamBuildingContent);
  };
  document.getElementById("go-team-building-map").onclick = () =>
    hideModal(teamBuildingMenu);
  document.getElementById("close-team-building-content").onclick = () =>
    hideModal(teamBuildingContent);
  document.getElementById("accept-team-building-content").onclick = () =>
    hideModal(teamBuildingContent);
  teamBuildingMenu.onclick = (event) => {
    if (event.target === teamBuildingMenu) hideModal(teamBuildingMenu);
  };
  teamBuildingContent.onclick = (event) => {
    if (event.target === teamBuildingContent) hideModal(teamBuildingContent);
  };
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (!teamBuildingContent.classList.contains("hidden"))
      hideModal(teamBuildingContent);
    else if (!teamBuildingMenu.classList.contains("hidden"))
      hideModal(teamBuildingMenu);
  });
  const pickleballMenu = document.getElementById("pickleball-modal"),
    rulesModal = document.getElementById("pickleball-rules-modal");
  function closePickleballRules() {
    rulesModal.classList.add("hidden");
    rulesModal.classList.remove("flex");
    document.body.classList.remove("overflow-hidden");
  }
  document.getElementById("open-pickleball-rules").onclick = () => {
    pickleballMenu.classList.add("hidden");
    pickleballMenu.classList.remove("flex");
    rulesModal.classList.remove("hidden");
    rulesModal.classList.add("flex");
    document.body.classList.add("overflow-hidden");
  };
  document.getElementById("close-pickleball-rules").onclick =
    closePickleballRules;
  document.getElementById("accept-pickleball-rules").onclick =
    closePickleballRules;
  rulesModal.onclick = (event) => {
    if (event.target === rulesModal) closePickleballRules();
  };
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !rulesModal.classList.contains("hidden"))
      closePickleballRules();
  });
  const albumModal = document.getElementById("album-notice-modal");
  function closeAlbumNotice() {
    albumModal.classList.add("hidden");
    albumModal.classList.remove("flex");
    document.body.classList.remove("overflow-hidden");
  }
  document.querySelectorAll("[data-open-album-modal]").forEach((trigger) => {
    trigger.onclick = (event) => {
      event.preventDefault();
      albumModal.classList.remove("hidden");
      albumModal.classList.add("flex");
      document.body.classList.add("overflow-hidden");
      document.getElementById("accept-album-notice").focus();
    };
  });
  document.getElementById("close-album-notice").onclick = closeAlbumNotice;
  document.getElementById("accept-album-notice").onclick = closeAlbumNotice;
  albumModal.onclick = (event) => {
    if (event.target === albumModal) closeAlbumNotice();
  };
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !albumModal.classList.contains("hidden"))
      closeAlbumNotice();
  });
</script>
