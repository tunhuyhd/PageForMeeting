---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section
  class="hero-bg min-h-screen flex items-center pt-20 relative overflow-hidden"
  style={`background-image: linear-gradient(rgba(11, 27, 61, 0.7), rgba(11, 27, 61, 0.8)), url('${base}/cover-img.jpg')`}
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-12 flex flex-col lg:flex-row items-center justify-between gap-12"
  >
    <!-- Left Column: Event Info -->
    <div class="relative z-20 flex-1 text-center lg:text-left">
      <div class="mb-8 flex justify-center lg:justify-start">
        <img
          src={`${base}/logo30.png`}
          alt="Logo 30 Năm Hội Ngộ 96Q"
          class="h-40 md:h-48 lg:h-56 w-auto object-contain drop-shadow-2xl"
        />
      </div>

      <div class="mb-6 flex justify-center lg:justify-start">
        <div class="inline-flex items-center gap-4">
          <div class="w-16 border-t border-gold-500"></div>
          <span class="text-gold-400 font-serif tracking-widest uppercase"
            >1996 - 2026</span
          >
          <div class="w-16 border-t border-gold-500"></div>
        </div>
      </div>

      <h1
        class="text-5xl md:text-6xl lg:text-7xl font-serif font-bold text-white mb-4 leading-tight"
      >
        30 NĂM HỘI NGỘ <span class="gold-gradient-text">96Q</span>
      </h1>

      <p class="text-xl md:text-2xl text-gray-300 font-serif italic mb-8">
        Kết nối - Ký ức - Tiếp nối - Hành trình
      </p>

      <div
        class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-6 text-gray-300 mb-5 font-medium"
      >
        <div class="flex items-center gap-2">
          <i data-lucide="map-pin" class="text-gold-400 w-5 h-5"></i>
          <span>Đồi Rồng - Đồ Sơn - Hải Phòng</span>
        </div>
        <div class="hidden sm:block w-1.5 h-1.5 rounded-full bg-gold-500"></div>
        <div class="flex items-center gap-2">
          <i data-lucide="calendar" class="text-gold-400 w-5 h-5"></i>
          <span>15 - 16.08.2026</span>
        </div>
      </div>

    </div>

    <!-- Right Column: Countdown -->
    <div class="relative z-20 flex w-full max-w-lg flex-1 flex-col lg:pl-10">
      <div class="text-center mb-6">
        <h3 class="text-gold-400 font-serif text-2xl tracking-wide">
          ĐẾM NGƯỢC ĐẾN NGÀY HỘI NGỘ
        </h3>
      </div>

      <div class="mb-5 grid grid-cols-4 gap-3">
        <div
          class="countdown-box rounded-lg p-4 flex flex-col items-center justify-center"
        >
          <span id="days" class="text-4xl font-serif text-white font-bold mb-1"
            >00</span
          >
          <span class="text-xs text-gold-400 uppercase tracking-widest"
            >Ngày</span
          >
        </div>
        <div
          class="countdown-box rounded-lg p-4 flex flex-col items-center justify-center"
        >
          <span id="hours" class="text-4xl font-serif text-white font-bold mb-1"
            >00</span
          >
          <span class="text-xs text-gold-400 uppercase tracking-widest"
            >Giờ</span
          >
        </div>
        <div
          class="countdown-box rounded-lg p-4 flex flex-col items-center justify-center"
        >
          <span
            id="minutes"
            class="text-4xl font-serif text-white font-bold mb-1">00</span
          >
          <span class="text-xs text-gold-400 uppercase tracking-widest"
            >Phút</span
          >
        </div>
        <div
          class="countdown-box rounded-lg p-4 flex flex-col items-center justify-center"
        >
          <span
            id="seconds"
            class="text-4xl font-serif text-white font-bold mb-1">00</span
          >
          <span class="text-xs text-gold-400 uppercase tracking-widest"
            >Giây</span
          >
        </div>
      </div>

      <div
        id="homepage-member-stats"
        class="relative z-30 order-4 mx-auto mt-6 grid w-full grid-cols-3 gap-1.5 rounded-2xl border-2 border-gold-400 bg-navy-900 p-1.5 shadow-[0_12px_35px_rgba(0,0,0,0.45)]"
        aria-label="Thống kê thành viên"
      >
        <div class="order-1 rounded-xl bg-white px-2 py-3 text-center sm:px-4">
          <span class="flex min-h-8 items-center justify-center text-[10px] font-extrabold uppercase leading-tight tracking-wide text-navy-900 sm:text-xs"
            >Tổng thành viên</span
          >
          <strong id="home-stat-total" class="mt-1 block text-2xl font-extrabold text-navy-900 sm:text-3xl"
            >--</strong
          >
        </div>
        <div class="order-3 rounded-xl bg-slate-200 px-2 py-3 text-center sm:px-4">
          <span class="flex min-h-8 items-center justify-center text-[10px] font-extrabold uppercase leading-tight tracking-wide text-slate-800 sm:text-xs"
            >Không tham gia</span
          >
          <strong id="home-stat-not-attending" class="mt-1 block text-2xl font-extrabold text-slate-700 sm:text-3xl"
            >--</strong
          >
        </div>
        <div class="order-2 rounded-xl bg-gold-400 px-2 py-3 text-center sm:px-4">
          <span class="flex min-h-8 items-center justify-center text-[10px] font-extrabold uppercase leading-tight tracking-wide text-navy-900 sm:text-xs"
            >Tham gia</span
          >
          <strong id="home-stat-attending" class="mt-1 block text-2xl font-extrabold text-navy-900 sm:text-3xl"
            >--</strong
          >
        </div>
      </div>

      <div class="relative order-3 text-center">
        <i
          data-lucide="quote"
          class="absolute -top-3 left-4 text-gold-500/20 w-8 h-8 rotate-180"
        ></i>
        <p class="text-gray-300 italic font-serif leading-relaxed px-8">
          Ba mươi năm - một chặng đường dài,<br />Nhưng tình bạn vẫn luôn vẹn
          nguyên. <span class="text-gold-500">♥</span>
        </p>
      </div>
    </div>
  </div>

  <!-- Bottom wave or gradient fade -->
  <div
    class="absolute bottom-0 left-0 w-full h-24 bg-gradient-to-t from-ivory to-transparent z-10"
  >
  </div>
</section>

<script>
  // Countdown Timer Logic
  // Đếm ngược đến 11:00 ngày 15/08/2026 (giờ Việt Nam) – lúc đón đoàn.
  const eventDate = new Date("2026-08-15T11:00:00+07:00").getTime();

  const updateCountdown = () => {
    const now = new Date().getTime();
    const distance = eventDate - now;

    const elDays = document.getElementById("days")!;
    const elHours = document.getElementById("hours")!;
    const elMinutes = document.getElementById("minutes")!;
    const elSeconds = document.getElementById("seconds")!;

    if (!elDays) return; // Prevent errors if elements don't exist

    if (distance < 0) {
      elDays.innerText = "00";
      elHours.innerText = "00";
      elMinutes.innerText = "00";
      elSeconds.innerText = "00";
      return;
    }

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor(
      (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
    );
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    elDays.innerText = days.toString().padStart(2, "0");
    elHours.innerText = hours.toString().padStart(2, "0");
    elMinutes.innerText = minutes.toString().padStart(2, "0");
    elSeconds.innerText = seconds.toString().padStart(2, "0");
  };

  // Update every second
  setInterval(updateCountdown, 1000);
  updateCountdown();

  const loadMemberStatistics = () => {
    const firebaseClient = (window as any).firebase;
    if (!firebaseClient?.apps?.length) return;

    firebaseClient
      .firestore()
      .collection("dinner_candidates")
      .onSnapshot(
        (snapshot: any) => {
          let total = 0;
          let attending = 0;
          snapshot.forEach((document: any) => {
            total += 1;
            if (document.data()?.isAttending !== false) attending += 1;
          });

          const totalElement = document.getElementById("home-stat-total");
          const attendingElement = document.getElementById("home-stat-attending");
          const notAttendingElement = document.getElementById("home-stat-not-attending");
          if (totalElement) totalElement.textContent = String(total);
          if (attendingElement) attendingElement.textContent = String(attending);
          if (notAttendingElement)
            notAttendingElement.textContent = String(total - attending);
        },
        () => {
          document.querySelectorAll("#homepage-member-stats strong").forEach((element) => {
            element.textContent = "--";
          });
        },
      );
  };

  window.addEventListener("load", loadMemberStatistics, { once: true });
</script>
